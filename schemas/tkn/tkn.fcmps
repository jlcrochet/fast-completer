# Tkn CLI schema for fast-completer
# Generated from tkn unknown

tkn # Tekton pipelines CLI
	--help @bool # help for tkn
	bundle # Manage Tekton Bundles
		--no-color @bool # disable coloring (default: false)
		list # List and print a Tekton bundle's contents
			--no-color @bool # disable coloring (default: false)
			--allow-missing-template-keys @bool # If true, ignore any errors in templates when a field or map key is missing in the template. Only applies to golang and jsonpath output formats.
			--cache-dir # A directory to cache Tekton bundles in.
			--no-cache @bool # If set to true, pulls a Tekton bundle from the remote even its exact digest is available in the cache.
			--output # Output format. One of: (json, yaml, name, go-template, go-template-file, template, templatefile, jsonpath, jsonpath-as-json, jsonpath-file).
			--remote-bearer # A Bearer token to authenticate against the repository
			--remote-password # A password to pass to the registry for basic auth. Must be used with --remote-username
			--remote-skip-tls @bool # If set to true, skips TLS check when connecting to the registry
			--remote-username # A username to pass to the registry for basic auth. Must be used with --remote-password
			--show-managed-fields @bool # If true, keep the managedFields when printing objects in JSON or YAML format.
			--template # Template string or path to template file to use when -o=go-template, -o=go-template-file. The template format is golang templates [http://golang.org/pkg/text/template/#pkg-overview].
		push # Create or replace a Tekton bundle
			--no-color @bool # disable coloring (default: false)
			--annotate # OCI Manifest annotation in the form of key=value to be added to the OCI image. Can be provided multiple times to add multiple annotations.
			--ctime # YYYY-MM-DD, YYYY-MM-DDTHH:MM:SS or RFC3339 formatted created time to set, defaults to current time. In non RFC3339 syntax dates are in UTC timezone.
			--filenames # List of fully-qualified file paths containing YAML or JSON defined Tekton objects to include in this bundle
			--label # OCI Config labels in the form of key=value to be added to the OCI image. Can be provided multiple times to add multiple labels.
			--remote-bearer # A Bearer token to authenticate against the repository
			--remote-password # A password to pass to the registry for basic auth. Must be used with --remote-username
			--remote-skip-tls @bool # If set to true, skips TLS check when connecting to the registry
			--remote-username # A username to pass to the registry for basic auth. Must be used with --remote-password
	clustertriggerbinding # Manage ClusterTriggerBindings
		--context # name of the kubeconfig context to use (default: kubectl config current-context)
		--kubeconfig # kubectl config file (default: $HOME/.kube/config)
		--no-color @bool # disable coloring (default: false)
		delete # Delete ClusterTriggerBindings
			--context # name of the kubeconfig context to use (default: kubectl config current-context)
			--kubeconfig # kubectl config file (default: $HOME/.kube/config)
			--no-color @bool # disable coloring (default: false)
			--all @bool # Delete all ClusterTriggerBindings (default: false)
			--allow-missing-template-keys @bool # If true, ignore any errors in templates when a field or map key is missing in the template. Only applies to golang and jsonpath output formats.
			--force @bool # Whether to force deletion (default: false)
			--output # Output format. One of: (json, yaml, name, go-template, go-template-file, template, templatefile, jsonpath, jsonpath-as-json, jsonpath-file).
			--show-managed-fields @bool # If true, keep the managedFields when printing objects in JSON or YAML format.
			--template # Template string or path to template file to use when -o=go-template, -o=go-template-file. The template format is golang templates [http://golang.org/pkg/text/template/#pkg-overview].
		describe # Describes a ClusterTriggerBinding
			--context # name of the kubeconfig context to use (default: kubectl config current-context)
			--kubeconfig # kubectl config file (default: $HOME/.kube/config)
			--no-color @bool # disable coloring (default: false)
			--allow-missing-template-keys @bool # If true, ignore any errors in templates when a field or map key is missing in the template. Only applies to golang and jsonpath output formats.
			--output # Output format. One of: (json, yaml, name, go-template, go-template-file, template, templatefile, jsonpath, jsonpath-as-json, jsonpath-file).
			--show-managed-fields @bool # If true, keep the managedFields when printing objects in JSON or YAML format.
			--template # Template string or path to template file to use when -o=go-template, -o=go-template-file. The template format is golang templates [http://golang.org/pkg/text/template/#pkg-overview].
		list # Lists ClusterTriggerBindings in a namespace
			--context # name of the kubeconfig context to use (default: kubectl config current-context)
			--kubeconfig # kubectl config file (default: $HOME/.kube/config)
			--no-color @bool # disable coloring (default: false)
			--allow-missing-template-keys @bool # If true, ignore any errors in templates when a field or map key is missing in the template. Only applies to golang and jsonpath output formats.
			--no-headers @bool # do not print column headers with output (default print column headers with output)
			--output # Output format. One of: (json, yaml, name, go-template, go-template-file, template, templatefile, jsonpath, jsonpath-as-json, jsonpath-file).
			--show-managed-fields @bool # If true, keep the managedFields when printing objects in JSON or YAML format.
			--template # Template string or path to template file to use when -o=go-template, -o=go-template-file. The template format is golang templates [http://golang.org/pkg/text/template/#pkg-overview].
