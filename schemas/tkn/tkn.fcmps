		list # Lists CustomRuns in a namespace
			--context # name of the kubeconfig context to use (default: kubectl config current-context)
			--kubeconfig # kubectl config file (default: $HOME/.kube/config)
			--namespace # namespace to use (default: from $KUBECONFIG)
			--no-color @bool # disable coloring (default: false)
			--all-namespaces @bool # list CustomRuns from all namespaces
			--allow-missing-template-keys @bool # If true, ignore any errors in templates when a field or map key is missing in the template. Only applies to golang and jsonpath output formats.
			--label # A selector (label query) to filter on, supports '=', '==', and '!='
			--limit # Limits the number of CustomRuns. If the limit value is 0 returns all
			--no-headers @bool # do not print column headers with output (default print column headers with output)
			--output # Output format. One of: (json, yaml, name, go-template, go-template-file, template, templatefile, jsonpath, jsonpath-as-json, jsonpath-file).
			--reverse @bool # list CustomRuns in reverse order
			--show-managed-fields @bool # If true, keep the managedFields when printing objects in JSON or YAML format.
