			--namespace # namespace to use (default: from $KUBECONFIG)
			--no-color @bool # disable coloring (default: false)
			--all @bool # show all logs including init steps injected by tekton
			--follow @bool # stream live logs
			--fzf @bool # use fzf to select a TaskRun
			--last @bool # show logs for last TaskRun
			--limit # lists number of TaskRuns
			--prefix @bool # prefix each log line with the log source (step name)
			--step # show logs for mentioned steps only
			--timestamps @bool # show logs with timestamp
