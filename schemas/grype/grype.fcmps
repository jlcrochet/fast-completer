	db # vulnerability database operations
		--config # grype configuration file(s) to use
		--profile # configuration profiles to use
		--quiet @bool # suppress all logging output
		--verbose # increase verbosity (-v = info, -vv = debug)
		check # Check to see if there is a database update available
			--config # grype configuration file(s) to use
			--profile # configuration profiles to use
			--quiet @bool # suppress all logging output
			--verbose # increase verbosity (-v = info, -vv = debug)
			--output # format to display results (available=[text, json])
		delete # Delete the vulnerability database
			--config # grype configuration file(s) to use
			--profile # configuration profiles to use
			--quiet @bool # suppress all logging output
			--verbose # increase verbosity (-v = info, -vv = debug)
		import # Import a vulnerability database or archive from a local file or URL
			--config # grype configuration file(s) to use
			--profile # configuration profiles to use
			--quiet @bool # suppress all logging output
			--verbose # increase verbosity (-v = info, -vv = debug)
		list # List all DBs available according to the listing URL
			--config # grype configuration file(s) to use
			--profile # configuration profiles to use
			--quiet @bool # suppress all logging output
			--verbose # increase verbosity (-v = info, -vv = debug)
			--output # format to display results (available=[text, raw, json])
		providers # List vulnerability providers that are in the database
			--config # grype configuration file(s) to use
			--profile # configuration profiles to use
			--quiet @bool # suppress all logging output
			--verbose # increase verbosity (-v = info, -vv = debug)
			--output # format to display results (available=[table, json])
		search # Search the DB for vulnerabilities or affected packages
			--config # grype configuration file(s) to use
			--profile # configuration profiles to use
			--quiet @bool # suppress all logging output
			--verbose # increase verbosity (-v = info, -vv = debug)
			--broad-cpe-matching @bool # allow for specific package CPE attributes to match with '*' values on the vulnerability
			--distro # refine to results with the given operating system (format: 'name', 'name[-:@]version', 'name[-:@]maj.min', 'name[-:@]codename')
			--ecosystem # ecosystem of the package to search within
			--fixed-state # only show vulnerabilities with the given fix state (fixed, not-fixed, unknown, wont-fix)
			--limit # limit the number of results returned, use 0 for no limit
			--modified-after # only show vulnerabilities originally published or modified since the given date (format: YYYY-MM-DD)
			--output # format to display results (available=[table, json])
			--pkg # package name/CPE/PURL to search for
			--provider # only show vulnerabilities from the given provider
			--published-after # only show vulnerabilities originally published after the given date (format: YYYY-MM-DD)
			--vuln # only show results for the given vulnerability ID
			vuln # Search for vulnerabilities within the DB (supports DB schema v6+ only)
				--config # grype configuration file(s) to use
				--profile # configuration profiles to use
				--quiet @bool # suppress all logging output
				--verbose # increase verbosity (-v = info, -vv = debug)
				--fixed-state # only show vulnerabilities with the given fix state (fixed, not-fixed, unknown, wont-fix)
				--limit # limit the number of results returned, use 0 for no limit
				--modified-after # only show vulnerabilities originally published or modified since the given date (format: YYYY-MM-DD)
				--output # format to display results (available=[table, json])
				--provider # only show vulnerabilities from the given provider
				--published-after # only show vulnerabilities originally published after the given date (format: YYYY-MM-DD)
		status # Display database status and metadata
			--config # grype configuration file(s) to use
			--profile # configuration profiles to use
			--quiet @bool # suppress all logging output
			--verbose # increase verbosity (-v = info, -vv = debug)
			--output # format to display results (available=[text, json])
		update # Download and install the latest vulnerability database
			--config # grype configuration file(s) to use
			--profile # configuration profiles to use
			--quiet @bool # suppress all logging output
			--verbose # increase verbosity (-v = info, -vv = debug)
