# Grype CLI schema for fast-completer
# Generated from grype 0.108.0

grype # Vulnerability scanner
	--add-cpes-if-none @bool # generate CPEs for packages with no CPE data
	--by-cve @bool # orient results by CVE instead of the original vulnerability ID when possible
	--config # grype configuration file(s) to use
	--distro # distro to match against in the format: <distro>[-:@]<version>
	--exclude # exclude paths from being scanned using a glob expression
	--fail-on # set the return code to 2 if a vulnerability is found with a severity >= the given severity, options=[negligible low medium high critical]
	--file # file to write the default report output to (default is STDOUT)
	--from # specify the source behavior to use (e.g. docker, registry, podman, oci-dir, ...)
	--help @bool # help for grype
	--ignore-states # ignore matches for vulnerabilities with specified comma separated fix states, options=[fixed not-fixed unknown wont-fix]
	--name # set the name of the target being analyzed
	--only-fixed @bool # ignore matches for vulnerabilities that are not fixed
	--only-notfixed @bool # ignore matches for vulnerabilities that are fixed
	--output # report output formatter, formats=[json table cyclonedx cyclonedx-json sarif template], deprecated formats=[embedded-cyclonedx-vex-json embedded-cyclonedx-vex-xml]
	--platform # an optional platform specifier for container image sources (e.g. 'linux/arm64', 'linux/arm64/v8', 'arm64', 'linux')
	--profile # configuration profiles to use
	--quiet @bool # suppress all logging output
	--scope # selection of layers to analyze, options=[squashed all-layers deep-squashed]
	--show-suppressed @bool # show suppressed/ignored vulnerabilities in the output (only supported with table output format)
	--sort-by # sort the match results with the given strategy, options=[package severity epss risk kev vulnerability]
	--template # specify the path to a Go template file (requires 'template' output to be selected)
	--verbose # increase verbosity (-v = info, -vv = debug)
	--version @bool # version for grype
	--vex # a list of VEX documents to consider when producing scanning results
