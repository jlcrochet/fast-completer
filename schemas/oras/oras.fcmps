				--key-file # client private key file for the remote registry
				--oci-layout @bool # set target as an OCI image layout
				--oci-layout-path # [Experimental] set the path for the OCI image layout target
				--output # file `path` to write the created index to, use - for stdout
				--password # registry password or identity token
				--password-stdin @bool # read password from stdin
				--plain-http @bool # allow insecure connections to registry without SSL check
				--pretty @bool # prettify JSON objects printed to stdout
				--registry-config # `path` of the authentication file for registry
				--resolve # customized DNS for registry, formatted in `host:port:address[:address_port]`
				--username # registry username
			update # [Experimental] Update and push an image index
				--add # manifests to add to the index
				--artifact-type # new artifact type for overall index
				--ca-file # server certificate authority file for the remote registry
				--cert-file # client certificate file for the remote registry
				--debug @bool # output debug logs (implies --no-tty)
				--header # add custom headers to requests
				--identity-token # registry identity token
				--identity-token-stdin @bool # read identity token from stdin
				--insecure @bool # allow connections to SSL registry without certs
				--key-file # client private key file for the remote registry
				--merge # indexes to be merged into the index
				--oci-layout @bool # set target as an OCI image layout
				--oci-layout-path # [Experimental] set the path for the OCI image layout target
				--output # file `path` to write the created index to, use - for stdout
				--password # registry password or identity token
				--password-stdin @bool # read password from stdin
				--plain-http @bool # allow insecure connections to registry without SSL check
				--pretty @bool # prettify JSON objects printed to stdout
				--registry-config # `path` of the authentication file for registry
				--remove # manifests to remove from the index, must be digests
				--resolve # customized DNS for registry, formatted in `host:port:address[:address_port]`
				--tag # extra tags for the updated index
				--username # registry username
		push # Push a manifest to a registry or an OCI image layout
			--ca-file # server certificate authority file for the remote registry
			--cert-file # client certificate file for the remote registry
			--concurrency # concurrency level
			--debug @bool # output debug logs (implies --no-tty)
			--descriptor @bool # output the descriptor
