# Act CLI schema for fast-completer
# Generated from act 0.2.84

act # Run GitHub Actions locally
	--action-cache-path # Defines the path where the actions get cached and host workspaces created. (default "/home/jeffrey/.cache/act")
	--action-offline-mode @bool # If action contents exists, it will not be fetch and pull again. If turn on this, will turn off force pull
	--actor|-a # user that triggered the event (default "nektos/act")
	--artifact-server-addr # Defines the address to which the artifact server binds. (default "172.29.136.148")
	--artifact-server-path # Defines the path where the artifact server stores uploads and retrieves downloads from. If not specified the artifact server will not start.
	--artifact-server-port # Defines the port where the artifact server listens. (default "34567")
	--bind|-b @bool # bind working directory to container, rather than copy
	--bug-report @bool # Display system information for bug report
	--cache-server-addr # Defines the address to which the cache server binds. (default "172.29.136.148")
	--cache-server-external-url # Defines the external URL for if the cache server is behind a proxy. e.g.: https://act-cache-server.example.com. Be careful that there is no trailing slash.
	--cache-server-path # Defines the path where the cache server stores caches. (default "/home/jeffrey/.cache/actcache")
	--cache-server-port # Defines the port where the artifact server listens. 0 means a randomly available port.
	--concurrent-jobs # Maximum number of concurrent jobs to run. Default is the number of CPUs available.
	--container-architecture # Architecture which should be used to run containers, e.g.: linux/amd64. If not specified, will use host default architecture. Requires Docker server API Version 1.41+. Ignored on earlier Docker server platforms.
	--container-cap-add # kernel capabilities to add to the workflow containers (e.g. --container-cap-add SYS_PTRACE)
	--container-cap-drop # kernel capabilities to remove from the workflow containers (e.g. --container-cap-drop SYS_PTRACE)
	--container-daemon-socket # URI to Docker Engine socket (e.g.: unix://~/.docker/run/docker.sock or - to disable bind mounting the socket)
	--container-options # Custom docker container options for the job container without an options property in the job definition
	--defaultbranch # the name of the main branch
	--detect-event @bool # Use first event type from workflow as event that triggered the workflow
	--directory|-C # working directory (default ".")
	--dryrun|-n @bool # disable container creation, validates only workflow correctness
	--env # env to make available to actions with optional value (e.g. --env myenv=foo or --env myenv)
	--env-file # environment file to read and use as env in the containers (default ".env")
	--eventpath|-e # path to event JSON file
	--github-instance # GitHub instance to use. Only use this when using GitHub Enterprise Server. (default "github.com")
	--graph|-g @bool # draw workflows
	--input # action input to make available to actions (e.g. --input myinput=foo)
	--input-file # input file to read and use as action input (default ".input")
	--insecure-secrets @bool # NOT RECOMMENDED! Doesn't hide secrets while printing logs.
	--job|-j # run a specific job ID
	--json @bool # Output logs in json format
	--list|-l @bool # list workflows
	--list-options @bool # Print a json structure of compatible options
	--local-repository # Replaces the specified repository and ref with a local folder (e.g. https://github.com/test/test@v0=/home/act/test or test/test@v0=/home/act/test, the latter matches any hosts or protocols)
	--log-prefix-job-id @bool # Output the job id within non-json logs instead of the entire name
	--man-page @bool # Print a generated manual page to stdout
	--matrix # specify which matrix configuration to include (e.g. --matrix java:13
	--network # Sets a docker network name. Defaults to host. (default "host")
	--no-cache-server @bool # Disable cache server
	--no-recurse @bool # Flag to disable running workflows from subdirectories of specified path in '--workflows'/'-W' flag
	--no-skip-checkout @bool # Use actions/checkout instead of copying local files into container
	--platform|-P # custom image to use per platform (e.g. -P ubuntu-18.04=nektos/act-environments-ubuntu:18.04)
	--privileged @bool # use privileged mode
	--pull|-p @bool # pull docker image(s) even if already present (default true)
	--quiet|-q @bool # disable logging of output from steps
	--rebuild @bool # rebuild local action docker image(s) even if already present (default true)
	--remote-name # git remote name that will be used to retrieve url of git repo (default "origin")
	--replace-ghe-action-token-with-github-com # If you are using replace-ghe-action-with-github-com  and you want to use private actions on GitHub, you have to set personal access token
	--replace-ghe-action-with-github-com # If you are using GitHub Enterprise Server and allow specified actions from GitHub (github.com), you can set actions on this. (e.g. --replace-ghe-action-with-github-com =github/super-linter)
	--reuse|-r @bool # don't remove container(s) on successfully completed workflow(s) to maintain state between runs
	--rm @bool # automatically remove container(s)/volume(s) after a workflow(s) failure
	--secret|-s # secret to make available to actions with optional value (e.g. -s mysecret=foo or -s mysecret)
	--secret-file # file with list of secrets to read from (e.g. --secret-file .secrets) (default ".secrets")
	--strict @bool # use strict workflow schema
	--use-gitignore @bool # Controls whether paths specified in .gitignore should be copied into container (default true)
	--use-new-action-cache @bool # Enable using the new Action Cache for storing Actions locally
	--userns # user namespace to use
	--validate @bool # validate workflows
	--var # variable to make available to actions with optional value (e.g. --var myvar=foo or --var myvar)
	--var-file # file with list of vars to read from (e.g. --var-file .vars) (default ".vars")
	--verbose|-v @bool # verbose output
	--watch|-w @bool # watch the contents of the local repo and run when files change
	--workflows|-W # path to workflow file(s) (default "./.github/workflows/")
