# Tailscale CLI schema for fast-completer
# Generated from tailscale 1.94.1

tailscale # Tailscale VPN CLI
	--socket # path to tailscaled socket (default /var/run/tailscale/tailscaled.sock)
	appc-routes # Print the current app connector routes
	bugreport # Print a shareable identifier to help diagnose issues
	cert # Get TLS certs
		--cert-file # output cert file or "-" for stdout; defaults to DOMAIN.crt if --cert-file and --key-file are both unset
		--key-file # output key file or "-" for stdout; defaults to DOMAIN.key if --cert-file and --key-file are both unset
		--min-validity # ensure the certificate is valid for at least this duration; the output certificate is never expired if this flag is unset or 0, but the lifetime may vary; the maximum allowed min-validity depends on the CA (default 0s)
	configure # Configure the host to enable more Tailscale features
		kubeconfig
		systray
			--enable-startup # Install startup script for init system. Currently supported systems are [systemd].
	dns # Diagnose the internal DNS forwarder
		query
		status
			device.
			used.
	down # Disconnect from Tailscale
		--accept-risk # accept risk and skip confirmation for risk types: lose-ssh,mac-app-connector,linux-strict-rp-filter,all
		--reason # reason for the disconnect, if required by a policy
	drive # Share a directory with your tailnet
		list
		rename
		share
		unshare
	exit-node # Show machines on your tailnet configured as exit nodes
		list
			--filter # filter exit nodes by country
		suggest
	file # Send or receive files
		cp
			--name # alternate filename to use, especially useful when <file> is "-" (stdin)
		get
			--conflict # behavior when a conflicting (same-named) file already exists in the target directory.
	funnel # Serve content and local servers on the internet
		--https # Expose an HTTPS server at the specified port (default mode)
		--proxy-protocol # PROXY protocol version (1 or 2) for TCP forwarding
		--set-path # Appends the specified path to the base URL for accessing the underlying service
		--tcp # Expose a TCP forwarder to forward raw TCP packets at the specified port
		--tls-terminated-tcp # Expose a TCP forwarder to forward TLS-terminated TCP packets at the specified port
		reset
		status
	ip # Show Tailscale IP addresses
	licenses # Get open source license information
	lock # Manage tailnet lock
		add
		disable
		disablement-kdf
		init
			--gen-disablements # number of disablement secrets to generate (default 1)
		local-disable
		log
			--limit # max number of updates to list (default 50)
		remove
		revoke-keys
			--fork-from # parent AUM hash to rewrite from (advanced users only)
		sign
		status
	login # Log in to a Tailscale account
		--advertise-routes # routes to advertise to other nodes (comma-separated, e.g. "10.0.0.0/8,192.168.0.0/24") or empty string to not advertise routes
		--advertise-tags # comma-separated ACL tags to request; each must start with "tag:" (e.g. "tag:eng,tag:montreal,tag:ssh")
		--audience # Audience used when requesting an ID token from an identity provider for auth keys via workload identity federation
		--auth-key # node authorization key; if it begins with "file:", then it's a path to a file containing the authkey
		--client-id # Client ID used to generate authkeys via workload identity federation
		--client-secret # Client Secret used to generate authkeys via OAuth; if it begins with "file:", then it's a path to a file containing the secret
		--exit-node # Tailscale exit node (IP, base name, or auto:any) for internet traffic, or empty string to not use an exit node
		--hostname # hostname to use instead of the one provided by the OS
		--id-token # ID token from the identity provider to exchange with the control server for workload identity federation; if it begins with "file:", then it's a path to a file containing the token
		--login-server # base URL of control server (default https://controlplane.tailscale.com)
		--netfilter-mode # netfilter mode (one of on, nodivert, off) (default on)
		--nickname # short name for the account
		--operator # Unix username to allow to operate on tailscaled without sudo
		--qr-format # QR code formatting (auto, ascii, large, small) (default auto)
		--timeout # maximum amount of time to wait for tailscaled to enter a Running state; default (0s) blocks forever (default 0s)
	logout # Disconnect from Tailscale and expire current node key
		--reason # reason for the logout, if required by a policy
	metrics # Show Tailscale metrics
		print
		write
	nc # Connect to a port on a host, connected to stdin/stdout
	netcheck # Print an analysis of local network conditions
		--every # if non-zero, do an incremental report with the given frequency (default 0s)
		--format # output format; empty (for human-readable), "json" or "json-line"
	ping # Ping a host at the Tailscale layer, see how it routed
		--c # max number of pings to send. 0 for infinity. (default 10)
		--size # size of the ping message (disco pings only). 0 for minimum size. (default 0)
		--timeout # timeout before giving up on a ping (default 5s)
	serve # Serve content and local servers on your tailnet
		--accept-app-caps # App capabilities to forward to the server (specify multiple capabilities with a comma-separated list)
		--http # Expose an HTTP server at the specified port
		--https # Expose an HTTPS server at the specified port (default mode)
		--proxy-protocol # PROXY protocol version (1 or 2) for TCP forwarding
		--service # Serve for a service with distinct virtual IP instead on node itself.
		--set-path # Appends the specified path to the base URL for accessing the underlying service
		--tcp # Expose a TCP forwarder to forward raw TCP packets at the specified port
		--tls-terminated-tcp # Expose a TCP forwarder to forward TLS-terminated TCP packets at the specified port
		advertise
		clear
		drain
		get-config
			--service # read config from a particular service
		reset
		set-config
			--service # apply config to a particular service
		status
	set # Change specified preferences
		--accept-risk # accept risk and skip confirmation for risk types: lose-ssh,mac-app-connector,linux-strict-rp-filter,all
		--advertise-routes # routes to advertise to other nodes (comma-separated, e.g. "10.0.0.0/8,192.168.0.0/24") or empty string to not advertise routes
		--exit-node # Tailscale exit node (IP, base name, or auto:any) for internet traffic, or empty string to not use an exit node
		--hostname # hostname to use instead of the one provided by the OS
		--netfilter-mode # netfilter mode (one of on, nodivert, off)
		--nickname # nickname for the current account
		--operator # Unix username to allow to operate on tailscaled without sudo
		--relay-server-port # UDP port number (0 will pick a random unused port) for the relay server to bind to, on all interfaces, or empty string to disable relay server functionality
		--relay-server-static-endpoints # static IP:port endpoints to advertise as candidates for relay connections (comma-separated, e.g. "[2001:db8::1]:40000,192.0.2.1:40000") or empty string to not advertise any static endpoints
	ssh # SSH to a Tailscale machine
	status # Show state of tailscaled and its connections
		--listen # listen address for web mode; use port 0 for automatic (default 127.0.0.1:8384)
	switch # Switch to a different Tailscale account
		remove
	syspolicy # Diagnose the MDM and system policy configuration
		list
		reload
	systray # Run a systray application to manage Tailscale
	up # Connect to Tailscale, logging in if needed
		--accept-risk # accept risk and skip confirmation for risk types: lose-ssh,mac-app-connector,linux-strict-rp-filter,all
		--advertise-routes # routes to advertise to other nodes (comma-separated, e.g. "10.0.0.0/8,192.168.0.0/24") or empty string to not advertise routes
		--advertise-tags # comma-separated ACL tags to request; each must start with "tag:" (e.g. "tag:eng,tag:montreal,tag:ssh")
		--audience # Audience used when requesting an ID token from an identity provider for auth keys via workload identity federation
		--auth-key # node authorization key; if it begins with "file:", then it's a path to a file containing the authkey
		--client-id # Client ID used to generate authkeys via workload identity federation
		--client-secret # Client Secret used to generate authkeys via OAuth; if it begins with "file:", then it's a path to a file containing the secret
		--exit-node # Tailscale exit node (IP, base name, or auto:any) for internet traffic, or empty string to not use an exit node
		--hostname # hostname to use instead of the one provided by the OS
		--id-token # ID token from the identity provider to exchange with the control server for workload identity federation; if it begins with "file:", then it's a path to a file containing the token
		--login-server # base URL of control server (default https://controlplane.tailscale.com)
		--netfilter-mode # netfilter mode (one of on, nodivert, off) (default on)
		--operator # Unix username to allow to operate on tailscaled without sudo
		--qr-format # QR code formatting (auto, ascii, large, small) (default auto)
		--timeout # maximum amount of time to wait for tailscaled to enter a Running state; default (0s) blocks forever (default 0s)
	update # Update Tailscale to the latest/different version
	version # Print Tailscale version
	web # Run a web server for controlling Tailscale
		--listen # listen address; use port 0 for automatic (default localhost:8088)
		--origin # origin at which the web UI is served (if behind a reverse proxy or used with cgi)
		--prefix # URL prefix added to requests (for cgi or reverse proxies)
	whois # Show the machine and user associated with a Tailscale IP (v4 or v6)
		--proto # protocol; one of "tcp" or "udp"; empty mans both
