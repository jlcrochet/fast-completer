		--inbox-prefix # Custom inbox prefix to use for inboxes
		--colors # Sets a color scheme to use ($NATS_COLOR)
		--context # Configuration context ($NATS_CONTEXT)
		--trace @bool # Trace API interactions
		--no-context @bool # Disable the selected context
