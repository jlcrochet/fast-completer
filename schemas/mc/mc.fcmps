	mirror # synchronize object(s) to a remote site
		--overwrite @bool # overwrite object(s) on target if it differs from source
		--dry-run @bool # perform a fake mirror operation
		--remove @bool # remove extraneous object(s) on target
		--region # specify region when creating new bucket(s) on target (default: "us-east-1")
		--active-active @bool # enable active-active multi-site setup
		--disable-multipart @bool # disable multipart upload feature
		--exclude # exclude object(s) that match specified object name pattern
		--exclude-bucket # exclude bucket(s) that match specified bucket name pattern
		--exclude-storageclass # exclude object(s) that match the specified storage class
		--older-than # filter object(s) older than value in duration string (e.g. 7d10h31s)
		--newer-than # filter object(s) newer than value in duration string (e.g. 7d10h31s)
		--attr # add custom metadata for all objects
		--monitoring-address # if specified, a new prometheus endpoint will be created to report mirroring activity. (eg: localhost:8081)
		--retry @bool # if specified, will enable retrying on a per object basis if errors occur
		--summary @bool # print a summary of the mirror session
		--skip-errors @bool # skip any errors when mirroring
		--max-workers # maximum number of concurrent copies (default: autodetect) (default: 0)
		--checksum # Add checksum to uploaded object. Values: CRC64NVME, CRC32, CRC32C, SHA1 or SHA256. Requires server trailing headers (AWS, MinIO)
		--enc-c # encrypt/decrypt objects using client provided keys. (multiple keys can be provided) Formats: RawBase64 or Hex.
		--enc-kms # encrypt/decrypt objects using specific server-side encryption keys. (multiple keys can be provided) [$MC_ENC_KMS]
		--enc-s3 # encrypt/decrypt objects using server-side default keys and configurations. (multiple keys can be provided). [$MC_ENC_S3]
		--no-color @bool # disable color theme [$MC_NO_COLOR]
		--json @bool # enable JSON lines formatted output [$MC_JSON]
		--debug @bool # enable debug output [$MC_DEBUG]
		--resolve # resolves HOST[:PORT] to an IP address. Example: minio.local:9000=10.10.75.1 [$MC_RESOLVE]
		--insecure @bool # disable SSL certificate verification [$MC_INSECURE]
		--limit-upload # limits uploads to a maximum rate in KiB/s, MiB/s, GiB/s. (default: unlimited) [$MC_LIMIT_UPLOAD]
		--limit-download # limits downloads to a maximum rate in KiB/s, MiB/s, GiB/s. (default: unlimited) [$MC_LIMIT_DOWNLOAD]
	mv # move objects
		--older-than # move objects older than value in duration string (e.g. 7d10h31s)
		--newer-than # move objects newer than value in duration string (e.g. 7d10h31s)
		--attr # add custom metadata for the object
		--disable-multipart @bool # disable multipart upload feature
		--tags # apply one or more tags to the uploaded objects
		--checksum # Add checksum to uploaded object. Values: CRC64NVME, CRC32, CRC32C, SHA1 or SHA256. Requires server trailing headers (AWS, MinIO)
		--enc-c # encrypt/decrypt objects using client provided keys. (multiple keys can be provided) Formats: RawBase64 or Hex.
		--enc-kms # encrypt/decrypt objects using specific server-side encryption keys. (multiple keys can be provided) [$MC_ENC_KMS]
		--enc-s3 # encrypt/decrypt objects using server-side default keys and configurations. (multiple keys can be provided). [$MC_ENC_S3]
