		-config # Request template file
		-section # Config section to use
		-utf8 @bool # Input characters are UTF8
		-nameopt # Certificate name printing options
		-text @bool # Print text form of request
		-x509 @bool # Output X.509 certificate instead of CSR
		-x509v1 @bool # Request cert generation with X.509 version 1
		-CA # Issuer certificate for signing
		-CAkey # Issuer private key for signing
		-subj # Set or modify subject of request or cert
		-subject @bool # Print the subject of the output
		-days # Number of days certificate is valid for
		-set_serial # Serial number to use
		-copy_extensions # Copy extensions from request
		-extensions # Cert or request extension section
		-reqexts # Alias for -extensions
		-addext # Additional cert extension key=value pair
		-precert @bool # Add poison extension to generated cert
		-key # Key for signing
		-keyform # Key file format
		-pubkey @bool # Output public key
		-keyout # File to write private key to
		-passin # Private key password source
		-passout # Output file pass phrase source
		-newkey # Generate new key with alg:nbits
		-pkeyopt # Public key options as opt:value
		-sigopt # Signature parameter in n:v form
		-batch @bool # Do not ask anything during generation
		-verbose @bool # Verbose output
		-quiet @bool # Terse output
		-noenc @bool # Don't encrypt private keys
		-nodes @bool # Don't encrypt private keys (deprecated)
		-noout @bool # Do not output REQ
		-newhdr @bool # Output NEW in the header lines
		-modulus @bool # RSA modulus
		-verify @bool # Verify self-signature on the request
		-rand # Load files into random number generator
		-writerand # Write random data to file
		-provider-path # Provider load path
		-provider # Provider to load
