			--lineNumbersTableStyle # foreground and background colors for table line numbers, e.g. --lineNumbersTableStyle "#fff000 bg:#000fff"
			--omitClassComments @bool # omit CSS class comment prefixes in the generated CSS
			--omitEmpty @bool # omit empty CSS rules (deprecated, no longer needed)
