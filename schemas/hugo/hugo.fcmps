# Hugo CLI schema for fast-completer
# Generated from hugo .

hugo # Static site generator
	--baseURL # hostname (and path) to the root, e.g. https://spf13.com/
	--buildDrafts @bool # include content marked as draft
	--buildExpired @bool # include expired content
	--buildFuture @bool # include content with publishdate in the future
	--cacheDir # filesystem path to cache directory
	--cleanDestinationDir @bool # remove files from destination not found in static directories
	--clock # set the clock used by Hugo, e.g. --clock 2021-11-06T22:30:00.00+09:00
	--config # config file (default is hugo.yaml|json|toml)
	--configDir # config dir
	--contentDir # filesystem path to content directory
	--destination # filesystem path to write files to
	--disableKinds # disable different kind of pages (home, RSS etc.)
	--enableGitInfo @bool # add Git revision, date, author, and CODEOWNERS info to the pages
	--environment # build environment
	--forceSyncStatic @bool # copy all files when static is changed.
	--gc @bool # enable to run some cleanup tasks (remove unused cache files) after the build
	--help @bool # help for hugo
	--ignoreCache @bool # ignores the cache directory
	--ignoreVendorPaths # ignores any _vendor for module paths matching the given Glob pattern
	--layoutDir # filesystem path to layout directory
	--logLevel # log level (debug|info|warn|error)
	--minify @bool # minify any supported output format (HTML, XML etc.)
	--noBuildLock @bool # don't create .hugo_build.lock file
	--noChmod @bool # don't sync permission mode of files
	--noTimes @bool # don't sync modification time of files
	--panicOnWarning @bool # panic on first WARNING log
	--poll # set this to a poll interval, e.g --poll 700ms, to use a poll based approach to watch for file system changes
	--printI18nWarnings @bool # print missing translations
	--printMemoryUsage @bool # print memory usage to screen at intervals
	--printPathWarnings @bool # print warnings on duplicate target paths etc.
	--printUnusedTemplates @bool # print warnings on unused templates.
	--quiet @bool # build in quiet mode
	--renderSegments # named segments to render (configured in the segments config)
	--renderToMemory @bool # render to memory (mostly useful when running the server)
	--source # filesystem path to read files relative from
	--templateMetrics @bool # display metrics about template executions
	--templateMetricsHints @bool # calculate some improvement hints when combined with --templateMetrics
	--theme # themes to use (located in /themes/THEMENAME/)
	--themesDir # filesystem path to themes directory
	--trace # write trace to `file` (not useful in general)
	--watch @bool # watch filesystem for changes and recreate as needed
	build # Build your site
		--baseURL # hostname (and path) to the root, e.g. https://spf13.com/
		--buildDrafts @bool # include content marked as draft
		--buildExpired @bool # include expired content
		--buildFuture @bool # include content with publishdate in the future
		--cacheDir # filesystem path to cache directory
		--cleanDestinationDir @bool # remove files from destination not found in static directories
		--clock # set the clock used by Hugo, e.g. --clock 2021-11-06T22:30:00.00+09:00
		--config # config file (default is hugo.yaml|json|toml)
		--configDir # config dir
		--contentDir # filesystem path to content directory
		--destination # filesystem path to write files to
		--disableKinds # disable different kind of pages (home, RSS etc.)
		--enableGitInfo @bool # add Git revision, date, author, and CODEOWNERS info to the pages
		--environment # build environment
		--forceSyncStatic @bool # copy all files when static is changed.
		--gc @bool # enable to run some cleanup tasks (remove unused cache files) after the build
		--ignoreCache @bool # ignores the cache directory
		--ignoreVendorPaths # ignores any _vendor for module paths matching the given Glob pattern
		--layoutDir # filesystem path to layout directory
		--logLevel # log level (debug|info|warn|error)
		--minify @bool # minify any supported output format (HTML, XML etc.)
		--noBuildLock @bool # don't create .hugo_build.lock file
		--noChmod @bool # don't sync permission mode of files
		--noTimes @bool # don't sync modification time of files
		--panicOnWarning @bool # panic on first WARNING log
		--poll # set this to a poll interval, e.g --poll 700ms, to use a poll based approach to watch for file system changes
		--printI18nWarnings @bool # print missing translations
		--printMemoryUsage @bool # print memory usage to screen at intervals
		--printPathWarnings @bool # print warnings on duplicate target paths etc.
		--printUnusedTemplates @bool # print warnings on unused templates.
		--quiet @bool # build in quiet mode
		--renderSegments # named segments to render (configured in the segments config)
		--renderToMemory @bool # render to memory (mostly useful when running the server)
		--source # filesystem path to read files relative from
		--templateMetrics @bool # display metrics about template executions
		--templateMetricsHints @bool # calculate some improvement hints when combined with --templateMetrics
		--theme # themes to use (located in /themes/THEMENAME/)
		--themesDir # filesystem path to themes directory
		--trace # write trace to `file` (not useful in general)
		--watch @bool # watch filesystem for changes and recreate as needed
