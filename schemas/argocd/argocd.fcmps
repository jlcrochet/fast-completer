# Argo CD CLI schema for fast-completer
# Generated from argocd unknown

argocd # Argo CD CLI
	--argocd-context # The name of the Argo-CD server context to use
	--auth-token # Authentication token; set this or the ARGOCD_AUTH_TOKEN environment variable
	--client-crt # Client certificate file
	--client-crt-key # Client certificate key file
	--config # Path to Argo CD config
	--controller-name # Name of the Argo CD Application controller; set this or the ARGOCD_APPLICATION_CONTROLLER_NAME environment variable when the controller's name label differs from the default, for example when installing via the Helm chart
	--core @bool # If set to true then CLI talks directly to Kubernetes instead of talking to Argo CD API server
	--grpc-web @bool # Enables gRPC-web protocol. Useful if Argo CD server is behind proxy which does not support HTTP2.
	--grpc-web-root-path # Enables gRPC-web protocol. Useful if Argo CD server is behind proxy which does not support HTTP2. Set web root.
	--header # Sets additional header to all requests made by Argo CD CLI. (Can be repeated multiple times to add multiple headers, also supports comma separated headers)
	--help @bool # help for argocd
	--http-retry-max # Maximum number of retries to establish http connection to Argo CD server
	--insecure @bool # Skip server certificate and domain verification
	--kube-context # Directs the command to the given kube-context
	--logformat # Set the logging format. One of: json|text
	--loglevel # Set the logging level. One of: debug|info|warn|error
	--plaintext @bool # Disable TLS
	--port-forward @bool # Connect to a random argocd-server port using port forwarding
	--port-forward-namespace # Namespace name which should be used for port forwarding
	--prompts-enabled @bool # Force optional interactive prompts to be enabled or disabled, overriding local configuration. If not specified, the local configuration value will be used, which is false by default.
	--redis-compress # Enable this if the application controller is configured with redis compression enabled. (possible values: gzip, none)
	--redis-haproxy-name # Name of the Redis HA Proxy; set this or the ARGOCD_REDIS_HAPROXY_NAME environment variable when the HA Proxy's name label differs from the default, for example when installing via the Helm chart
	--redis-name # Name of the Redis deployment; set this or the ARGOCD_REDIS_NAME environment variable when the Redis's name label differs from the default, for example when installing via the Helm chart
	--repo-server-name # Name of the Argo CD Repo server; set this or the ARGOCD_REPO_SERVER_NAME environment variable when the server's name label differs from the default, for example when installing via the Helm chart
	--server # Argo CD server address
	--server-crt # Server certificate file
	--server-name # Name of the Argo CD API server; set this or the ARGOCD_SERVER_NAME environment variable when the server's name label differs from the default, for example when installing via the Helm chart
