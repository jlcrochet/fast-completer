# Salesforce CLI schema for fast-completer
# Generated from sf 2.122.6

sf # Salesforce CLI
	agent:activate # Activating an agent makes it immediately available to your users.
		--api-name|-n # API name of the agent to activate.
		--api-version # Override the api version used for api requests made by this command
		--flags-dir # Import flag values from a directory.
		--json @bool # Format output as json.
		--target-org|-o # Username or alias of the target org. Not required if the `target-org` configuration variable is already set.
	agent:create # NOTE: This command creates an agent that doesn't use Agent Script as its blueprint.
		--api-name # API name of the new agent; if not specified, the API name is derived from the agent name (label); the API name must not exist in the org.
		--api-version # Override the api version used for api requests made by this command
		--flags-dir # Import flag values from a directory.
		--json @bool # Format output as json.
		--name # Name (label) of the new agent.
		--planner-id # An existing GenAiPlannerBundle ID to associate with the agent.
		--preview @bool # Preview the agent without saving it in your org.
		--spec # Path to an agent spec file.
		--target-org|-o # Username or alias of the target org. Not required if the `target-org` configuration variable is already set.
	agent:deactivate # Deactivating an agent makes it unavailable to your users.
		--api-name|-n # API name of the agent to deactivate.
		--api-version # Override the api version used for api requests made by this command
		--flags-dir # Import flag values from a directory.
		--json @bool # Format output as json.
		--target-org|-o # Username or alias of the target org. Not required if the `target-org` configuration variable is already set.
	agent:generate:agent-spec # An agent spec is a YAML-formatted file that contains basic information about the agent, such as its role, company description, and an AI-generated list of topics based on this information.
		--agent-user # Username of a user in your org to assign to your agent; determines what your agent can access and do.
		--api-version # Override the api version used for api requests made by this command
		--company-description # Description of your company.
		--company-name # Name of your company.
		--company-website # Website URL of your company.
		--enrich-logs (true|false) # Adds agent conversation data to event logs so you can view all agent session activity in one place.
		--flags-dir # Import flag values from a directory.
		--force-overwrite @bool # Don't prompt the user to confirm that an existing spec file will be overwritten.
		--full-interview @bool # Prompt for both required and optional flags.
		--grounding-context # Context information and personalization that's added to your prompts when using a custom prompt template.
		--json @bool # Format output as json.
		--max-topics # Maximum number of topics to generate in the agent spec; default is 5.
		--output-file # Path for the generated YAML agent spec file; can be an absolute or relative path.
		--prompt-template # API name of a customized prompt template to use instead of the default prompt template.
		--role # Role of the agent.
		--spec # Agent spec file, in YAML format, to use as input to the command.
		--target-org|-o # Username or alias of the target org. Not required if the `target-org` configuration variable is already set.
		--tone (formal|casual|neutral) # Conversational style of the agent, such as how it expresses your brand personality in its messages through word choice, punctuation, and sentence structure.
		--type (customer|internal) # Type of agent to create. Internal types are copilots used internally by your company and customer types are the agents you create for your customers.
	agent:generate:authoring-bundle # Authoring bundles are metadata components that contain an agent's Agent Script file.
		--api-name # API name of the new authoring bundle; if not specified, the API name is derived from the authoring bundle name (label); the API name can't exist in the org.
		--api-version # Override the api version used for api requests made by this command
		--flags-dir # Import flag values from a directory.
		--json @bool # Format output as json.
		--name|-n # Name (label) of the authoring bundle; if not specified, you're prompted for the name.
		--output-dir|-d # Directory where the authoring bundle files are generated.
		--spec|-f # Path to the agent spec YAML file; if not specified, the command provides a list that you can choose from.
		--target-org|-o # Username or alias of the target org. Not required if the `target-org` configuration variable is already set.
	agent:generate:template # At a high-level, agents are defined by the Bot, BotVersion, and GenAiPlannerBundle metadata types.
		--agent-file|-f # Path to an agent (Bot) metadata file.
		--agent-version # Version of the agent (BotVersion).
		--api-version # Override the api version used for api requests made by this command
		--flags-dir # Import flag values from a directory.
		--json @bool # Format output as json.
	agent:generate:test-spec # The first step when using Salesforce CLI to create an agent test in your org is to use this interactive command to generate a local YAML-formatted test spec file.
		--flags-dir # Import flag values from a directory.
		--force-overwrite @bool # Don't prompt for confirmation when overwriting an existing test spec YAML file.
		--from-definition|-d # Filepath to the AIEvaluationDefinition metadata XML file in your DX project that you want to convert to a test spec YAML file.
		--output-file|-f # Name of the generated test spec YAML file. Default value is "specs/<AGENT_API_NAME>-testSpec.yaml".
	agent:preview # Use this command to have a natural language conversation with an agent, either while you code its local Agent Script file or when it's published to an org.
		--apex-debug|-x @bool # Enable Apex debug logging during the agent preview conversation.
		--api-name|-n # API name of the published and active agent you want to interact with.
		--api-version # Override the api version used for api requests made by this command
		--authoring-bundle # API name of the authoring bundle metadata component that contains the agent's Agent Script file.
		--flags-dir # Import flag values from a directory.
		--output-dir|-d # Directory where conversation transcripts are saved.
		--target-org|-o # Username or alias of the target org. Not required if the `target-org` configuration variable is already set.
		--use-live-actions @bool # Use real actions in the org; if not specified, preview uses AI to simulate (mock) actions.
	agent:publish:authoring-bundle # An authoring bundle is a metadata type (named aiAuthoringBundle) that provides the blueprint for an agent.
		--api-name|-n # API name of the authoring bundle you want to publish; if not specified, the command provides a list that you can choose from.
		--api-version # Override the api version used for api requests made by this command
		--flags-dir # Import flag values from a directory.
		--json @bool # Format output as json.
		--skip-retrieve @bool # Don't retrieve the metadata associated with the agent to your DX project.
