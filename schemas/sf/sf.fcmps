	agent:test:results # This command requires a job ID, which the original "agent test run" command displays when it completes.
		--api-version # Override the api version used for api requests made by this command
		--flags-dir # Import flag values from a directory.
		--job-id|-i # Job ID of the completed agent test run.
		--json @bool # Format output as json.
		--output-dir|-d # If the agent test run completes, write the results to the specified directory. If the test is still running, the test results aren't written.
		--result-format (json|human|junit|tap) # Format of the agent test run results.
		--target-org|-o # Username or alias of the target org. Not required if the `target-org` configuration variable is already set.
		--verbose @bool # When enabled, includes detailed generated data (such as invoked actions) in the human-readable test results output. This is useful for debugging test failures and understanding what actions were actually invoked during the test run.  The generated data is in JSON format and includes the Apex classes or Flows that were invoked, the Salesforce objects that were touched, and so on. Use the JSON structure of this information to build the test case JSONPath expression when using custom evaluations.
	agent:test:resume # This command requires a job ID, which the original "agent test run" command displays when it completes.
		--api-version # Override the api version used for api requests made by this command
		--flags-dir # Import flag values from a directory.
		--job-id|-i # Job ID of the original agent test run.
		--json @bool # Format output as json.
		--output-dir|-d # If the agent test run completes, write the results to the specified directory. If the test is still running, the test results aren't written.
		--result-format (json|human|junit|tap) # Format of the agent test run results.
		--target-org|-o # Username or alias of the target org. Not required if the `target-org` configuration variable is already set.
		--use-most-recent|-r @bool # Use the job ID of the most recent agent test run.
		--verbose @bool # When enabled, includes detailed generated data (such as invoked actions) in the human-readable test results output. This is useful for debugging test failures and understanding what actions were actually invoked during the test run.  The generated data is in JSON format and includes the Apex classes or Flows that were invoked, the Salesforce objects that were touched, and so on. Use the JSON structure of this information to build the test case JSONPath expression when using custom evaluations.
		--wait|-w # Number of minutes to wait for the command to complete and display results to the terminal window.
	agent:test:run # Use the --api-name flag to specify the name of the agent test you want to run.
