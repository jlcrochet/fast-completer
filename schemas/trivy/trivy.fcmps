		--dependency-tree @bool # [EXPERIMENTAL] show dependency origin tree of vulnerable packages
		--detection-priority # specify the detection priority:
		--disable-telemetry @bool # disable sending anonymous usage data to Aqua
		--distro # [EXPERIMENTAL] specify a distribution, <family>/<version>
		--download-db-only @bool # download/update vulnerability database but don't run a scan
		--download-java-db-only @bool # download/update Java index database but don't run a scan
		--enable-modules # [EXPERIMENTAL] module names to enable
		--exit-code # specify exit code when any security issues are found
		--file-patterns # specify config file patterns
		--format # format
		--helm-api-versions # Available API versions used for Capabilities.APIVersions. This flag is the same as the api-versions flag of the helm template command. (can specify multiple or separate values with commas: policy/v1/PodDisruptionBudget,apps/v1/Deployment)
		--helm-kube-version # Kubernetes version used for Capabilities.KubeVersion. This flag is the same as the kube-version flag of the helm template command.
		--helm-set # specify Helm values on the command line (can specify multiple or separate values with commas: key1=val1,key2=val2)
		--helm-set-file # specify Helm values from respective files specified via the command line (can specify multiple or separate values with commas: key1=path1,key2=path2)
		--helm-set-string # specify Helm string values on the command line (can specify multiple or separate values with commas: key1=val1,key2=val2)
		--helm-values # specify paths to override the Helm values.yaml files
		--ignore-policy # specify the Rego file path to evaluate each vulnerability
		--ignore-status # comma-separated list of vulnerability status to ignore
		--ignore-unfixed @bool # display only fixed vulnerabilities
		--ignored-licenses # specify a list of license to ignore
		--ignorefile # specify .trivyignore file
		--include-deprecated-checks @bool # include deprecated checks
		--include-dev-deps @bool # include development dependencies in the report (supported: npm, yarn, gradle)
		--include-non-failures @bool # include successes, available with '--scanners misconfig'
		--java-db-repository # OCI repository(ies) to retrieve trivy-java-db in order of priority
		--license-confidence-level # specify license classifier's confidence level
		--license-full @bool # eagerly look for licenses in source code headers and license files
		--list-all-pkgs @bool # output all packages in the JSON report regardless of vulnerability
		--misconfig-scanners # comma-separated list of misconfig scanners to use for misconfiguration scanning
		--module-dir # specify directory to the wasm modules that will be loaded
		--no-progress @bool # suppress progress bar
		--offline-scan @bool # do not issue API requests to identify dependencies
		--output # output file name
		--output-plugin-arg # [EXPERIMENTAL] output plugin arguments
		--parallel # number of goroutines enabled for parallel scanning, set 0 to auto-detect parallelism
		--password # password. Comma-separated passwords allowed. TRIVY_PASSWORD should be used for security reasons.
		--password-stdin @bool # password from stdin. Comma-separated passwords are not supported.
		--pkg-relationships # list of package relationships
		--pkg-types # list of package types (allowed values: os,library)
		--raw-config-scanners # specify the types of scanners that will also scan raw configurations. For example, scanners will scan a non-adapted configuration into a shared state (allowed values: terraform)
		--redis-ca # redis ca file location, if using redis as cache backend
		--redis-cert # redis certificate file location, if using redis as cache backend
		--redis-key # redis key file location, if using redis as cache backend
		--redis-tls @bool # enable redis TLS with public certificates, if using redis as cache backend
		--registry-token # registry token
		--rego-error-limit # maximum number of compile errors allowed during Rego policy evaluation
		--rekor-url # [EXPERIMENTAL] address of rekor STL server
		--render-cause # specify configuration types for which the rendered causes will be shown in the table report (allowed values: terraform,ansible)
		--report # specify a compliance report format for the output (allowed values: all,summary)
		--sbom-sources # [EXPERIMENTAL] try to retrieve SBOM from the specified sources (allowed values: oci,rekor)
		--scanners # comma-separated list of what security issues to detect (allowed values: vuln,misconfig,secret,license)
		--secret-config # specify a path to config file for secret scanning
		--server # server address in client mode
		--severity # severities of security issues to be displayed
		--show-suppressed @bool # [EXPERIMENTAL] show suppressed vulnerabilities
		--skip-check-update @bool # skip fetching rego check updates
		--skip-db-update @bool # skip updating vulnerability database
		--skip-dirs # specify the directories or glob patterns to skip
		--skip-files # specify the files or glob patterns to skip
		--skip-java-db-update @bool # skip updating Java index database
		--skip-version-check @bool # suppress notices about version updates and Trivy announcements
		--skip-vex-repo-update @bool # [EXPERIMENTAL] Skip VEX Repository update
		--table-mode # [EXPERIMENTAL] tables that will be displayed in 'table' format (allowed values: summary,detailed)
		--template # output template
		--tf-exclude-downloaded-modules @bool # exclude misconfigurations for downloaded terraform modules
		--tf-vars # specify paths to override the Terraform tfvars files
		--token # for authentication in client/server mode
		--token-header # specify a header name for token in client/server mode
		--trace-rego @bool # enable more verbose trace output for custom queries
