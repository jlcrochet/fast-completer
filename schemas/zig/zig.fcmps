zig # Zig language compiler and toolchain
	ar # Use Zig as a drop-in archiver
		--format @bool # - archive format to create
		--plugin # - ignored for compatibility
		--output @bool # - the directory to extract archive members to
		--rsp-quoting @bool # - quoting style for response files
		--thin @bool # - create a thin archive
	ast-check # Look for simple compile errors in any set of files
		--zon @bool # Treat the input file as ZON, regardless of file extension
	build # Build project from build.zig
	build-exe # Create executable from source or object files
		--color # Enable or disable colored error messages
		--show-builtin @bool # Output the source of @import("builtin") then exit
		--cache-dir # Override the local cache directory
		--zig-lib-dir # Override path to Zig installation lib directory
		--name # Compilation unit name (not a file path)
		--libc # Provide a file which specifies libc paths
		--dep # Add an entry to the next module's import table
		--error-limit # Set the maximum amount of distinct error values
		--time-report @bool # Send timing diagnostics to '--listen' clients
		--embed-dir # Add directory to embed search path
		--version-script # Provide a version .map file
		--undefined-version @bool # Allow version scripts to refer to undefined symbols
		--no-undefined-version @bool # (default) Disallow version scripts from referring to undefined symbols
		--enable-new-dtags @bool # Use the new behavior for dynamic tags (RUNPATH)
		--disable-new-dtags @bool # Use the old behavior for dynamic tags (RPATH)
		--dynamic-linker # Set the dynamic interpreter path (usually ld.so)
		--sysroot # Set the system root directory (usually /)
		--force_undefined # Specify the symbol must be defined for the link to succeed
		--build-id # At a minor link-time expense, embeds a build ID in binaries
		--eh-frame-hdr @bool # Enable C++ exception handling by passing --eh-frame-hdr to linker
		--no-eh-frame-hdr @bool # Disable C++ exception handling by passing --no-eh-frame-hdr to linker
		--emit-relocs @bool # Enable output of relocation sections for post build tools
		--compress-debug-sections # Debug section compression settings
		--gc-sections @bool # Force removal of functions and data that are unreachable by the entry point or exported symbols
		--no-gc-sections @bool # Don't force removal of unreachable functions and data
		--sort-section # Sort wildcard section patterns by 'name' or 'alignment'
		--subsystem # (Windows) /SUBSYSTEM:<subsystem> to the linker
		--stack # Override default stack size
		--image-base # Set base address for executable image
		--entitlements # (Darwin) add path to entitlements file for embedding in code signature
		--import-memory @bool # (WebAssembly) import memory from the environment
		--export-memory @bool # (WebAssembly) export memory to the host (Default unless --import-memory used)
		--import-symbols @bool # (WebAssembly) import missing symbols from the host environment
		--import-table @bool # (WebAssembly) import function table from the host environment
		--export-table @bool # (WebAssembly) export function table to the host environment
		--initial-memory # (WebAssembly) initial size of the linear memory
		--max-memory # (WebAssembly) maximum size of the linear memory
		--shared-memory @bool # (WebAssembly) use shared linear memory
		--global-base # (WebAssembly) where to start to place global data
		--needed-library
		--export # (WebAssembly) Force a symbol to be exported
		--test-filter # Skip tests that do not match any filter
		--test-name-prefix # Add prefix to all tests
		--test-cmd # Specify test execution command one arg at a time
		--test-cmd-bin @bool # Appends test binary path to test cmd args
		--test-evented-io @bool # Runs the test in evented I/O mode
		--test-no-exec @bool # Compiles test binary without running it
		--test-runner # Specify a custom test runner
		--verbose-link @bool # Display linker invocations
		--verbose-cc @bool # Display C compiler invocations
