	cc # Use Zig as a drop-in C compiler
		--amdgpu-arch-tool # Tool used for detecting AMD GPU arch in the system.
		--analyzer-output # Static analyzer report output format (html|plist|plist-multi-file|plist-html|sarif|sarif-html|text).
		--analyze @bool # Run the static analyzer
		--config # Specify configuration file
		--cuda-compile-host-device @bool # Compile CUDA code for both host and device (default). Has no effect on non-CUDA compilations.
		--cuda-device-only @bool # Compile CUDA code for device only
		--cuda-feature # Manually specify the CUDA feature to use
		--cuda-host-only @bool # Compile CUDA code for host only. Has no effect on non-CUDA compilations.
		--cuda-include-ptx # Include PTX for the following GPU architecture (e.g. sm_35) or 'all'. May be specified more than once.
		--cuda-noopt-device-debug @bool # Enable device-side debug info generation. Disables ptxas optimizations.
		--cuda-path-ignore-env @bool # Ignore environment variables to detect CUDA installation
		--cuda-path # CUDA installation path
		--embed-dir # Add directory to embed search path
		--emit-extension-symbol-graphs @bool # Generate additional symbol graphs for extended modules.
		--emit-static-lib @bool # Enable linker job to emit a static library.
		--end-no-unused-arguments @bool # Start emitting warnings for unused driver arguments
		--extract-api-ignores # Comma separated list of files containing a new line separated list of API symbols to ignore when extracting API information.
		--gcc-install-dir # Use GCC installation in the specified directory. The directory ends with path components like 'lib{,32,64}/gcc{,-cross}/$triple/$version'. Note: executables (e.g. ld) used by the compiler are not overridden by the selected GCC installation
		--gcc-triple # Search for the GCC installation with the specified triple.
		--gpu-bundle-output @bool # Bundle output files of HIP device compilation
		--gpu-instrument-lib # Instrument device library for HIP, which is a LLVM bitcode containing __cyg_profile_func_enter and __cyg_profile_func_exit
		--gpu-max-threads-per-block # Default max threads per block for kernel launch bounds for HIP
		--help-hidden @bool # Display help for hidden options
		--hip-device-lib # HIP device library
		--hip-link @bool # Link clang-offload-bundler bundles for HIP
		--hip-path # HIP runtime installation path, used for finding HIP version and adding HIP include path.
		--hip-version # HIP version in the format of major.minor.patch
		--hipspv-pass-plugin # path to a pass plugin for HIP to SPIR-V passes.
		--hipstdpar-interpose-alloc @bool # Replace all memory allocation / deallocation calls with hipManagedMalloc / hipFree equivalents
		--hipstdpar-path # HIP Standard Parallel Algorithm Acceleration library path, used for finding and implicitly including the library header
		--hipstdpar-prim-path # rocPrim path, required by the HIP Standard Parallel Algorithm Acceleration library, used to implicitly include the rocPrim library
		--hipstdpar-thrust-path # rocThrust path, required by the HIP Standard Parallel Algorithm Acceleration library, used to implicitly include the rocThrust library
		--hipstdpar @bool # Enable HIP acceleration for standard parallel algorithms
		--libomptarget-amdgcn-bc-path # Path to libomptarget-amdgcn bitcode library
		--libomptarget-amdgpu-bc-path # Path to libomptarget-amdgcn bitcode library
		--libomptarget-nvptx-bc-path # Path to libomptarget-nvptx bitcode library
		--libomptarget-spirv-bc-path # Path to libomptarget-spirv bitcode library
		--migrate @bool # Run the migrator
		--no-cuda-include-ptx # Do not include PTX for the following GPU architecture (e.g. sm_35) or 'all'. May be specified more than once.
		--no-default-config @bool # Disable loading default configuration files
		--no-gpu-bundle-output @bool # Do not bundle output files of HIP device compilation
		--no-offload-arch # Remove CUDA/HIP offloading device architecture (e.g. sm_35, gfx906) from the list of devices to compile for. 'all' resets the list to its default value.
		--no-system-header-prefix # Treat all #include paths starting with <prefix> as not including a system header.
		--no-wasm-opt @bool # Disable the wasm-opt optimizer
		--nvptx-arch-tool # Tool used for detecting NVIDIA GPU arch in the system.
		--offload-arch # Specify an offloading device architecture for CUDA, HIP, or OpenMP. (e.g. sm_35). If 'native' is used the compiler will detect locally installed architectures. For HIP offloading, the device architecture can be followed by target ID features delimited by a colon (e.g. gfx908:xnack+:sramecc-). May be specified more than once.
		--offload-compress @bool # Compress offload device binaries (HIP only)
		--offload-device-only @bool # Only compile for the offloading device.
		--offload-host-device @bool # Compile for both the offloading host and device (default).
		--offload-host-only @bool # Only compile for the offloading host.
		--offload-link @bool # Use the new offloading linker to perform the link job.
		--offload-new-driver @bool # Use the new driver for offloading compilation.
		--offload # Specify comma-separated list of offloading target triples (CUDA and HIP only)
		--precompile @bool # Only precompile the input
		--pretty-sgf @bool # Emit pretty printed symbol graphs
		--ptxas-path # Path to ptxas (used for compiling CUDA code)
		--rocm-device-lib-path # ROCm device library path. Alternative to rocm-path.
		--rocm-path # ROCm installation path, used for finding and automatically linking required bitcode libraries.
		--start-no-unused-arguments @bool # Don't emit warnings about unused arguments for the following arguments
		--symbol-graph-dir # Directory in which to emit symbol graphs.
		--system-header-prefix # Treat all #include paths starting with <prefix> as including a system header.
		--target # Generate code for the given target
		--verify-debug-info @bool # Verify the binary representation of debug output
		--warning-suppression-mappings # File containing diagnostic suppresion mappings. See user manual for file format.
		--wasm-opt @bool # Enable the wasm-opt optimizer (default)
		--dxv-path # DXIL validator installation path
