			--dumpLogs @bool # dump logs to disk on failure if set to true
			--verbose # set log level, use 0 to silence, 4 for debugging and 5 for debugging with AWS debug logging
			--attach-policy # Inline IAM policy document to attach to the role (JSON string)
			--attach-policy-arns # List of IAM policy ARNs to attach to the role
			--cluster # EKS cluster name
			--config-file # load configuration from a file (or stdin if set to '-')
			--delete-propagation-policy # Delete propagation policy
			--name # Name of the capability
			--profile # AWS credentials profile to use (defaults to the value of the AWS_PROFILE environment variable)
			--region # AWS region. Defaults to the value set in your AWS config (~/.aws/config)
			--role-arn # IAM role ARN for the capability (optional if IAM policies are provided)
			--tags # Tags to apply to the capability
			--timeout # maximum waiting time for any long-running operation
			--type # Type of the capability (ACK, KRO, ARGOCD)
		cluster # Create a cluster
			--color # toggle colorized logs (valid options: true, false, fabulous)
			--dumpLogs @bool # dump logs to disk on failure if set to true
			--verbose # set log level, use 0 to silence, 4 for debugging and 5 for debugging with AWS debug logging
			--alb-ingress-access @bool # enable full access for alb-ingress-controller
			--appmesh-access @bool # enable full access to AppMesh
			--appmesh-preview-access @bool # enable full access to AppMesh Preview
			--asg-access @bool # enable IAM policy for cluster-autoscaler
			--authenticator-role-arn # AWS IAM role to assume for authenticator
			--auto-kubeconfig @bool # save kubeconfig file by cluster name, e.g. "/home/jeffrey/.kube/eksctl/clusters/wonderful-outfit-1771407794"
			--cfn-disable-rollback @bool # for debugging: If a stack fails, do not roll it back. Be careful, this may lead to unintentional resource consumption!
			--cfn-role-arn # IAM role used by CloudFormation to call AWS API on your behalf
			--config-file # load configuration from a file (or stdin if set to '-')
			--disable-pod-imds @bool # Blocks IMDS requests from non-host networking pods
			--dry-run @bool # Dry-run mode that skips cluster creation and outputs a ClusterConfig
			--enable-auto-mode @bool # enables Auto Mode
			--enable-node-repair @bool # Enable automatic node repair (managed nodegroups only)
			--enable-ssm @bool # Enable AWS Systems Manager (SSM)
			--external-dns-access @bool # enable IAM policy for external-dns
			--fargate @bool # Create a Fargate profile scheduling pods in the default and kube-system namespaces onto Fargate
			--full-ecr-access @bool # enable full access to ECR
			--install-neuron-plugin @bool # install Neuron plugin for Inferentia and Trainium nodes
			--install-nvidia-plugin @bool # install Nvidia plugin for GPU nodes
			--instance-name # overrides the default instance's name
			--instance-prefix # add a prefix value in front of the instance's name
			--instance-selector-cpu-architecture # x86_64, or arm64
			--instance-selector-gpus # an integer value
			--instance-selector-memory # 4 or 4GiB
			--instance-selector-neuron-devices # an integer value
			--instance-selector-vcpus # an integer value (2, 4 etc)
			--instance-types # Comma-separated list of instance types (e.g., --instance-types=c3.large,c4.large,c5.large
			--kubeconfig # path to write kubeconfig (incompatible with --auto-kubeconfig)
			--managed @bool # Create EKS-managed nodegroup
			--max-pods-per-node # maximum number of pods per node (set automatically if unspecified)
			--name # EKS cluster name (generated if unspecified, e.g. "wonderful-outfit-1771407794")
			--node-ami # 'auto-ssm', 'auto' or an AMI ID (advanced use)
			--node-ami-family # supported AMI families: AmazonLinux2023, AmazonLinux2, UbuntuPro2404, Ubuntu2404, UbuntuPro2204, Ubuntu2204, UbuntuPro2004, Ubuntu2004, Bottlerocket, WindowsServer2019CoreContainer, WindowsServer2019FullContainer, WindowsServer2022CoreContainer, WindowsServer2022FullContainer, WindowsServer2025CoreContainer, WindowsServer2025FullContainer
			--node-labels # extra labels to add when registering the nodes in the nodegroup. List of comma separated KV pairs "k1=v1,k2=v2"
			--node-private-networking @bool # whether to make nodegroup networking private
			--node-repair-max-parallel-count # Maximum count of unhealthy nodes that can be repaired concurrently or in parallel (managed nodegroups only)
			--node-repair-max-parallel-percentage # Maximum percentage of unhealthy nodes that can be repaired concurrently or in parallel (managed nodegroups only)
			--node-repair-max-unhealthy-count # Count threshold of unhealthy nodes, above which node auto repair actions will stop (managed nodegroups only)
			--node-repair-max-unhealthy-percentage # Percentage threshold of unhealthy nodes, above which node auto repair actions will stop (managed nodegroups only)
			--node-security-groups # attach additional security groups to nodes
			--node-type # node instance type
			--node-volume-size # node volume size in GB
			--node-volume-type # node volume type (valid options: gp2, gp3, io1, io2, sc1, st1)
			--node-zones # (inherited from the cluster if unspecified)
			--nodegroup-name # name of the nodegroup (generated if unspecified, e.g. "ng-c7de9c30")
			--nodegroup-parallelism # Number of self-managed or managed nodegroups to create in parallel
			--nodes # total number of nodes (for a static ASG)
			--nodes-max # maximum nodes in ASG
			--nodes-min # minimum nodes in ASG
			--profile # AWS credentials profile to use (defaults to the value of the AWS_PROFILE environment variable)
			--region # AWS region. Defaults to the value set in your AWS config (~/.aws/config)
			--set-kubeconfig-context @bool # if true then current-context will be set in kubeconfig; if a context is already set then it will be overwritten
			--spot @bool # Create a spot nodegroup (managed nodegroups only)
			--ssh-access @bool # control SSH access for nodes. Uses ~/.ssh/id_rsa.pub as default key path if enabled
			--ssh-public-key # SSH public key to use for nodes (import from local path, or use existing EC2 key pair)
			--support-type # Set cluster's upgradePolicy supportType
			--tags # Used to tag the AWS resources. List of comma separated KV pairs "k1=v1,k2=v2"
			--timeout # maximum waiting time for any long-running operation
			--vpc-cidr # global CIDR to use for VPC
			--vpc-from-kops-cluster # re-use VPC from a given kops cluster
			--vpc-nat-mode # VPC NAT mode, valid options: HighlyAvailable, Single, Disable
			--vpc-private-subnets # re-use private subnets of an existing VPC; the subnets must exist in availability zones and not other types of zones
			--vpc-public-subnets # re-use public subnets of an existing VPC; the subnets must exist in availability zones and not other types of zones
			--with-oidc @bool # Enable the IAM OIDC provider
			--without-nodegroup @bool # if set, initial nodegroup will not be created
			--write-kubeconfig @bool # toggle writing of kubeconfig
			--zones # (auto-select if unspecified)
