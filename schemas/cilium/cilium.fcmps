			--as # Username to impersonate for the operation. User could be a regular user or a service account in a namespace.
			--as-group # Group to impersonate for the operation, this flag can be repeated to specify multiple groups.
			--context # Kubernetes configuration context
			--helm-release-name # Helm release name
			--kubeconfig # Path to the kubeconfig file
			--namespace # Namespace Cilium is running in. Can also be set via CILIUM_NAMESPACE env var
			--bandwidth @bool # Test pod network bandwidth manage
			--crr @bool # Run CRR test
			--debug @bool # Show debug messages
			--duration # Duration for the Performance test to run
			--host-net @bool # Test host network
			--host-to-pod @bool # Test host-to-pod traffic
			--msg-size # Size of message to use in UDP test
			--namespace-labels # Add labels to the connectivity test namespace
			--net-qos @bool # Test pod network Quality of Service
			--node-selector-client # Node selector for the other-node client pod
			--node-selector-server # Node selector for the server pod (and client same-node)
			--other-node @bool # Run tests in which the client and the server are hosted on difference nodes
			--performance-image # Image path to use for performance
			--pod-net @bool # Test pod network
			--pod-to-host @bool # Test pod-to-host traffic
			--print-image-artifacts @bool # Prints the used image artifacts
			--report-dir # Directory to save perf results in json format
			--rr @bool # Run RR test
			--same-node @bool # Run tests in which the client and the server are hosted on the same node
			--samples # Number of Performance samples to capture (how many times to run each test)
			--setup-delay # Extra delay before starting the performance tests
			--streams # The parallelism of tests with multiple streams
			--test-namespace # Namespace to perform the connectivity in (always suffixed with a sequence number to be compliant with test-concurrency param, e.g.: cilium-test-1)
			--throughput @bool # Run throughput test
			--throughput-multi @bool # Run throughput test with multiple streams
			--tolerations # Extra NoSchedule tolerations added to test pods
			--udp @bool # Run UDP tests
			--unsafe-capture-kernel-profiles @bool # Capture kernel profiles during test execution. Warning: run on disposable nodes only, as it installs additional software and modifies their configuration
		test # Validate connectivity in cluster
			--as # Username to impersonate for the operation. User could be a regular user or a service account in a namespace.
			--as-group # Group to impersonate for the operation, this flag can be repeated to specify multiple groups.
			--context # Kubernetes configuration context
			--helm-release-name # Helm release name
			--kubeconfig # Path to the kubeconfig file
			--namespace # Namespace Cilium is running in. Can also be set via CILIUM_NAMESPACE env var
			--agent-daemonset-name # Name of cilium agent daemonset
			--agent-pod-selector # Label on cilium-agent pods to select with
			--all-flows @bool # Print all flows during flow validation
			--assume-cilium-version # Assume Cilium version for connectivity tests
			--chart-directory # Helm chart directory
			--cilium-pod-selector # Label selector matching all cilium-related pods
			--collect-sysdump-on-failure @bool # Collect sysdump after a test fails
			--conn-disrupt-dispatch-interval # TCP packet dispatch interval
			--conn-disrupt-test-restarts-path # Conn disrupt test temporary result file (used internally)
			--conn-disrupt-test-setup @bool # Set up conn disrupt test dependencies
			--conn-disrupt-test-xfrm-errors-path # Conn disrupt test temporary result file (used internally)
			--connect-timeout # Maximum time to allow initiation of the connection to take
			--curl-image # Image path to use for curl
			--curl-insecure @bool # Pass --insecure to curl
			--curl-parallel # Number of parallel requests in curl commands (0 to disable)
			--debug @bool # Show debug messages
			--dns-test-server-image # Image path to use for CoreDNS
			--echo-image # Image path to use for echo server
			--external-cidr # IPv4 CIDR to use as external target in connectivity tests
			--external-cidrv6 # IPv6 CIDR to use as external target in connectivity tests
			--external-ip # IPv4 to use as external target in connectivity tests
			--external-ipv6 # IPv6 to use as external target in connectivity tests
			--external-other-ip # Other IPv4 to use as external target in connectivity tests
			--external-other-ipv6 # Other IPv6 to use as external target in connectivity tests
			--external-other-target # Domain name to use as a second external target in connectivity tests
			--external-target # Domain name to use as external target in connectivity tests
			--external-target-ca-name # Name of the CA secret for the external target.
			--external-target-ca-namespace # Namespace of the CA secret for the external target.
			--external-target-ipv6-capable @bool # External target is IPv6 capable
			--flow-validation # Enable Hubble flow validation { disabled | warning | strict }
			--force-deploy @bool # Force re-deploying test artifacts
			--frr-image # Image path to use for FRR
			--helm-values-secret-name # Secret name to store the auto-generated helm values file. The namespace is the same as where Cilium will be installed
			--hubble @bool # Automatically use Hubble for flow validation & troubleshooting
			--hubble-server # Address of the Hubble endpoint for flow validation
			--include-conn-disrupt-test @bool # Include conn disrupt test
			--include-conn-disrupt-test-egw @bool # Include conn disrupt test for Egress Gateway
			--include-conn-disrupt-test-l7-traffic @bool # Include conn disrupt test for L7 traffic
			--include-conn-disrupt-test-ns-traffic @bool # Include conn disrupt test for NS traffic
			--ip-families # Restrict test actions to specific IP families
			--json-mock-image # Image path to use for json mock
			--junit-file # Generate junit report and write to file
			--junit-property # Add key=value properties to the generated junit file
			--k8s-version # Kubernetes server version in case auto-detection fails
			--multi-cluster # Test across clusters to given context
			--namespace-labels # Add labels to the connectivity test namespace
			--node-cidr # one or more CIDRs that cover all nodes in the cluster
			--node-selector # Restrict connectivity pods to nodes matching this label
			--pause-on-fail @bool # Pause execution on test failure
			--post-test-sleep # Wait time after each test before next test starts
			--print-flows @bool # Print flow logs for each test
			--print-image-artifacts @bool # Prints the used image artifacts
			--request-timeout # Maximum time to allow a request to take
			--retry # Number of retries on connection failure to external targets
			--retry-delay # Delay between retries for external targets
			--secondary-network-iface # Secondary network iface name (e.g., to test NodePort BPF on multiple networks)
			--service-type # Type of Kubernetes Services created for connectivity tests
			--single-node @bool # Limit to tests able to run on a single node
			--socat-image # Image path to use for multicast tests
			--sysdump-cilium-bugtool-flags # Optional set of flags to pass to cilium-bugtool command.
			--sysdump-cilium-daemon-set-label-selector # The labels used to target Cilium daemon set
			--sysdump-cilium-envoy-label-selector # The labels used to target Cilium Envoy pods
			--sysdump-cilium-helm-release-name # The Cilium Helm release name for which to get values. If not provided then the --helm-release-name global flag is used (if provided)
			--sysdump-cilium-label-selector # The labels used to target Cilium pods
			--sysdump-cilium-namespace # The namespace Cilium is running in. If not provided then the --namespace global flag is used (if provided)
			--sysdump-cilium-node-init-selector # The labels used to target Cilium node init pods
			--sysdump-cilium-operator-label-selector # The labels used to target Cilium operator pods
			--sysdump-cilium-operator-namespace # The namespace Cilium operator is running in. If not provided then the --namespace global flag is used (if provided)
			--sysdump-cilium-spire-agent-selector # The labels used to target Cilium spire-agent pods
			--sysdump-cilium-spire-namespace # The namespace Cilium SPIRE installation is running in
			--sysdump-cilium-spire-server-selector # The labels used to target Cilium spire-server pods
			--sysdump-clustermesh-apiserver-label-selector # The labels used to target 'clustermesh-apiserver' pods
			--sysdump-cni-config-directory # Directory where CNI configs are located
			--sysdump-cni-configmap-name # The name of the CNI config map
			--sysdump-collect-logs-from-not-ready-agents @bool # Whether to collect logs from not ready Cilium agent pods
			--sysdump-copy-retry-limit # Retry limit for file copying operations. If set to -1, copying will be retried indefinitely. Useful for collecting sysdump while on unreliable connection.
			--sysdump-debug @bool # Whether to enable debug logging
			--sysdump-detect-gops-pid @bool # Whether to automatically detect the gops agent PID.
			--sysdump-extra-label-selectors # Optional set of labels selectors used to target additional pods for log collection.
			--sysdump-hubble-flows-count # Number of Hubble flows to collect. Setting to zero disables collecting Hubble flows.
			--sysdump-hubble-flows-timeout # Timeout for collecting Hubble flows
			--sysdump-hubble-generate-certs-labels # The labels used to target Hubble UI pods
			--sysdump-hubble-label-selector # The labels used to target Hubble pods
			--sysdump-hubble-relay-labels # The labels used to target Hubble Relay pods
			--sysdump-hubble-ui-labels # The labels used to target Hubble UI pods
			--sysdump-logs-limit-bytes # The limit on the number of bytes to retrieve when collecting logs
			--sysdump-logs-since-time # How far back in time to go when collecting logs
			--sysdump-node-list # Comma-separated list of node IPs or names to filter pods for which to collect gops and logs
			--sysdump-output-filename # The name of the resulting file (without extension)
			--sysdump-profiling @bool # Whether to enable scraping profiling data
			--sysdump-quick @bool # Whether to enable quick mode (i.e. skip collection of 'cilium-bugtool' output and logs)
			--sysdump-tetragon-helm-release-name # The Tetragon Helm release name for which to get values.
			--sysdump-tetragon-label-selector # The labels used to target Tetragon pods
			--sysdump-tetragon-namespace # The namespace Tetragon is running in
			--sysdump-tetragon-operator-label-selector # The labels used to target Tetragon operator pods
			--sysdump-tracing @bool # Whether to enable scraping tracing data
			--sysdump-worker-count # The number of workers to use
			--test # Run tests that match one of the given regular expressions, skip tests by starting the expression with '!', target Scenarios with e.g. '/pod-to-cidr'
			--test-concurrency # Count of namespaces to perform the connectivity tests in parallel (value <= 0 will be treated as 1)
			--test-conn-disrupt-image # Image path to use for connection disruption tests
			--test-namespace # Namespace to perform the connectivity in (always suffixed with a sequence number to be compliant with test-concurrency param, e.g.: cilium-test-1)
			--timeout # Maximum time to allow the connectivity test suite to take
			--timestamp @bool # Show timestamp in messages
			--tolerations # Extra NoSchedule tolerations added to test pods
			--verbose @bool # Show informational messages and don't buffer any lines
