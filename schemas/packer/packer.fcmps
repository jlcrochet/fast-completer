# Packer CLI schema for fast-completer
# Generated from packer 1.15.0

packer # HashiCorp Packer
	build # build image(s) from template
		-color # Disable color output. (Default: color)
		-debug @bool # Debug mode enabled for builds.
		-force @bool # Force a build to continue if artifacts exist, deletes existing artifacts.
		-machine-readable @bool # Produce machine-readable output.
		-parallel-builds # Number of builds to run in parallel. 1 disables parallelization. 0 means no limit (Default: 0)
		-timestamp-ui @bool # Enable prefixing of each ui output with an RFC3339 timestamp.
		-var # Variable for templates, can be used multiple times.
		-var-file # JSON or HCL2 file containing user variables, can be used multiple times.
		-warn-on-undeclared-var @bool # Display warnings for user variable files containing undeclared variables.
		-ignore-prerelease-plugins @bool # Disable the loading of prerelease plugin binaries (x.y.z-dev).
		-use-sequential-evaluation @bool # Fallback to using a sequential approach for local/datasource evaluation.
	console # creates a console for testing variable interpolation
		-var # Variable for templates, can be used multiple times.
		-var-file # JSON or HCL2 file containing user variables.
		-config-type @bool # Set to 'hcl2' to run in HCL2 mode when no file is passed. Defaults to json.
		-use-sequential-evaluation @bool # Fallback to using a sequential approach for local/datasource evaluation.
	fix # fixes templates from old versions of packer
		-validate # If true (default), validates the fixed template.
	fmt # Rewrites HCL2 config files to canonical format
		-check @bool # Check if the input is formatted. Exit status will be 0 if all
		-diff @bool # Display diffs of formatting change
		-write # Don't write to source files
		-recursive @bool # Also process files in subdirectories. By default, only the
	hcl2_upgrade # transform a JSON template into an HCL2 configuration
		-output-file # Set output file name. By default this will be the
		-with-annotations @bool # Add helper annotation comments to the file to help new
	init # Install missing plugins or upgrade plugins
		-upgrade @bool # On top of installing missing plugins, update
		-force @bool # Forces reinstallation of plugins, even if already
	inspect # see components of a template
		-machine-readable @bool # Machine-readable output
		-use-sequential-evaluation @bool # Fallback to using a sequential approach for local/datasource evaluation.
	plugins # Interact with Packer plugins and catalog
		install
			-path # Install the plugin from a locally-sourced plugin binary.
			-force @bool # Forces reinstallation of plugins, even if already installed.
		installed
		remove
		required
	validate # check that a template is valid
		-syntax-only @bool # Only check syntax. Do not verify config of the template.
		-machine-readable @bool # Produce machine-readable output.
		-var # Variable for templates, can be used multiple times.
		-var-file # JSON or HCL2 file containing user variables, can be used multiple times.
		-no-warn-undeclared-var @bool # Disable warnings for user variable files containing undeclared variables.
		-evaluate-datasources @bool # Evaluate data sources during validation (HCL2 only, may incur costs); Defaults to false.
		-ignore-prerelease-plugins @bool # Disable the loading of prerelease plugin binaries (x.y.z-dev).
		-use-sequential-evaluation @bool # Fallback to using a sequential approach for local/datasource evaluation.
	version # Prints the Packer version
