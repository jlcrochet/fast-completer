# istioctl CLI schema for fast-completer
# Generated from istioctl unknown

istioctl # Istio service mesh CLI
	--as # Username to impersonate for the operation. User could be a regular user or a service account in a namespace
	--as-group # Group to impersonate for the operation, this flag can be repeated to specify multiple groups.
	--as-uid # UID to impersonate for the operation.
	--context # Kubernetes configuration context
	--help @bool # help for istioctl
	--istioNamespace # Istio system namespace
	--kubeclient-timeout # Kubernetes client timeout as a time.Duration string, defaults to 15 seconds.
	--kubeconfig # Kubernetes configuration file
	--namespace # Kubernetes namespace
	--vklog # number for the log level verbosity. Like -v flag. ex: --vklog=9
	admin # Manage control plane (istiod) configuration
		--as # Username to impersonate for the operation. User could be a regular user or a service account in a namespace
		--as-group # Group to impersonate for the operation, this flag can be repeated to specify multiple groups.
		--as-uid # UID to impersonate for the operation.
		--context # Kubernetes configuration context
		--istioNamespace # Istio system namespace
		--kubeclient-timeout # Kubernetes client timeout as a time.Duration string, defaults to 15 seconds.
		--kubeconfig # Kubernetes configuration file
		--namespace # Kubernetes namespace
		--vklog # number for the log level verbosity. Like -v flag. ex: --vklog=9
		--selector # label selector
		log # Manage istiod logging.
			--as # Username to impersonate for the operation. User could be a regular user or a service account in a namespace
			--as-group # Group to impersonate for the operation, this flag can be repeated to specify multiple groups.
			--as-uid # UID to impersonate for the operation.
			--context # Kubernetes configuration context
			--istioNamespace # Istio system namespace
			--kubeclient-timeout # Kubernetes client timeout as a time.Duration string, defaults to 15 seconds.
			--kubeconfig # Kubernetes configuration file
			--namespace # Kubernetes namespace
			--selector # label selector
			--vklog # number for the log level verbosity. Like -v flag. ex: --vklog=9
			--ctrlz_port # ControlZ port
			--level # Comma-separated list of output logging level for scopes in the format of <scope>:<level>[,<scope>:<level>,...]. Possible values for <level>: none, error, warn, info, debug
			--log-reset @bool # Reset log levels to default value. (info)
			--output # Output format: one of json|yaml|short
			--reset @bool # Reset all levels to default value. (info)
			--revision # Control plane revision
			--stack-trace-level # Comma-separated list of stack trace level for scopes in the format of <scope>:<stack-trace-level>[,<scope>:<stack-trace-level>,...]. Possible values for <stack-trace-level>: none, error, warn, info, debug
			--stack-trace-reset @bool # Reset stack stace levels to default value. (none)
	analyze # Analyze Istio configuration and print validation messages
		--as # Username to impersonate for the operation. User could be a regular user or a service account in a namespace
		--as-group # Group to impersonate for the operation, this flag can be repeated to specify multiple groups.
		--as-uid # UID to impersonate for the operation.
		--context # Kubernetes configuration context
		--istioNamespace @bool # Istio system namespace
		--kubeclient-timeout # Kubernetes client timeout as a time.Duration string, defaults to 15 seconds.
		--kubeconfig # Kubernetes configuration file
		--namespace # Kubernetes namespace
		--vklog # number for the log level verbosity. Like -v flag. ex: --vklog=9
		--all-namespaces @bool # Analyze all namespaces
		--analyzer # Select specific analyzers to run. Can be repeated. If not specified, all analyzers are run. (e.g. istioctl analyze --analyzer "gateway.ConflictingGatewayAnalyzer")
		--color @bool # Default true.  Disable with '=false' or set $TERM to dumb
		--failure-threshold # The severity level of analysis at which to set a non-zero exit code. Valid values: [Info Warning Error]
		--ignore-unknown @bool # Don't complain about un-parseable input documents, for cases where analyze should run only on k8s compliant inputs.
		--list-analyzers @bool # List the analyzers available to run. Suppresses normal execution.
		--meshConfigFile # Overrides the mesh config values to use for analysis.
		--output # Output format: one of [log json yaml]
		--output-threshold # The severity level of analysis at which to display messages. Valid values: [Info Warning Error]
		--recursive @bool # [Removed: The recursive flag has been removed and is hardcoded to true] Process directory arguments recursively.
		--remote-contexts # Kubernetes configuration contexts for remote clusters to be used in multi-cluster analysis. Not to be confused with '--context'. If unspecified, contexts are read from the remote secrets in the cluster.
		--revision # analyze a specific revision deployed.
		--suppress # Suppress reporting a message code on a specific resource. Values are supplied in the form <code>=<resource> (e.g. '--suppress "IST0102=DestinationRule primary-dr.default"'). Can be repeated. You can include the wildcard character '*' to support a partial match (e.g. '--suppress "IST0102=DestinationRule *.default" ).
		--timeout # The duration to wait before failing
		--use-kube @bool # Use live Kubernetes cluster for analysis. Set --use-kube=false to analyze files only.
		--verbose @bool # Enable verbose output
	authz # (authz is experimental. Use `istioctl experimental authz`)
		--as # Username to impersonate for the operation. User could be a regular user or a service account in a namespace
		--as-group # Group to impersonate for the operation, this flag can be repeated to specify multiple groups.
