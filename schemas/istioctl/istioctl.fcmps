		--auth-plugin-config # Authenticator plug-in configuration. --auth-type=plugin must be set with this option
		--auth-plugin-name # Authenticator plug-in name. --auth-type=plugin must be set with this option
		--auth-type # Type of authentication to use. supported values = [bearer-token plugin]
		--create-service-account @bool # If true, the service account needed for creating the remote secret will be created if it doesn't exist.
		--manifests # Specify a path to a directory of charts and profiles
		--name # Name of the local cluster whose credentials are stored in the secret. If a name is not specified the kube-system namespace's UUID of the local cluster will be used.
		--secret-name # The name of the specific secret to use from the service-account. Needed when there are multiple secrets in the service account.
		--server # The address and port of the Kubernetes API server.
		--service-account # Create a secret with this service account's credentials. Default value is "istio-reader-service-account" if --type is "remote", "istiod" if --type is "config".
		--tls-server-name # The server name that should be validated by kube-client during establishing TLS connection with kube-apiserver.
		--type # Type of the generated secret. supported values = [remote config]
