			--dir # Set a specific directory for temporary artifact storage.
			--dry-run @bool # Only log commands that would be run, don't fetch or write.
			--duration # How far to go back in time from end-time for log entries to include in the archive. Default is infinity. If set, --start-time must be unset.
			--end-time # End time for the range of log entries to include in the archive. Default is now.
			--exclude # Spec for which pod's proxy logs to exclude from the archive, after the include spec is processed. See above for format and examples.
			--filename # Path to a file containing configuration in YAML format. The file contents are applied over the default values and flag settings, with lists being replaced per JSON merge semantics.
			--full-secrets @bool # If set, secret contents are included in output.
			--ignore-errs # List of comma separated glob patterns to match against log error strings. Any error matching these patterns is ignored when calculating the log importance heuristic.
			--include # Spec for which pod's proxy logs to include in the archive. See above for format and examples.
			--istio-namespace # Namespace where Istio control plane is installed.
			--istioNamespace @bool # Istio system namespace
			--kubeclient-timeout # Kubernetes client timeout as a time.Duration string, defaults to 15 seconds.
			--kubeconfig # Path to kube config.
			--namespace @bool # Kubernetes namespace
			--output-dir # Set a specific directory for output archive file.
			--proxy-admin-port # Envoy proxy admin port
			--rq-concurrency # Set the concurrency limit of requests to the Kubernetes API server, defaults to 32.
			--start-time # Start time for the range of log entries to include in the archive. Default is the infinite past. If set, --duration must be unset.
			--timeout # Maximum amount of time to spend fetching logs. When timeout is reached only the logs captured so far are saved to the archive.
			--vklog # number for the log level verbosity. Like -v flag. ex: --vklog=9
			--output # One of 'yaml' or 'json'.
			--short @bool # Use --short=false to generate full version information
