			--all-platforms @bool # Convert content for all platforms
			--estargz @bool # Convert legacy tar(.gz) layers to eStargz for lazy pulling. Should be used in conjunction with '--oci'
			--estargz-chunk-size # eStargz chunk size
			--estargz-compression-level # eStargz compression level (default 9)
			--estargz-external-toc @bool # Separate TOC JSON into another image (called "TOC image"). The name of TOC image is the original + "-esgztoc" suffix. Both eStargz and the TOC image should be pushed to the same registry. (requires stargz-snapshotter >= v0.13.0) (EXPERIMENTAL)
			--estargz-gzip-helper # Helper command for decompressing layers compressed with gzip. Options: pigz, igzip, or gzip.
			--estargz-keep-diff-id @bool # Convert to esgz without changing diffID (cannot be used in conjunction with '--estargz-record-in'. must be specified with '--estargz-external-toc')
			--estargz-min-chunk-size # The minimal number of bytes of data must be written in one gzip stream. (requires stargz-snapshotter >= v0.13.0)
			--estargz-record-in # Read 'ctr-remote optimize --record-out=<FILE>' record file (EXPERIMENTAL)
			--format # Format the output using the given Go template, e.g, 'json'
			--nydus @bool # Convert an OCI image to Nydus image. Should be used in conjunction with '--oci'
			--nydus-builder-path # The nydus-image binary path, if unset, search in PATH environment (default "nydus-image")
			--nydus-compressor # Nydus blob compression algorithm, possible values: none, `lz4_block`, `zstd`, default is `lz4_block` (default "lz4_block")
			--nydus-prefetch-patterns # The file path pattern list want to prefetch
			--nydus-work-dir # Work directory path for image conversion, default is the nerdctl data root directory
			--oci @bool # Convert Docker media types to OCI media types
			--overlaybd @bool # Convert tar.gz layers to overlaybd layers
