			--output|-o # Output destination (format: type=local,dest=path)
			--platform # Set target platform for build (e.g., "amd64", "arm64")
			--progress # Set type of progress output (auto, plain, tty). Use plain to show container output (default "auto")
			--provenance # Shorthand for "--attest=type=provenance"
			--pull @bool # On true, always attempt to pull latest image version from remote. Default uses buildkit's default.
			--quiet|-q @bool # Suppress the build output and print image ID on success
			--rm @bool # Remove intermediate containers after a successful build (default true)
			--sbom # Shorthand for "--attest=type=sbom"
