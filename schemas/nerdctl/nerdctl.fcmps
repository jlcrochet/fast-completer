			--soci-span-size # The size of SOCI spans (default -1)
			--uncompress @bool # Convert tar.gz layers to uncompressed tar layers
			--zstd @bool # Convert legacy tar(.gz) layers to zstd. Should be used in conjunction with '--oci'
			--zstd-compression-level # zstd compression level (default 3)
