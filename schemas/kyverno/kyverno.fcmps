		--logtostderr @bool # log to standard error instead of files
		--one_output @bool # If true, only write logs to their native severity level (vs also writing to each lower severity level; no effect when -logtostderr=true)
		--skip_headers @bool # If true, avoid header prefixes in the log messages
		--skip_log_headers @bool # If true, avoid headers when opening log files (no effect when -logtostderr=true)
		--stderrthreshold # logs at or above this threshold go to stderr when writing to files and stderr (no effect when -logtostderr=true or -alsologtostderr=true)
		--v # number for the log level verbosity
		--vmodule # comma-separated list of pattern=N settings for file-filtered logging
		--audit-warn @bool # If set to true, will flag audit policies as warnings instead of failures
		--batch-size # Number of resources to fetch per API call
		--cluster @bool # Checks if policies should be applied to cluster in the current context
		--cluster-wide-resources @bool # If set to true, will apply policies to cluster-wide resources
		--concurrent # Number of concurrent workers for resource loading
		--context # The name of the kubeconfig context to use
		--context-file # File containing context data for CEL policies
		--continue-on-error @bool # Continue processing despite resource loading errors
		--continue-on-fail @bool # If set to true, will continue to apply policies on the next resource upon failure to apply to the current resource instead of exiting out
		--detailed-results @bool # If set to true, display detailed results
		--exception # Policy exception to be considered when evaluating policies against resources
		--exceptions # Policy exception to be considered when evaluating policies against resources
		--exceptions-with-resources @bool # Evaluate policy exceptions from the resources path
		--generate-exceptions @bool # Generate policy exceptions for each violation
		--generated-exception-ttl # Default TTL for generated exceptions
		--git-branch # test git repository branch
		--json # Path to JSON payload files
		--kubeconfig # path to kubeconfig file with authorization and master location information
		--namespace # Optional Policy parameter passed with cluster flag
		--output # Prints the mutated/generated resources in provided file/directory
		--output-format # Specifies the policy report format (json or yaml). Default: yaml.
		--parameter-resource # Path to resource files that act as ValidatingAdmissionPolicy/MutatingAdmissionPolicy parameters
		--password # Password for connecting to git repository
		--policy-report @bool # Generates policy report when passed (default policyviolation)
		--registry @bool # If set to true, access the image registry using local docker credentials to populate external data
		--remove-color @bool # Remove any color from output
		--resource # Path to resource files
		--resources # Path to resource files
		--set # Variables that are required
		--show-performance @bool # Show resource loading performance metrics
		--stdin @bool # Optional mutate policy parameter to pipe directly through to kubectl
		--table @bool # Show results in table format
		--target-resource # Path to individual files containing target resources files for policies that have mutate existing
		--target-resources # Path to a directory containing target resources files for policies that have mutate existing
		--userinfo # Admission Info including Roles, Cluster Roles and Subjects
		--username # Username for connecting to git repository
		--values-file # File containing values for policy variables
		--warn-exit-code # Set the exit code for warnings; if failures or errors are found, will exit 1
		--warn-no-pass @bool # Specify if warning exit code should be raised if no objects satisfied a policy; can be used together with --warn-exit-code flag
