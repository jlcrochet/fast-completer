		--addons @bool # Enable one or more addons, in a comma-separated format. See `minikube addons list` for a list of valid addon names.
		--apiserver-ips @bool # A set of apiserver IP Addresses which are used in the generated certificate for kubernetes.  This can be used if you want to make the apiserver available from outside the machine
		--apiserver-name @bool # The authoritative apiserver hostname for apiserver certificates and connectivity. This can be used if you want to make the apiserver available from outside the machine
		--apiserver-names @bool # A set of apiserver names which are used in the generated certificate for kubernetes.  This can be used if you want to make the apiserver available from outside the machine
		--apiserver-port @bool # The apiserver listening port
		--auto-pause-interval @bool # Duration of inactivity before the minikube VM is paused (default 1m0s)
		--auto-update-drivers @bool # If set, automatically updates drivers to the latest version. Defaults to true.
		--base-image @bool # The base image to use for docker/podman drivers. Intended for local development.
		--binary-mirror @bool # Location to fetch kubectl, kubelet, & kubeadm binaries from.
		--cache-images @bool # If true, cache docker images for the current bootstrapper and load them into the machine. Always false with --driver=none.
		--cert-expiration @bool # Duration until minikube certificate expiration, defaults to three years (26280h).
		--cni @bool # CNI plug-in to use. Valid options: auto, bridge, calico, cilium, flannel, kindnet, or path to a CNI manifest (default: auto)
		--container-runtime @bool # The container runtime to be used. Valid options: docker, cri-o, containerd (default: auto)
		--cpus @bool # Number of CPUs allocated to Kubernetes. Use "max" to use the maximum number of CPUs. Use "no-limit" to not specify a limit (Docker/Podman only)
		--cri-socket @bool # The cri socket path to be used.
		--delete-on-failure @bool # If set, delete the current cluster if start fails and try again. Defaults to false.
		--disable-coredns-log @bool # If set, disable CoreDNS verbose logging. Defaults to false.
		--disable-driver-mounts @bool # Disables the filesystem mounts provided by the hypervisors
		--disable-metrics @bool # If set, disables metrics reporting (CPU and memory usage), this can improve CPU usage. Defaults to false.
		--disable-optimizations @bool # If set, disables optimizations that are set for local Kubernetes. Including decreasing CoreDNS replicas from 2 to 1. Defaults to false.
		--disk-size @bool # Disk size allocated to the minikube VM (format: <number>[<unit>], where unit = b, k, m or g).
		--dns-domain @bool # The cluster dns domain name used in the Kubernetes cluster
		--dns-proxy @bool # Enable proxy for NAT DNS requests (virtualbox driver only)
		--docker-env @bool # Environment variables to pass to the Docker daemon. (format: key=value)
		--docker-opt @bool # Specify arbitrary flags to pass to the Docker daemon. (format: key=value)
		--download-only @bool # If true, only download and cache files for later use - don't install or start anything.
		--driver @bool # Driver is one of: virtualbox, kvm2, qemu2, qemu, vmware, none, docker, podman, ssh (defaults to auto-detect)
		--dry-run @bool # dry-run mode. Validates configuration, but does not mutate system state
		--embed-certs @bool # if true, will embed the certs in kubeconfig.
		--extra-config @bool # A set of key=value pairs that describe configuration that may be passed to different components.
		--extra-disks @bool # Number of extra disks created and attached to the minikube VM (currently only implemented for hyperkit, kvm2, qemu2, vfkit, and krunkit drivers)
		--feature-gates @bool # A set of key=value pairs that describe feature gates for alpha/experimental features.
		--force @bool # Force minikube to perform possibly dangerous operations
		--force-systemd @bool # If set, force the container runtime to use systemd as cgroup manager. Defaults to false.
		--gpus @bool # Allow pods to use your GPUs. Options include: [all,nvidia,amd] (Docker driver with Docker container-runtime only)
		--ha @bool # Create Highly Available Multi-Control Plane Cluster with a minimum of three control-plane nodes that will also be marked for work.
		--host-dns-resolver @bool # Enable host resolver for NAT DNS requests (virtualbox driver only)
		--host-only-cidr @bool # The CIDR to be used for the minikube VM (virtualbox driver only)
		--host-only-nic-type @bool # NIC Type used for host only network. One of Am79C970A, Am79C973, 82540EM, 82543GC, 82545EM, or virtio (virtualbox driver only)
		--hyperkit-vpnkit-sock @bool # Location of the VPNKit socket used for networking. If empty, disables Hyperkit VPNKitSock, if 'auto' uses Docker for Mac VPNKit connection, otherwise uses the specified VSock (hyperkit driver only)
		--hyperkit-vsock-ports @bool # List of guest VSock ports that should be exposed as sockets on the host (hyperkit driver only)
		--hyperv-external-adapter @bool # External Adapter on which external switch will be created if no external switch is found. (hyperv driver only)
		--hyperv-use-external-switch @bool # Whether to use external switch over Default Switch if virtual switch not explicitly specified. (hyperv driver only)
		--hyperv-virtual-switch @bool # The hyperv virtual switch name. Defaults to first found. (hyperv driver only)
		--image-mirror-country @bool # Country code of the image mirror to be used. Leave empty to use the global one. For Chinese mainland users, set it to cn.
		--image-repository @bool # Alternative image repository to pull docker images from. This can be used when you have limited access to gcr.io. Set it to "auto" to let minikube decide one for you. For Chinese mainland users, you may use local gcr.io mirrors such as registry.cn-hangzhou.aliyuncs.com/google_containers
		--insecure-registry @bool # Insecure Docker registries to pass to the Docker daemon.  The default service CIDR range will automatically be added.
		--install-addons @bool # If set, install addons. Defaults to true.
		--interactive @bool # Allow user prompts for more information
		--iso-url @bool # Locations to fetch the minikube ISO from.
		--keep-context @bool # This will keep the existing kubectl context and will create a minikube context.
		--kubernetes-version @bool # The Kubernetes version that the minikube VM will use (ex: v1.2.3, 'stable' for v1.35.0, 'latest' for v1.35.0). Defaults to 'stable'.
		--kvm-gpu @bool # Enable experimental NVIDIA GPU support in minikube
		--kvm-hidden @bool # Hide the hypervisor signature from the guest in minikube (kvm2 driver only)
		--kvm-network @bool # The KVM default network name. (kvm2 driver only)
		--kvm-numa-count @bool # Simulate numa node count in minikube, supported numa node count range is 1-8 (kvm2 driver only)
		--kvm-qemu-uri @bool # The KVM QEMU connection URI. (kvm2 driver only)
		--listen-address @bool # IP Address to use to expose ports (docker and podman driver only)
		--memory @bool # Amount of RAM to allocate to Kubernetes (format: <number>[<unit>], where unit = b, k, m or g). Use "max" to use the maximum amount of memory. Use "no-limit" to not specify a limit (Docker/Podman only)
		--mount @bool # Kept for backward compatibility, value is ignored.
		--mount-9p-version @bool # Specify the 9p version that the mount should use
		--mount-gid @bool # Default group id used for the mount
		--mount-ip @bool # Specify the ip that the mount should be setup on
		--mount-msize @bool # The number of bytes to use for 9p packet payload
		--mount-options @bool # Additional mount options, such as cache=fscache
		--mount-port @bool # Specify the port that the mount should be setup on, where 0 means any free port.
		--mount-string @bool # Directory to mount in the guest using format '/host-path:/guest-path'.
		--mount-type @bool # Specify the mount filesystem type (supported types: 9p)
		--mount-uid @bool # Default user id used for the mount
		--namespace @bool # The named space to activate after start
		--nat-nic-type @bool # NIC Type used for nat network. One of Am79C970A, Am79C973, 82540EM, 82543GC, 82545EM, or virtio (virtualbox driver only)
		--native-ssh @bool # Use native Golang SSH client (default true). Set to 'false' to use the command line 'ssh' command when accessing the docker machine. Useful for the machine drivers when they will not start with 'Waiting for SSH'.
		--network @bool # network to run minikube with. Used by docker/podman, qemu, kvm, and vfkit drivers. If left empty, minikube will create a new network.
		--nfs-share @bool # Local folders to share with Guest via NFS mounts (hyperkit driver only)
		--nfs-shares-root @bool # Where to root the NFS Shares, defaults to /nfsshares (hyperkit driver only)
		--no-kubernetes @bool # If set, minikube VM/container will start without starting or configuring Kubernetes. (only works on new clusters)
		--no-vtx-check @bool # Disable checking for the availability of hardware virtualization before the vm is started (virtualbox driver only)
		--nodes @bool # The total number of nodes to spin up. Defaults to 1.
		--output @bool # Format to print stdout in. Options include: [text,json]
		--ports @bool # List of ports that should be exposed (docker and podman driver only)
		--preload @bool # If set, download tarball of preloaded images if available to improve start time. Defaults to true.
		--preload-source @bool # Which source to download the preload from (valid options: gcs, github, auto). Defaults to auto (try both).
		--qemu-firmware-path @bool # Path to the qemu firmware file. Defaults: For Linux, the default firmware location. For macOS, the brew installation location. For Windows, C:\Program Files\qemu\share
		--registry-mirror @bool # Registry mirrors to pass to the Docker daemon
		--rosetta @bool # Enable Rosetta to support apps built for Intel processor on a Mac with Apple silicon (vfkit driver only)
		--service-cluster-ip-range @bool # The CIDR to be used for service cluster IPs.
		--socket-vmnet-client-path @bool # Path to the socket vmnet client binary (QEMU driver only)
		--socket-vmnet-path @bool # Path to socket vmnet binary (QEMU driver only)
		--ssh-ip-address @bool # IP address (ssh driver only)
		--ssh-key @bool # SSH key (ssh driver only)
		--ssh-port @bool # SSH port (ssh driver only)
		--ssh-user @bool # SSH user (ssh driver only)
		--static-ip @bool # Set a static IP for the minikube cluster, the IP must be: private, IPv4, and the last octet must be between 2 and 254, for example 192.168.200.200 (Docker and Podman drivers only)
		--subnet @bool # Subnet to be used on kic cluster. If left empty, minikube will choose subnet address, beginning from 192.168.49.0. (docker and podman driver only)
		--trace @bool # Send trace events. Options include: [gcp]
		--uuid @bool # Provide VM UUID to restore MAC address (hyperkit driver only)
		--vm @bool # Filter to use only VM Drivers
		--wait @bool # comma separated list of Kubernetes components to verify and wait for after starting a cluster. defaults to "apiserver,system_pods", available options: "apiserver,system_pods,default_sa,apps_running,node_ready,kubelet,extra" . other acceptable values are 'all' or 'none', 'true' and 'false'
		--wait-timeout @bool # max time to wait per Kubernetes or host to be healthy.
	status # Gets the status of a local Kubernetes cluster
		--add_dir_header @bool # If true, adds the file directory to the header of the log messages
		--bootstrapper @bool # The name of the cluster bootstrapper that will set up the Kubernetes cluster.
		--log_backtrace_at @bool # when logging hits line file:N, emit a stack trace
		--log_dir @bool # If non-empty, write log files in this directory (no effect when -logtostderr=true)
		--log_file_max_size @bool # Defines the maximum size a log file can grow to (no effect when -logtostderr=true). Unit is megabytes. If the value is 0, the maximum file size is unlimited.
		--one_output @bool # If true, only write logs to their native severity level (vs also writing to each lower severity level; no effect when -logtostderr=true)
		--profile @bool # The name of the minikube VM being used. This can be set to allow having multiple instances of minikube independently.
		--rootless @bool # Force to use rootless driver (docker and podman driver only)
		--skip-audit @bool # Skip recording the current command in the audit logs.
		--skip_headers @bool # If true, avoid header prefixes in the log messages
		--skip_log_headers @bool # If true, avoid headers when opening log files (no effect when -logtostderr=true)
		--stderrthreshold @bool # logs at or above this threshold go to stderr when writing to files and stderr (no effect when -logtostderr=true or -alsologtostderr=true)
		--user @bool # Specifies the user executing the operation. Useful for auditing operations executed by 3rd party tools. Defaults to the operating system username.
		--v @bool # number for the log level verbosity
		--vmodule @bool # comma-separated list of pattern=N settings for file-filtered logging
		--format @bool # Go template format string for the status output.  The format for Go templates can be found here: https://pkg.go.dev/text/template
		--layout @bool # output layout (EXPERIMENTAL, JSON only): 'nodes' or 'cluster'
		--node @bool # The node to check status for. Defaults to control plane. Leave blank with default format for status on all nodes.
		--output @bool # minikube status --output OUTPUT. json, text
		--watch @bool # Continuously listing/getting the status with optional interval duration.
