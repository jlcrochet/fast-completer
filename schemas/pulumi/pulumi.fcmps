		--suppress-permalink # Suppress display of the state permalink
		--suppress-progress @bool # Suppress display of periodic progress dots
		--target # Specify a single resource URN to refresh. Multiple resource can be specified using: --target urn1 --target urn2
		--target-dependents @bool # Allows updating of dependent targets discovered but not specified in --target list
		--yes @bool # Automatically approve and perform the refresh after previewing it
