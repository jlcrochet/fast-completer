		--parallel # Allow P resource operations to run in parallel at once (1 for no parallelism).
		--preview-only @bool # Only show a preview of the refresh, but don't perform the refresh itself
		--run-program @bool # Run the program to determine up-to-date state for providers to refresh resources
		--show-replacement-steps @bool # Show detailed resource replacement creates and deletes instead of a single step
		--show-sames @bool # Show resources that needn't be updated because they haven't changed, alongside those that do
		--skip-pending-creates @bool # Skip importing pending creates in interactive mode
		--skip-preview @bool # Do not calculate a preview before performing the refresh
