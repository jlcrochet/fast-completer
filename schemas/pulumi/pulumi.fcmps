	destroy # Destroy all existing resources in the stack
		--color # Colorize output. Choices are: always, never, raw, auto
		--cwd # Run pulumi as if it had been started in another directory
		--disable-integrity-checking @bool # Disable integrity checking of checkpoint files
		--emoji @bool # Enable emojis in the output
		--fully-qualify-stack-names @bool # Show fully-qualified stack names
		--logflow @bool # Flow log settings to child processes (like plugins)
		--logtostderr @bool # Log to stderr instead of to files
		--memprofilerate # Enable more precise (and expensive) memory allocation profiles by setting runtime.MemProfileRate
		--non-interactive @bool # Disable interactive mode for all commands
		--profiling # Emit CPU and memory profiles and an execution trace to '[filename].[pid].{cpu,mem,trace}', respectively
		--tracing # Emit tracing to the specified endpoint. Use the `file:` scheme to write tracing data to a local file
		--verbose # Enable verbose logging (e.g., v=3); anything >3 is very verbose
		--config # Config to use during the destroy and save to the stack config file
		--config-file # Use the configuration values in the specified file rather than detecting the file name
		--config-path @bool # Config keys contain a path to a property in a map or list to set
		--continue-on-error @bool # Continue to perform the destroy operation despite the occurrence of errors (can also be set with PULUMI_CONTINUE_ON_ERROR env var)
		--debug @bool # Print detailed debugging output during resource operations
		--diff @bool # Display operation as a rich diff showing the overall change
		--exclude # Specify a resource URN to ignore. These resources will not be updated. Multiple resources can be specified using --exclude urn1 --exclude urn2. Wildcards (*, **) are also supported
		--exclude-protected @bool # Do not destroy protected resources. Destroy all other resources.
		--json @bool # Serialize the destroy diffs, operations, and overall output as JSON
		--message # Optional message to associate with the destroy operation
		--neo @bool # Enable Pulumi Neo's assistance for improved CLI experience and insights (can also be set with PULUMI_NEO environment variable)
		--parallel # Allow P resource operations to run in parallel at once (1 for no parallelism).
		--preview-only @bool # Only show a preview of the destroy, but don't perform the destroy itself
		--refresh # Refresh the state of the stack's resources before this update
		--remove @bool # Remove the stack and its config file after all resources in the stack have been deleted
		--run-program @bool # Run the program to determine up-to-date state for providers to destroy resources
		--show-config @bool # Show configuration keys and variables
		--show-full-output @bool # Display full length of inputs & outputs
		--show-replacement-steps @bool # Show detailed resource replacement creates and deletes instead of a single step
		--show-sames @bool # Show resources that don't need to be updated because they haven't changed, alongside those that do
		--skip-preview @bool # Do not calculate a preview before performing the destroy
		--stack # The name of the stack to operate on. Defaults to the current stack
		--suppress-outputs @bool # Suppress display of stack outputs (in case they contain sensitive values)
		--suppress-permalink # Suppress display of the state permalink
		--suppress-progress @bool # Suppress display of periodic progress dots
		--target # Specify a single resource URN to destroy. All resources necessary to destroy this target will also be destroyed. Multiple resources can be specified using: --target urn1 --target urn2. Wildcards (*, **) are also supported
		--target-dependents @bool # Allows destroying of dependent targets discovered but not specified in --target list
		--yes @bool # Automatically approve and perform the destroy after previewing it
