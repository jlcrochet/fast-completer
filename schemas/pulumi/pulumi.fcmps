	up # Create or update the resources in a stack
		--color # Colorize output. Choices are: always, never, raw, auto
		--cwd # Run pulumi as if it had been started in another directory
		--disable-integrity-checking @bool # Disable integrity checking of checkpoint files
		--emoji @bool # Enable emojis in the output
		--fully-qualify-stack-names @bool # Show fully-qualified stack names
		--logflow @bool # Flow log settings to child processes (like plugins)
		--logtostderr @bool # Log to stderr instead of to files
		--memprofilerate # Enable more precise (and expensive) memory allocation profiles by setting runtime.MemProfileRate
		--non-interactive @bool # Disable interactive mode for all commands
		--profiling # Emit CPU and memory profiles and an execution trace to '[filename].[pid].{cpu,mem,trace}', respectively
		--tracing # Emit tracing to the specified endpoint. Use the `file:` scheme to write tracing data to a local file
		--verbose # Enable verbose logging (e.g., v=3); anything >3 is very verbose
		--attach-debugger # Enable the ability to attach a debugger to the program and source based plugins being executed. Can limit debug type to 'program', 'plugins', 'plugin:<name>' or 'all'.
		--config # Config to use during the update and save to the stack config file
		--config-file # Use the configuration values in the specified file rather than detecting the file name
		--config-path @bool # Config keys contain a path to a property in a map or list to set
		--continue-on-error @bool # Continue updating resources even if an error is encountered (can also be set with PULUMI_CONTINUE_ON_ERROR environment variable)
		--debug @bool # Print detailed debugging output during resource operations
		--diff @bool # Display operation as a rich diff showing the overall change
		--exclude # Specify a resource URN to ignore. These resources will not be updated. Multiple resources can be specified using --exclude urn1 --exclude urn2. Wildcards (*, **) are also supported
		--exclude-dependents @bool # Allows ignoring of dependent targets discovered but not specified in --exclude list
		--expect-no-changes @bool # Return an error if any changes occur during this update. This check happens after the update is applied
		--json @bool # Serialize the update diffs, operations, and overall output as JSON
		--message # Optional message to associate with the update operation
		--neo @bool # Enable Pulumi Neo's assistance for improved CLI experience and insights (can also be set with PULUMI_NEO environment variable)
		--parallel # Allow P resource operations to run in parallel at once (1 for no parallelism).
		--policy-pack # Run one or more policy packs as part of this update
		--policy-pack-config # Path to JSON file containing the config for the policy pack of the corresponding "--policy-pack" flag
		--refresh # Refresh the state of the stack's resources before this update
		--replace # Specify a single resource URN to replace. Multiple resources can be specified using --replace urn1 --replace urn2. Wildcards (*, **) are also supported
		--run-program @bool # Run the program to determine up-to-date state for providers to refresh resources, this only applies if --refresh is set
		--secrets-provider # The type of the provider that should be used to encrypt and decrypt secrets (possible choices: default, passphrase, awskms, azurekeyvault, gcpkms, hashivault). Only used when creating a new stack from an existing template
		--show-config @bool # Show configuration keys and variables
		--show-full-output @bool # Display full length of inputs & outputs
		--show-policy-remediations @bool # Show per-resource policy remediation details instead of a summary
		--show-reads @bool # Show resources that are being read in, alongside those being managed directly in the stack
		--show-replacement-steps @bool # Show detailed resource replacement creates and deletes instead of a single step
		--show-sames @bool # Show resources that don't need be updated because they haven't changed, alongside those that do
		--show-secrets @bool # Show secret outputs in the CLI output
		--skip-preview @bool # Do not calculate a preview before performing the update
		--stack # The name of the stack to operate on. Defaults to the current stack
		--strict @bool # [EXPERIMENTAL] Enable strict plan behavior: generate a plan during preview and constrain the update to that plan (opt-in). Cannot be used with --skip-preview.
		--suppress-outputs @bool # Suppress display of stack outputs (in case they contain sensitive values)
		--suppress-permalink # Suppress display of the state permalink
		--suppress-progress @bool # Suppress display of periodic progress dots
		--target # Specify a single resource URN to update. Other resources will not be updated. Multiple resources can be specified using --target urn1 --target urn2. Wildcards (*, **) are also supported
		--target-dependents @bool # Allows updating of dependent targets discovered but not specified in --target list
		--target-replace # Specify a single resource URN to replace. Other resources will not be updated. Shorthand for --target urn --replace urn.
		--yes @bool # Automatically approve and perform the update after previewing it
