		--yes|-y @bool # Answer yes to all confirmation prompts
		--raw @bool # Read/write directly to stdin/stdout/stderr instead of by line
		--locked @bool # Require lockfile URLs to be present during installation
		--silent @bool # Suppress all task output and mise non-error messages
