# Bun CLI schema for fast-completer
# Generated from bun 1.3.9

bun # Fast JavaScript runtime, package manager, and bundler
	--watch @bool # Automatically restart the process on file change
	--hot @bool # Enable auto reload in the Bun runtime, test runner, or bundler
	--no-clear-screen @bool # Disable clearing the terminal screen on reload when --hot or --watch is enabled
	--smol @bool # Use less memory, but run garbage collection more often
	--preload|-r # Import a module before other modules are loaded
	--require # Alias of --preload, for Node.js compatibility
	--import # Alias of --preload, for Node.js compatibility
	--inspect # Activate Bun's debugger
	--inspect-wait # Activate Bun's debugger, wait for a connection before executing
	--inspect-brk # Activate Bun's debugger, set breakpoint on first line of code and wait
	--cpu-prof @bool # Start CPU profiler and write profile to disk on exit
	--cpu-prof-name # Specify the name of the CPU profile file
	--cpu-prof-dir # Specify the directory where the CPU profile will be saved
	--cpu-prof-md @bool # Output CPU profile in markdown format (grep-friendly, designed for LLM analysis)
	--cpu-prof-interval # Specify the sampling interval in microseconds for CPU profiling (default: 1000)
	--heap-prof @bool # Generate V8 heap snapshot on exit (.heapsnapshot)
	--heap-prof-name # Specify the name of the heap profile file
	--heap-prof-dir # Specify the directory where the heap profile will be saved
	--heap-prof-md @bool # Generate markdown heap profile on exit (for CLI analysis)
	--if-present @bool # Exit without an error if the entrypoint does not exist
	--no-install @bool # Disable auto install in the Bun runtime
	--install # Configure auto-install behavior. One of "auto" (default, auto-installs when no node_modules), "fallback" (missing packages only), "force" (always).
	--eval|-e # Evaluate argument as a script
	--print|-p # Evaluate argument as a script and print the result
	--prefer-offline @bool # Skip staleness checks for packages in the Bun runtime and resolve from disk
	--prefer-latest @bool # Use the latest matching versions of packages in the Bun runtime, always checking npm
	--port # Set the default port for Bun.serve
	--conditions # Pass custom conditions to resolve
	--fetch-preconnect # Preconnect to a URL while code is loading
	--max-http-header-size # Set the maximum size of HTTP headers in bytes. Default is 16KiB
	--dns-result-order # Set the default order of DNS lookup results. Valid orders: verbatim (default), ipv4first, ipv6first
	--expose-gc @bool # Expose gc() on the global object. Has no effect on Bun.gc().
	--no-deprecation @bool # Suppress all reporting of the custom deprecation.
	--throw-deprecation @bool # Determine whether or not deprecation warnings result in errors.
	--title # Set the process title
	--zero-fill-buffers @bool # Boolean to force Buffer.allocUnsafe(size) to be zero-filled.
	--use-system-ca @bool # Use the system's trusted certificate authorities
	--use-openssl-ca @bool # Use OpenSSL's default CA store
	--use-bundled-ca @bool # Use bundled CA store
	--redis-preconnect @bool # Preconnect to $REDIS_URL at startup
	--sql-preconnect @bool # Preconnect to PostgreSQL at startup
	--no-addons @bool # Throw an error if process.dlopen is called, and disable export condition "node-addons"
	--unhandled-rejections # One of "strict", "throw", "warn", "none", or "warn-with-error-code"
	--console-depth # Set the default depth for console.log object inspection (default: 2)
	--user-agent # Set the default User-Agent header for HTTP requests
	--silent @bool # Don't print the script command
	--elide-lines # Number of lines of script output shown when using --filter (default: 10). Set to 0 to show all lines.
	--revision @bool # Print version with revision and exit
	--filter|-F # Run a script in all workspace packages matching the pattern
	--bun|-b @bool # Force a script or package to use Bun's runtime instead of Node.js (via symlinking node)
	--shell # Control the shell used for package.json scripts. Supports either 'bun' or 'system'
	--workspaces @bool # Run a script in all workspace packages (from the "workspaces" field in package.json)
	--parallel @bool # Run multiple scripts concurrently with Foreman-style output
	--sequential @bool # Run multiple scripts sequentially with Foreman-style output
	--no-exit-on-error @bool # Continue running other scripts when one fails (with --parallel/--sequential)
	--env-file # Load environment variables from the specified file(s)
	--no-env-file @bool # Disable automatic loading of .env files
	--cwd # Absolute path to resolve files & entry points from. This just changes the process' cwd.
	--config|-c # Specify path to Bun config file. Default $cwd/bunfig.toml
	add # lyra                 Add a dependency to package.json (bun a)
		--config|-c # Specify path to config file (bunfig.toml)
		--yarn|-y @bool # Write a yarn.lock file (yarn v1)
		--production|-p @bool # Don't install devDependencies
		--no-save @bool # Don't update package.json or save a lockfile
		--save @bool # Save to package.json (true by default)
		--ca # Provide a Certificate Authority signing certificate
		--cafile # The same as `--ca`, but is a file path to the certificate
		--dry-run @bool # Perform a dry run without making changes
		--frozen-lockfile @bool # Disallow changes to lockfile
		--force|-f @bool # Always request the latest versions from the registry & reinstall all dependencies
		--cache-dir # Store & load cached data from a specific directory path
		--no-cache @bool # Ignore manifest cache entirely
		--silent @bool # Don't log anything
		--quiet @bool # Only show tarball name when packing
		--verbose @bool # Excessively verbose logging
		--no-progress @bool # Disable the progress bar
		--no-summary @bool # Don't print a summary
		--no-verify @bool # Skip verifying integrity of newly downloaded packages
		--ignore-scripts @bool # Skip lifecycle scripts in the project's package.json (dependency scripts are never run)
		--trust @bool # Add to trustedDependencies in the project's package.json and install the package(s)
		--global|-g @bool # Install globally
		--cwd # Set a specific cwd
		--backend # Platform-specific optimizations for installing dependencies. Possible values: "hardlink" (default), "symlink", "copyfile"
		--registry # Use a specific registry by default, overriding .npmrc, bunfig.toml and environment variables
		--concurrent-scripts # Maximum number of concurrent jobs for lifecycle scripts (default 5)
		--network-concurrency # Maximum number of concurrent network requests (default 48)
		--save-text-lockfile @bool # Save a text-based lockfile
		--omit # Exclude 'dev', 'optional', or 'peer' dependencies from install
		--lockfile-only @bool # Generate a lockfile without installing dependencies
		--linker # Linker strategy (one of "isolated" or "hoisted")
		--minimum-release-age # Only install packages published at least N seconds ago (security feature)
		--cpu # Override CPU architecture for optional dependencies (e.g., x64, arm64, * for all)
		--os # Override operating system for optional dependencies (e.g., linux, darwin, * for all)
		--dev|-d @bool # Add dependency to "devDependencies"
		--optional @bool # Add dependency to "optionalDependencies"
		--peer @bool # Add dependency to "peerDependencies"
		--exact|-E @bool # Add the exact version instead of the ^range
		--analyze|-a @bool # Recursively analyze & install dependencies of files passed as arguments (using Bun's bundler)
		--only-missing @bool # Only add dependencies to package.json if they are not already present
	audit # Check installed packages for vulnerabilities
		--json @bool # Output in JSON format
		--audit-level # Only print advisories with severity greater than or equal to <level> (low, moderate, high, critical)
		--ignore # Ignore specific CVE IDs from audit
	build # ./a.ts ./b.jsx       Bundle TypeScript & JavaScript into a single file
		--production @bool # Set NODE_ENV=production and enable minification
		--compile @bool # Generate a standalone Bun executable containing your bundled code. Implies --production
		--compile-exec-argv # Prepend arguments to the standalone executable's execArgv
		--compile-autoload-dotenv @bool # Enable autoloading of .env files in standalone executable (default: true)
		--no-compile-autoload-dotenv @bool # Disable autoloading of .env files in standalone executable
		--compile-autoload-bunfig @bool # Enable autoloading of bunfig.toml in standalone executable (default: true)
		--no-compile-autoload-bunfig @bool # Disable autoloading of bunfig.toml in standalone executable
		--compile-autoload-tsconfig @bool # Enable autoloading of tsconfig.json at runtime in standalone executable (default: false)
		--no-compile-autoload-tsconfig @bool # Disable autoloading of tsconfig.json at runtime in standalone executable
		--compile-autoload-package-json @bool # Enable autoloading of package.json at runtime in standalone executable (default: false)
		--no-compile-autoload-package-json @bool # Disable autoloading of package.json at runtime in standalone executable
		--compile-executable-path # Path to a Bun executable to use for cross-compilation instead of downloading
		--bytecode @bool # Use a bytecode cache
		--watch @bool # Automatically restart the process on file change
		--no-clear-screen @bool # Disable clearing the terminal screen on reload when --watch is enabled
		--target # The intended execution environment for the bundle. "browser", "bun" or "node"
		--outdir # Default to "dist" if multiple files
		--outfile # Write to a file
		--metafile # Write a JSON file with metadata about the build
		--metafile-md # Write a markdown file with a visualization of the module graph (LLM-friendly)
		--sourcemap # Build with sourcemaps - 'linked', 'inline', 'external', or 'none'
		--banner # Add a banner to the bundled output such as "use client"; for a bundle being used with RSCs
		--footer # Add a footer to the bundled output such as // built with bun!
		--format # Specifies the module format to build to. "esm", "cjs" and "iife" are supported. Defaults to "esm", or "cjs" with --bytecode.
		--root # Root directory used for multiple entry points
		--splitting @bool # Enable code splitting
		--public-path # A prefix to be appended to any import paths in bundled code
		--external|-e # Exclude module from transpilation (can use * wildcards). ex: -e react
		--packages # Add dependencies to bundle or keep them external. "external", "bundle" is supported. Defaults to "bundle".
		--entry-naming # Customize entry point filenames. Defaults to "[dir]/[name].[ext]"
		--chunk-naming # Customize chunk filenames. Defaults to "[name]-[hash].[ext]"
		--asset-naming # Customize asset filenames. Defaults to "[name]-[hash].[ext]"
		--react-fast-refresh @bool # Enable React Fast Refresh transform (does not emit hot-module code, use this for testing)
		--no-bundle @bool # Transpile file only, do not bundle
		--emit-dce-annotations @bool # Re-emit DCE annotations in bundles. Enabled by default unless --minify-whitespace is passed.
		--minify @bool # Enable all minification flags
		--minify-syntax @bool # Minify syntax and inline data
		--minify-whitespace @bool # Minify whitespace
		--minify-identifiers @bool # Minify identifiers
		--keep-names @bool # Preserve original function and class names when minifying
		--css-chunking @bool # Chunk CSS files together to reduce duplicated CSS loaded in a browser. Only has an effect when multiple entrypoints import CSS
		--conditions # Pass custom conditions to resolve
		--app @bool # (EXPERIMENTAL) Build a web app for production using Bun Bake.
		--server-components @bool # (EXPERIMENTAL) Enable server components
		--env # Inline environment variables into the bundle as process.env.${name}. Defaults to 'disable'. To inline environment variables matching a prefix, use my prefix like 'FOO_PUBLIC_*'.
		--windows-hide-console @bool # When using --compile targeting Windows, prevent a Command prompt from opening alongside the executable
		--windows-icon # When using --compile targeting Windows, assign an executable icon
		--windows-title # When using --compile targeting Windows, set the executable product name
		--windows-publisher # When using --compile targeting Windows, set the executable company name
		--windows-version # When using --compile targeting Windows, set the executable version (e.g. 1.2.3.4)
		--windows-description # When using --compile targeting Windows, set the executable description
		--windows-copyright # When using --compile targeting Windows, set the executable copyright
