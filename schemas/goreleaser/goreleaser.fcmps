	init # Generates a .goreleaser.yaml file
		--verbose @bool # Enable verbose mode
		--config @bool # Load configuration from file
		--language @bool # Which language will be used
	jsonschema # Outputs goreleaser's JSON schema
		--verbose @bool # Enable verbose mode
		--output @bool # Where to save the JSONSchema file
	release # Releases the current project
		--verbose @bool # Enable verbose mode
		--auto-snapshot @bool # Automatically sets --snapshot if the repository is dirty
		--clean @bool # Removes the 'dist' directory
		--config @bool # Load configuration from file
		--draft @bool # Whether to set the release to draft. Overrides release.draft in the configuration file
		--fail-fast @bool # Whether to abort the release publishing on the first error
		--parallelism @bool # Amount tasks to run concurrently (default: number of CPUs)
		--release-footer @bool # Load custom release notes footer from a markdown file
		--release-footer-tmpl @bool # Load custom release notes footer from a templated markdown file (overrides --release-footer)
		--release-header @bool # Load custom release notes header from a markdown file
		--release-header-tmpl @bool # Load custom release notes header from a templated markdown file (overrides --release-header)
		--release-notes @bool # Load custom release notes from a markdown file (will skip GoReleaser changelog generation)
		--release-notes-tmpl @bool # Load custom release notes from a templated markdown file (overrides --release-notes)
		--skip @bool # Skip the given options (valid options are announce, archive, aur, aur-source, before, chocolatey, docker, homebrew, ko, makeself, mcp, nfpm, nix, notarize, publish, sbom, scoop, sign, snapcraft, validate, winget)
		--snapshot @bool # Generate an unversioned snapshot release, skipping all validations and without publishing any artifacts (implies --skip=announce,publish,validate)
		--timeout @bool # Timeout to the entire release process
