	build # Builds the current project
		--verbose @bool # Enable verbose mode
		--auto-snapshot @bool # Automatically sets --snapshot if the repository is dirty
		--clean @bool # Removes the 'dist' directory before building
		--config @bool # Load configuration from file
		--id @bool # Builds only the specified build ids
		--output @bool # Copy the binary to the path after the build. Only taken into account when using --single-target and a single id (either with --id or if configuration only has one build)
		--parallelism @bool # Number of tasks to run concurrently (default: number of CPUs)
		--single-target @bool # Builds only for current GOOS and GOARCH, regardless of what's set in the configuration file
		--skip @bool # Skip the given options (valid options are: before, post-hooks, pre-hooks, validate)
		--snapshot @bool # Generate an unversioned snapshot build, skipping all validations
		--timeout @bool # Timeout to the entire build process
