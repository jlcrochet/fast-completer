			--output @bool # Format output as: text, json. text provides a readable table, json outputs the tokens with metadata.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--user @bool # List personal access tokens. Use @me for the current user.
