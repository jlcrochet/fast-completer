			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--scope @bool # Scopes for the token. Multiple scopes can be comma-separated or specified by repeating the flag. For a list, see https://docs.gitlab.com/user/profile/personal_access_tokens/#personal-access-token-scopes.
			--user @bool # Create a personal access token. For the current user, use @me.
		list # List user, group, or project access tokens.
			--active @bool # List only the active tokens.
