			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--user @bool # Revoke personal access token. Use @me for the current user.
		rotate # Rotate user, group, or project access tokens
			--duration @bool # Sets the token lifetime in days. Accepts: days (30d), weeks (4w), or hours in multiples of 24 (24h, 168h, 720h). Maximum: 365d. The token expires at midnight UTC on the calculated date.
			--expires-at @bool # Sets the token's expiration date and time, in YYYY-MM-DD format. If not specified, --duration is used.
			--group @bool # Rotate group access token. Ignored if a user or repository argument is set.
			--output @bool # Format output as: text, json. 'text' provides the new token value; 'json' outputs the token with metadata.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--user @bool # Rotate personal access token. Use @me for the current user.
