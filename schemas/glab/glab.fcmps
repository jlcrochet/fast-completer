# Generated from glab 1.85.3

glab # GitLab CLI
	--help @bool # Show help for this command.
	--version @bool # show glab version information
	alias # Create, list, and delete aliases.
		delete # Delete an alias.
		list # List the available aliases.
		set # Set an alias for a longer command.
			--shell @bool # Declare an alias to be passed through a shell interpreter.
	api # Make an authenticated request to the GitLab API.
		--field @bool # Add a parameter of inferred type. Changes the default HTTP method to "POST".
		--header @bool # Add an additional HTTP request header.
		--hostname @bool # The GitLab hostname for the request. Defaults to 'gitlab.com', or the authenticated host in the current Git directory.
		--include @bool # Include HTTP response headers in the output.
		--input @bool # The file to use as the body for the HTTP request.
		--method @bool # The HTTP method for the request.
		--output @bool # Format output as: json, ndjson.
		--paginate @bool # Make additional HTTP requests to fetch all pages of results.
		--raw-field @bool # Add a string parameter.
		--silent @bool # Do not print the response body.
	attestation # Manage software attestations. (EXPERIMENTAL)
		verify # Verify the provenance of a specific artifact or file. (EXPERIMENTAL)
	auth # Manage glab's authentication state.
		configure-docker # Register glab as a Docker credential helper
		docker-helper # A Docker credential helper for GitLab container registries
			erase
			get
			store
		dpop-gen # Generates a DPoP (demonstrating-proof-of-possession) proof JWT. (EXPERIMENTAL)
			--private-key @bool # Location of the private SSH key on the local system.
		login # Authenticate with a GitLab instance.
			--api-host @bool # API host url.
			--api-protocol @bool # API protocol: https, http
			--git-protocol @bool # Git protocol: ssh, https, http
			--hostname @bool # The hostname of the GitLab instance to authenticate with.
			--job-token @bool # CI job token.
			--stdin @bool # Read token from standard input.
			--token @bool # Your GitLab access token.
			--use-keyring @bool # Store token in your operating system's keyring.
		logout # Logout from a GitLab instance.
			--hostname @bool # The hostname of the GitLab instance.
		status # View authentication status.
			--all @bool # Check all configured instances.
			--hostname @bool # Check a specific instance's authentication status.
			--show-token @bool # Display the authentication token.
	changelog # Interact with the changelog API.
		generate # Generate a changelog for the repository or project.
			--config-file @bool # Path of the changelog configuration file in the project's Git repository. Defaults to '.gitlab/changelog_config.yml'.
			--date @bool # Date and time of the release. Uses ISO 8601 (`2016-03-11T03:45:40Z`) format. Defaults to the current time.
			--from @bool # Start of the range of commits (as a SHA) to use when generating the changelog. This commit itself isn't included in the list.
			--to @bool # End of the range of commits (as a SHA) to use when generating the changelog. This commit is included in the list. Defaults to the HEAD of the project's default branch.
			--trailer @bool # The Git trailer to use for including commits. Defaults to 'Changelog'.
	check-update # Check for latest glab releases.
	ci # Work with GitLab CI/CD pipelines and jobs.
		--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
		cancel # Cancel a running pipeline or job.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			job # Cancel CI/CD jobs.
				--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
				--dry-run @bool # Simulates process, but does not cancel anything.
			pipeline # Cancel CI/CD pipelines.
				--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
				--dry-run @bool # Simulates process, but does not cancel anything.
		config # Work with GitLab CI/CD configuration.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			compile # View the fully expanded CI/CD configuration.
				--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
		delete # Delete CI/CD pipelines.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--dry-run @bool # Simulate process, but do not delete anything.
			--older-than @bool # Filter pipelines older than the given duration. Valid units: h, m, s, ms, us, ns.
			--page @bool # Page number.
			--paginate @bool # Make additional HTTP requests to fetch all pages of projects before cloning. Respects '--per-page'.
			--per-page @bool # Number of items to list per page.
			--source @bool # Filter pipelines by source: api, chat, external, external_pull_request_event, merge_request_event, ondemand_dast_scan, ondemand_dast_validation, parent_pipeline, pipeline, push, schedule, security_orchestration_policy, trigger, web, webide.
			--status @bool # Delete pipelines by status: running, pending, success, failed, canceled, skipped, created, manual.
		get # Get JSON of a running CI/CD pipeline on the current or other specified branch.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--branch @bool # Check pipeline status for a branch. (default current branch)
			--output @bool # Format output. Options: text, json.
			--pipeline-id @bool # Provide pipeline ID.
			--with-job-details @bool # Show extended job information.
			--with-variables @bool # Show variables in pipeline. Requires the Maintainer role.
		lint # Checks if your `.gitlab-ci.yml` file is valid.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--dry-run @bool # Run pipeline creation simulation.
			--include-jobs @bool # Response includes the list of jobs that would exist in a static check or pipeline simulation.
			--ref @bool # When 'dry-run' is true, sets the branch or tag context for validating the CI/CD YAML configuration.
		list # Get the list of CI/CD pipelines.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--name @bool # Return only pipelines with the given name.
			--order @bool # Order pipelines by this field. Options: id, status, ref, updated_at, user_id.
			--output @bool # Format output. Options: text, json.
			--page @bool # Page number.
			--per-page @bool # Number of items to list per page.
			--ref @bool # Return only pipelines for given ref.
			--scope @bool # Return only pipelines with the given scope: {running|pending|finished|branches|tags}
			--sha @bool # Return only pipelines with the given SHA.
			--sort @bool # Sort direction for --order field: asc or desc.
			--source @bool # Return only pipelines triggered via the given source. See https://docs.gitlab.com/ci/jobs/job_rules/#ci_pipeline_source-predefined-variable for full list. Commonly used options: {merge_request_event|parent_pipeline|pipeline|push|trigger}
			--status @bool # Get pipeline with this status. Options: running, pending, success, failed, canceled, skipped, created, manual, waiting_for_resource, preparing, scheduled
			--updated-after @bool # Return only pipelines updated after the specified date. Expected in ISO 8601 format (2019-03-15T08:00:00Z).
			--updated-before @bool # Return only pipelines updated before the specified date. Expected in ISO 8601 format (2019-03-15T08:00:00Z).
			--username @bool # Return only pipelines triggered by the given username.
			--yaml-errors @bool # Return only pipelines with invalid configurations.
		retry # Retry a CI/CD job.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--branch @bool # The branch to search for the job. (default current branch)
			--pipeline-id @bool # The pipeline ID to search for the job.
		run # Create or run a new CI/CD pipeline.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--branch @bool # Create pipeline on branch/ref <string>.
			--input @bool # Pass inputs to pipeline in format '<key>:<value>'. Cannot be used for merge request pipelines. See documentation for examples.
			--mr @bool # Run merge request pipeline instead of branch pipeline.
			--variables @bool # Pass variables to pipeline in format <key>:<value>. Cannot be used for MR pipelines.
			--variables-env @bool # Pass variables to pipeline in format <key>:<value>. Cannot be used for MR pipelines.
			--variables-file @bool # Pass file contents as a file variable to pipeline in format <key>:<filename>. Cannot be used for MR pipelines.
			--variables-from @bool # JSON file with variables for pipeline execution. Expects array of hashes, each with at least 'key' and 'value'. Cannot be used for MR pipelines.
			--web @bool # Open pipeline in a browser. Uses default browser, or browser specified in BROWSER environment variable.
		run-trig # Run a CI/CD pipeline trigger.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--branch @bool # Create pipeline on branch or reference <string>.
			--input @bool # Pass inputs to pipeline in format '<key>:<value>'. Cannot be used for merge request pipelines. See documentation for examples.
			--token @bool # Pipeline trigger token. Can be omitted only if the `CI_JOB_TOKEN` environment variable is set.
			--variables @bool # Pass variables to pipeline in the format <key>:<value>. Multiple variables can be comma-separated or specified by repeating the flag.
		status # View a running CI/CD pipeline on current or other branch specified.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--branch @bool # Check pipeline status for a branch. (default current branch)
			--compact @bool # Show status in compact format.
			--live @bool # Show status in real time until the pipeline ends.
		trace # Trace a CI/CD job log in real time.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--branch @bool # The branch to search for the job. (default current branch)
			--pipeline-id @bool # The pipeline ID to search for the job.
		trigger # Trigger a manual CI/CD job.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--branch @bool # The branch to search for the job. (default current branch)
			--pipeline-id @bool # The pipeline ID to search for the job.
		view # View, run, trace, log, and cancel CI/CD job's current pipeline.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			--branch @bool # Check pipeline status for a branch or tag. Defaults to the current branch.
			--pipelineid @bool # Check pipeline status for a specific pipeline ID.
			--web @bool # Open pipeline in a browser. Uses default browser, or browser specified in BROWSER variable.
	cluster # Manage GitLab Agents for Kubernetes and their clusters.
		--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
		agent # Manage GitLab Agents for Kubernetes.
			--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			bootstrap # Bootstrap a GitLab Agent for Kubernetes in a project.
				--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
				--commit-author-email @bool # The Git commit author email to use. Conflicts with the --use-api-commit-author flag.
				--commit-author-name @bool # The Git commit author name to use. Conflicts with the --use-api-commit-author flag.
				--create-environment @bool # Create an environment for the GitLab Agent.
				--create-flux-environment @bool # Create an environment for FluxCD. Affects only the environment creation, not the use of Flux itself. Flux is always required for the bootstrap process.
				--environment-flux-resource-path @bool # Flux resource path of the environment for the GitLab Agent.
				--environment-name @bool # Name of the environment for the GitLab Agent.
				--environment-namespace @bool # Kubernetes namespace of the environment for the GitLab Agent.
				--flux-environment-flux-resource-path @bool # Flux resource path of the environment for FluxCD.
				--flux-environment-name @bool # Name of the environment for FluxCD.
				--flux-environment-namespace @bool # Kubernetes namespace of the environment for FluxCD.
				--flux-source-name @bool # Flux source name.
				--flux-source-namespace @bool # Flux source namespace.
				--flux-source-type @bool # Source type of the flux-system, like Git, OCI, or Helm.
				--gitlab-agent-token-secret-name @bool # Name of the Secret where the token for the GitLab Agent is stored. The helm-release-target-namespace is implied for the namespace of the Secret.
				--helm-release-filepath @bool # File path within the GitLab Agent project to commit the Flux HelmRelease to.
				--helm-release-name @bool # Name of the Flux HelmRelease manifest.
				--helm-release-namespace @bool # Namespace of the Flux HelmRelease manifest.
				--helm-release-target-namespace @bool # Namespace of the GitLab Agent deployment.
				--helm-release-values @bool # Local path to values.yaml files. Multiple files can be comma-separated or specified by repeating the flag.
				--helm-release-values-from @bool # Kubernetes object reference that contains the values.yaml data key in the format '<kind>/<name>', where 'kind' must be one of: (Secret, ConfigMap). Multiple references can be comma-separated or specified by repeating the flag.
				--helm-repository-address @bool # Address of the HelmRepository.
				--helm-repository-filepath @bool # File path within the GitLab Agent project to commit the Flux HelmRepository to.
				--helm-repository-name @bool # Name of the Flux HelmRepository manifest.
				--helm-repository-namespace @bool # Namespace of the Flux HelmRepository manifest.
				--manifest-branch @bool # Branch to commit the Flux Manifests to. (default to the project default branch)
				--manifest-path @bool # Location of directory in Git repository for storing the GitLab Agent for Kubernetes Helm resources.
				--no-reconcile @bool # Do not trigger Flux reconciliation for GitLab Agent for Kubernetes Flux resource.
				--use-api-commit-author @bool # When creating Git commits use the user from the authenticated API request. Conflicts with the --commit-author-name and --commit-author-email flags.
			check_manifest_usage # Check agent configuration files for built-in GitOps manifests usage. (EXPERIMENTAL)
				--group @bool # Group ID to check.
			get-token # Create and return a k8s_proxy-scoped personal access token to authenticate with a GitLab Agents for Kubernetes.
				--agent @bool # The numerical Agent ID to connect to.
			list # List GitLab Agents for Kubernetes in a project.
				--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
				--page @bool # Page number.
				--per-page @bool # Number of items to list per page.
			token # Manage GitLab Agents for Kubernetes tokens.
				--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
				list # List tokens for an agent.
					--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
				revoke # Revoke a token of an agent.
					--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
			token-cache # Manage cached GitLab Agent tokens.
				--repo @bool # Select another repository. Can use either `OWNER/REPO` or `GROUP/NAMESPACE/REPO` format. Also accepts full URL or Git URL.
				clear # Clear cached GitLab Agent tokens
					--agent @bool # Clear tokens for specific agent IDs only
					--filesystem @bool # Clear tokens from filesystem cache
					--keyring @bool # Clear tokens from keyring cache
					--repo @bool # Select another repository using the OWNER/REPO format
					--revoke @bool # Revoke tokens on GitLab server before clearing cache
				list # List cached GitLab Agent tokens
					--agent @bool # Filter by specific agent IDs
					--filesystem @bool # Include tokens from filesystem cache
					--keyring @bool # Include tokens from keyring cache
					--repo @bool # Select another repository using the OWNER/REPO format
			update-kubeconfig # Update selected kubeconfig.
				--agent @bool # The numeric agent ID to create the kubeconfig entry for.
		graph # Queries the Kubernetes object graph, using the GitLab Agent for Kubernetes. (EXPERIMENTAL)
			--agent @bool # The numerical Agent ID to connect to.
