		verify # Verify all signatures of images specified in the manifest
			--output-file # log output to a file
			--timeout # timeout for commands
			--verbose @bool # log debug output
			--allow-http-registry @bool # whether to allow using HTTP protocol while connecting to registries. Don't use this for anything but testing
			--allow-insecure-registry @bool # whether to allow insecure connections to registries (e.g., with expired or self-signed TLS certificates). Don't use this for anything but testing
			--annotations @bool # extra key=value pairs to sign
			--attachment @bool # DEPRECATED, related image attachment to verify (sbom), default none
			--attachment-tag-prefix @bool # optional custom prefix to use for attached image tags. Attachment images are tagged as: `[AttachmentTagPrefix]sha256-[TargetImageDigest].[AttachmentName]`
			--ca-intermediates @bool # path to a file of intermediate CA certificates in PEM format which will be needed when building the certificate chains for the signing certificate. The flag is optional and must be used together with --ca-roots, conflicts with --certificate-chain.
			--ca-roots @bool # path to a bundle file of CA certificates in PEM format which will be needed when building the certificate chains for the signing certificate. Conflicts with --certificate-chain.
			--certificate @bool # path to the public certificate. The certificate will be verified against the Fulcio roots if the --certificate-chain option is not passed.
			--certificate-chain @bool # path to a list of CA certificates in PEM format which will be needed when building the certificate chain for the signing certificate. Must start with the parent intermediate CA certificate of the signing certificate and end with the root certificate. Conflicts with --ca-roots and --ca-intermediates.
			--certificate-github-workflow-name @bool # contains the workflow claim from the GitHub OIDC Identity token that contains the name of the executed workflow.
			--certificate-github-workflow-ref @bool # contains the ref claim from the GitHub OIDC Identity token that contains the git ref that the workflow run was based upon.
			--certificate-github-workflow-repository @bool # contains the repository claim from the GitHub OIDC Identity token that contains the repository that the workflow run was based upon
			--certificate-github-workflow-sha @bool # contains the sha claim from the GitHub OIDC Identity token that contains the commit SHA that the workflow run was based upon.
			--certificate-github-workflow-trigger @bool # contains the event_name claim from the GitHub OIDC Identity token that contains the name of the event that triggered the workflow run
			--certificate-identity @bool # The identity expected in a valid Fulcio certificate. Valid values include email address, DNS names, IP addresses, and URIs. Either --certificate-identity or --certificate-identity-regexp must be set for keyless flows.
			--certificate-identity-regexp @bool # A regular expression alternative to --certificate-identity. Accepts the Go regular expression syntax described at https://golang.org/s/re2syntax. Either --certificate-identity or --certificate-identity-regexp must be set for keyless flows.
			--certificate-oidc-issuer @bool # The OIDC issuer expected in a valid Fulcio certificate, e.g. https://token.actions.githubusercontent.com or https://oauth2.sigstore.dev/auth. Either --certificate-oidc-issuer or --certificate-oidc-issuer-regexp must be set for keyless flows.
			--certificate-oidc-issuer-regexp @bool # A regular expression alternative to --certificate-oidc-issuer. Accepts the Go regular expression syntax described at https://golang.org/s/re2syntax. Either --certificate-oidc-issuer or --certificate-oidc-issuer-regexp must be set for keyless flows.
			--check-claims @bool # whether to check the claims found
			--experimental-oci11 @bool # set to true to enable experimental OCI 1.1 behaviour (unrelated to bundle format)
			--insecure-ignore-sct @bool # when set, verification will not check that a certificate contains an embedded SCT, a proof of inclusion in a certificate transparency log
			--insecure-ignore-tlog @bool # ignore transparency log verification, to be used when an artifact signature has not been uploaded to the transparency log. Artifacts cannot be publicly verified when not included in a log
			--k8s-keychain @bool # whether to use the kubernetes keychain instead of the default keychain (supports workload identity).
			--key @bool # path to the public key file, KMS URI or Kubernetes Secret
			--local-image @bool # whether the specified image is a path to an image saved locally via 'cosign save'
			--max-workers @bool # the amount of maximum workers for parallel executions
			--new-bundle-format @bool # expect the signature/attestation to be packaged in a Sigstore bundle
			--output @bool # output format for the signing image information (json|text)
			--payload @bool # payload path or remote URL
			--private-infrastructure @bool # skip transparency log verification when verifying artifacts in a privately deployed infrastructure
			--registry-cacert @bool # path to the X.509 CA certificate file in PEM format to be used for the connection to the registry
			--registry-client-cert @bool # path to the X.509 certificate file in PEM format to be used for the connection to the registry
			--registry-client-key @bool # path to the X.509 private key file in PEM format to be used, together with the 'registry-client-cert' value, for the connection to the registry
			--registry-password @bool # registry basic auth password
			--registry-server-name @bool # SAN name to use as the 'ServerName' tls.Config field to verify the mTLS connection to the registry
			--registry-token @bool # registry bearer auth token
			--registry-username @bool # registry basic auth username
			--rekor-url @bool # address of rekor STL server
			--sct @bool # path to a detached Signed Certificate Timestamp, formatted as a RFC6962 AddChainResponse struct. If a certificate contains an SCT, verification will check both the detached and embedded SCTs.
			--signature @bool # signature content or path or remote URL
			--signature-digest-algorithm @bool # digest algorithm to use when processing a signature (sha224|sha256|sha384|sha512)
			--sk @bool # whether to use a hardware security key
			--slot @bool # security key slot to use for generated key (default: signature) (authentication|signature|card-authentication|key-management)
			--timestamp-certificate-chain @bool # path to PEM-encoded certificate chain file for the RFC3161 timestamp authority. Must contain the root CA certificate. Optionally may contain intermediate CA certificates, and may contain the leaf TSA certificate if not present in the timestamp
			--trusted-root @bool # Path to a Sigstore TrustedRoot JSON file. Requires --new-bundle-format to be set.
			--use-signed-timestamps @bool # verify rfc3161 timestamps
