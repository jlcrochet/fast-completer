	sign # Sign the supplied container image.
		--output-file # log output to a file
		--timeout # timeout for commands
		--verbose @bool # log debug output
		--allow-http-registry @bool # whether to allow using HTTP protocol while connecting to registries. Don't use this for anything but testing
		--allow-insecure-registry @bool # whether to allow insecure connections to registries (e.g., with expired or self-signed TLS certificates). Don't use this for anything but testing
		--annotations @bool # extra key=value pairs to sign
		--attachment @bool # DEPRECATED, related image attachment to sign (sbom), default none
		--attachment-tag-prefix @bool # optional custom prefix to use for attached image tags. Attachment images are tagged as: `[AttachmentTagPrefix]sha256-[TargetImageDigest].[AttachmentName]`
		--bundle @bool # write everything required to verify the image to FILE
		--certificate @bool # path to the X.509 certificate in PEM format to include in the OCI Signature
		--certificate-chain @bool # path to a list of CA X.509 certificates in PEM format which will be needed when building the certificate chain for the signing certificate. Must start with the parent intermediate CA certificate of the signing certificate and end with the root certificate. Included in the OCI Signature
		--fulcio-auth-flow @bool # fulcio interactive oauth2 flow to use for certificate from fulcio. Defaults to determining the flow based on the runtime environment. (options) normal|device|token|client_credentials
		--fulcio-url @bool # address of sigstore PKI server
		--identity-token @bool # identity token to use for certificate from fulcio. the token or a path to a file containing the token is accepted.
		--insecure-skip-verify @bool # skip verifying fulcio published to the SCT (this should only be used for testing).
		--issue-certificate @bool # issue a code signing certificate from Fulcio, even if a key is provided
		--k8s-keychain @bool # whether to use the kubernetes keychain instead of the default keychain (supports workload identity).
		--key @bool # path to the private key file, KMS URI or Kubernetes Secret
		--new-bundle-format @bool # expect the signature/attestation to be packaged in a Sigstore bundle
		--oidc-client-id @bool # OIDC client ID for application
		--oidc-client-secret-file @bool # Path to file containing OIDC client secret for application
		--oidc-disable-ambient-providers @bool # Disable ambient OIDC providers. When true, ambient credentials will not be read
		--oidc-issuer @bool # OIDC provider to be used to issue ID token
		--oidc-provider @bool # Specify the provider to get the OIDC token from (Optional). If unset, all options will be tried. Options include: [spiffe, google, github-actions, filesystem, buildkite-agent]
		--oidc-redirect-url @bool # OIDC redirect URL (Optional). The default oidc-redirect-url is 'http://localhost:0/auth/callback'.
		--output-certificate @bool # write the certificate to FILE
		--output-payload @bool # write the signed payload to FILE
		--output-signature @bool # write the signature to FILE
		--payload @bool # path to a payload file to use rather than generating one
		--record-creation-timestamp @bool # set the createdAt timestamp in the signature artifact to the time it was created; by default, cosign sets this to the zero value
		--recursive @bool # if a multi-arch image is specified, additionally sign each discrete image
		--registry-cacert @bool # path to the X.509 CA certificate file in PEM format to be used for the connection to the registry
		--registry-client-cert @bool # path to the X.509 certificate file in PEM format to be used for the connection to the registry
		--registry-client-key @bool # path to the X.509 private key file in PEM format to be used, together with the 'registry-client-cert' value, for the connection to the registry
		--registry-password @bool # registry basic auth password
		--registry-referrers-mode @bool # mode for fetching references from the registry. allowed: legacy, oci-1-1
		--registry-server-name @bool # SAN name to use as the 'ServerName' tls.Config field to verify the mTLS connection to the registry
		--registry-token @bool # registry bearer auth token
		--registry-username @bool # registry basic auth username
		--rekor-url @bool # address of rekor STL server
		--sign-container-identity @bool # manually set the .critical.docker-reference field for the signed identity, which is useful when image proxies are being used where the pull reference should match the signature, this flag is comma delimited. ex: --sign-container-identity=identity1,identity2
		--signing-config @bool # path to a signing config file. Must provide --new-bundle-format, which will store verification material in the new format
		--sk @bool # whether to use a hardware security key
		--slot @bool # security key slot to use for generated key (default: signature) (authentication|signature|card-authentication|key-management)
		--timestamp-client-cacert @bool # path to the X.509 CA certificate file in PEM format to be used for the connection to the TSA Server
		--timestamp-client-cert @bool # path to the X.509 certificate file in PEM format to be used for the connection to the TSA Server
		--timestamp-client-key @bool # path to the X.509 private key file in PEM format to be used, together with the 'timestamp-client-cert' value, for the connection to the TSA Server
		--timestamp-server-name @bool # SAN name to use as the 'ServerName' tls.Config field to verify the mTLS connection to the TSA Server
		--timestamp-server-url @bool # url to the Timestamp RFC3161 server, default none. Must be the path to the API to request timestamp responses, e.g. https://freetsa.org/tsr
		--trusted-root @bool # optional path to a TrustedRoot JSON file to verify a signature after signing
		--upload @bool # whether to upload the signature
		--use-signing-config @bool # whether to use a TUF-provided signing config for the service URLs. Must set --new-bundle-format, which will store verification material in the new format
		--yes @bool # skip confirmation prompts for non-destructive operations
