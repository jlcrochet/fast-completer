			--output-file # log output to a file
			--timeout # timeout for commands
			--verbose @bool # log debug output
			--artifact @bool # path to artifact FILE
			--attestation @bool # path to attestation FILE
			--bundle @bool # path to old format bundle FILE
			--certificate @bool # path to the signing certificate, likely from Fulco.
			--ignore-tlog @bool # ignore transparency log verification, to be used when an artifact signature has not been uploaded to the transparency log.
			--key @bool # path to the public key file, KMS URI or Kubernetes Secret
			--out @bool # path to output bundle
			--rekor-url @bool # address of rekor STL server
			--rfc3161-timestamp @bool # path to RFC3161 timestamp FILE
			--signature @bool # path to base64-encoded signature over attestation in DSSE format
			--sk @bool # whether to use a hardware security key
			--slot @bool # security key slot to use for generated key (authentication|signature|card-authentication|key-management)
