# cosign CLI schema for fast-completer
# Generated from cosign unknown

cosign # Container signing
	--help @bool # help for cosign
	--output-file # log output to a file
	--timeout @bool # timeout for commands
	--verbose @bool # log debug output
	attach # Provides utilities for attaching artifacts to other artifacts in a registry
		--output-file # log output to a file
		--timeout # timeout for commands
		--verbose @bool # log debug output
		attestation # Attach attestation to the supplied container image
			--output-file # log output to a file
			--timeout # timeout for commands
			--verbose @bool # log debug output
			--allow-http-registry @bool # whether to allow using HTTP protocol while connecting to registries. Don't use this for anything but testing
			--allow-insecure-registry @bool # whether to allow insecure connections to registries (e.g., with expired or self-signed TLS certificates). Don't use this for anything but testing
			--attachment-tag-prefix @bool # optional custom prefix to use for attached image tags. Attachment images are tagged as: `[AttachmentTagPrefix]sha256-[TargetImageDigest].[AttachmentName]`
			--attestation @bool # path to the attestation envelope
			--k8s-keychain @bool # whether to use the kubernetes keychain instead of the default keychain (supports workload identity).
			--registry-cacert @bool # path to the X.509 CA certificate file in PEM format to be used for the connection to the registry
			--registry-client-cert @bool # path to the X.509 certificate file in PEM format to be used for the connection to the registry
			--registry-client-key @bool # path to the X.509 private key file in PEM format to be used, together with the 'registry-client-cert' value, for the connection to the registry
			--registry-password @bool # registry basic auth password
			--registry-server-name @bool # SAN name to use as the 'ServerName' tls.Config field to verify the mTLS connection to the registry
			--registry-token @bool # registry bearer auth token
			--registry-username @bool # registry basic auth username
		sbom # DEPRECATED: Attach sbom to the supplied container image
			--output-file # log output to a file
			--timeout # timeout for commands
			--verbose @bool # log debug output
			--allow-http-registry @bool # whether to allow using HTTP protocol while connecting to registries. Don't use this for anything but testing
			--allow-insecure-registry @bool # whether to allow insecure connections to registries (e.g., with expired or self-signed TLS certificates). Don't use this for anything but testing
			--attachment-tag-prefix @bool # optional custom prefix to use for attached image tags. Attachment images are tagged as: `[AttachmentTagPrefix]sha256-[TargetImageDigest].[AttachmentName]`
			--input-format @bool # type of sbom input format (json|xml|text)
			--k8s-keychain @bool # whether to use the kubernetes keychain instead of the default keychain (supports workload identity).
			--registry-cacert @bool # path to the X.509 CA certificate file in PEM format to be used for the connection to the registry
			--registry-client-cert @bool # path to the X.509 certificate file in PEM format to be used for the connection to the registry
			--registry-client-key @bool # path to the X.509 private key file in PEM format to be used, together with the 'registry-client-cert' value, for the connection to the registry
			--registry-password @bool # registry basic auth password
			--registry-referrers-mode @bool # mode for fetching references from the registry. allowed: legacy, oci-1-1
			--registry-server-name @bool # SAN name to use as the 'ServerName' tls.Config field to verify the mTLS connection to the registry
			--registry-token @bool # registry bearer auth token
			--registry-username @bool # registry basic auth username
			--sbom @bool # path to the sbom, or {-} for stdin
			--type @bool # type of sbom (spdx|cyclonedx|syft)
		signature # Attach signatures to the supplied container image
			--output-file # log output to a file
			--timeout # timeout for commands
			--verbose @bool # log debug output
			--allow-http-registry @bool # whether to allow using HTTP protocol while connecting to registries. Don't use this for anything but testing
			--allow-insecure-registry @bool # whether to allow insecure connections to registries (e.g., with expired or self-signed TLS certificates). Don't use this for anything but testing
			--attachment-tag-prefix @bool # optional custom prefix to use for attached image tags. Attachment images are tagged as: `[AttachmentTagPrefix]sha256-[TargetImageDigest].[AttachmentName]`
			--bundle @bool # path to bundle containing signature (alias for payload)
			--certificate @bool # path to the X.509 certificate in PEM format to include in the OCI Signature
			--certificate-chain @bool # path to a list of CA X.509 certificates in PEM format which will be needed when building the certificate chain for the signing certificate. Must start with the parent intermediate CA certificate of the signing certificate and end with the root certificate. Included in the OCI Signature
			--k8s-keychain @bool # whether to use the kubernetes keychain instead of the default keychain (supports workload identity).
			--payload @bool # path to the payload covered by the signature
			--registry-cacert @bool # path to the X.509 CA certificate file in PEM format to be used for the connection to the registry
			--registry-client-cert @bool # path to the X.509 certificate file in PEM format to be used for the connection to the registry
			--registry-client-key @bool # path to the X.509 private key file in PEM format to be used, together with the 'registry-client-cert' value, for the connection to the registry
			--registry-password @bool # registry basic auth password
			--registry-server-name @bool # SAN name to use as the 'ServerName' tls.Config field to verify the mTLS connection to the registry
			--registry-token @bool # registry bearer auth token
			--registry-username @bool # registry basic auth username
			--rekor-response @bool # path to the rekor bundle
			--signature @bool # path to the signature, or {-} for stdin
			--tsr @bool # path to the Time Stamped Signature Response from RFC3161 compliant TSA
	attest # Attest the supplied container image.
