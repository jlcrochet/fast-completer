				--access-token # API V2 access token
				--api-url # Override default API endpoint
				--config # Specify a custom config file
				--context # Specify a custom authentication context name
				--http-retry-max # Set maximum number of retries for requests that fail with a 429 or 500-level error
				--interactive @bool # Enable interactive behavior. Defaults to true if the terminal supports it (default false)
				--output # Desired output format [text|json]
				--trace @bool # Show a log of network activity while performing a command
				--verbose @bool # Enable verbose output
				--auto-upgrade # Indicates whether the cluster automatically upgrades to new patch releases during its maintenance window. To enable automatic upgrade, use `--auto-upgrade=true`.
				--cluster-name # Specifies a new cluster name
				--control-plane-firewall-allowed-addresses # A comma-separated list of allowed addresses that can access the control plane.
				--enable-amd-gpu-device-metrics-exporter-plugin @bool # Creates the cluster with amd gpu device metrics exporter plugin installed. Defaults to false. To enable it, supply --enable-amd-gpu-device-metrics-exporter-plugin=true.
				--enable-amd-gpu-device-plugin @bool # Creates the cluster with amd gpu device plugin installed. Defaults to true for clusters with AMD GPUs and otherwise false. To always enable it, supply --enable-amd-gpu-device-plugin=true.
				--enable-control-plane-firewall @bool # Creates the cluster with control plane firewall enabled. Defaults to false. To enable the control plane firewall, supply --enable-control-plane-firewall=true.
				--enable-nvidia-gpu-device-plugin @bool # Creates the cluster with nvidia gpu device plugin installed. Defaults to true for clusters with NVIDIA GPUs and otherwise false. To always enable it, supply --enable-nvidia-gpu-device-plugin=true.
				--enable-rdma-shared-device-plugin @bool # Creates the cluster with k8s-rdma-shared-dev-plugin device plugin installed. Defaults to true for clusters with GPU nodes connected to a dedicated high-speed networking fabric. To always enable it, supply --enable-rdma-shared-device-plugin=true.
				--enable-routing-agent @bool # Creates the cluster with routing-agent enabled. Defaults to false. To enable routing-agent, supply --routing-agent=true.
				--expanders # Customizes expanders used by cluster-autoscaler. The autoscaler will apply each expander from the provided comma-separated list to narrow down the selection of node types created to scale up, until either a single node type is left, or the list of expanders is exhausted. Available expanders: random, least-waste, priority. If this value is empty, autoscaler will use its default expanders. To unset expander customization, pass an empty string.
				--ha @bool # Enables the highly-available control plane for the cluster
				--maintenance-window # Sets the beginning of the four hour maintenance window for the cluster. Syntax is in the format: 'day=HH:MM', where time is in UTC. Day can be: `any`, `monday`, `tuesday`, `wednesday`, `thursday`, `friday`, `saturday`, `sunday`.
				--scale-down-unneeded-time # The unneed time for the cluster autoscaler's scale-down-unneeded-time. It defines how long a node should be unneeded before it is eligible for scale down. To set the scale-down-unneeded-time to a minute and 30 seconds for example, pass the string '1m30s'.
				--scale-down-utilization-threshold # The threshold value for the cluster autoscaler's scale-down-utilization-threshold. It is the maximum value between the sum of CPU requests and sum of memory requests of all pods running on the node divided by node's corresponding allocatable resource, below which a node can be considered for scale down. To set the scale-down-utilization-threshold to 50%, pass the floating point value 0.5.
				--set-current-context @bool # Sets the current kubectl context to that of the new cluster
				--surge-upgrade @bool # Enables surge-upgrade for the cluster
				--tag # A comma-separated list of tags to apply to the cluster. This removes other  user-provided tags from the cluster if they are not specified in this argument.
				--update-kubeconfig @bool # Updates the cluster in your kubeconfig
