		--tls-server-name @bool # Server name to use for server certificate validation. If it is not provided, the hostname used to contact the server is used
		--token @bool # Bearer token for authentication to the API server
		--user @bool # The name of the kubeconfig user to use
		--v @bool # number for the log level verbosity
		--vmodule @bool # comma-separated list of pattern=N settings for file-filtered logging (only works for the default text log format)
		--warnings-as-errors @bool # Treat warnings received from the server as errors and exit with a non-zero exit code
		--show-console @bool # If true, print the current server's web console URL
		--show-context @bool # Print the current user context name
		--show-server @bool # If true, print the current server's REST API URL
		--show-token @bool # Print the token the current session is using. This will return an error if you are using a different form of authentication.
