			--claim-name @bool # Persistent volume claim name. Must be provided for persistentVolumeClaim volume type
			--claim-size @bool # If specified along with a persistent volume type, create a new claim with the given size in bytes. Accepts SI notation: 10, 10G, 10Gi
			--configmap-name @bool # Name of the persisted config map. Must be provided for configmap volume type
			--confirm @bool # If true, confirm that you really want to remove multiple volumes
			--containers @bool # The names of containers in the selected pod templates to change - may use wildcards
			--default-mode @bool # The default mode bits to create files with. Can be between 0000 and 0777. Defaults to 0644.
			--dry-run @bool # Must be "none", "server", or "client". If client strategy, only print the object that would be sent, without sending it. If server strategy, submit server-side request without persisting the resource.
			--field-manager @bool # Name of the manager used to track field ownership.
			--filename @bool # Filename, directory, or URL to files to use to edit the resource
			--kustomize @bool # Process the kustomization directory. This flag can't be used together with -f or -R.
			--local @bool # If true, set image will NOT contact api-server but run locally.
			--mount-path @bool # Mount path inside the container. Optional param for --add or --remove
			--name @bool # Name of the volume. If empty, auto generated for add operation
			--output @bool # Output format. One of: (json, yaml, name, go-template, go-template-file, template, templatefile, jsonpath, jsonpath-as-json, jsonpath-file).
			--overwrite @bool # If true, replace existing volume source with the provided name and/or volume mount for the given resource
			--path @bool # Host path. Must be provided for hostPath volume type
			--read-only @bool # Mount volume as ReadOnly. Optional param for --add or --remove
			--recursive @bool # Process the directory used in -f, --filename recursively. Useful when you want to manage related manifests organized within the same directory.
			--remove @bool # If true, remove volume and/or volume mounts for containers
			--secret-name @bool # Name of the persisted secret. Must be provided for secret volume type
			--selector @bool # Selector (label query) to filter on
			--show-managed-fields @bool # If true, keep the managedFields when printing objects in JSON or YAML format.
			--source @bool # Details of volume source as json string. This can be used if the required volume type is not supported by --type option. (e.g.: '{"nfs": {"path": "/tmp","server":"172.17.0.2"}}')
			--sub-path @bool # Path within the local volume from which the container's volume should be mounted. Optional param for --add or --remove
			--template @bool # Template string or path to template file to use when -o=go-template, -o=go-template-file. The template format is golang templates [http://golang.org/pkg/text/template/#pkg-overview].
			--type @bool # Type of the volume source for add operation. Supported options: emptyDir, hostPath, secret, configmap, persistentVolumeClaim
