# Deno CLI schema for fast-completer
# Generated from deno 2.6.10

deno # A modern JavaScript and TypeScript runtime
	add # Add dependencies
		--dev|-D @bool # Add the package as a dev dependency. Note: This only applies when adding to a `package.json` file.
		--jsr @bool # assume unprefixed package names are jsr packages
		--lockfile-only @bool # Install only updating the lockfile
		--npm @bool # assume unprefixed package names are npm packages
		--quiet|-q @bool # Suppress diagnostic output
		--no-lock @bool # Disable auto discovery of the lock file
	bench # Run benchmarks
		--cert # Load certificate authority from PEM encoded file
		--conditions # Use this argument to specify custom conditions for npm package exports. You can also use DENO_CONDITIONS env var.
		--config|-c # Configure different aspects of deno including TypeScript, linting, and code formatting.
		--ext (ts|tsx|js|jsx|mts|mjs|cts|cjs) # Set content type of the supplied file [possible values: ts, tsx, js, jsx, mts, mjs, cts, cjs]
		--filter # Run benchmarks with this string or regexp pattern in the bench name
		--json @bool # UNSTABLE: Output benchmark result in JSON format
		--location # Value of globalThis.location used by some web APIs
		--minimum-dependency-age # (Unstable) The age in minutes, ISO-8601 duration or RFC3339 absolute timestamp (e.g. '120' for two hours, 'P2D' for two days, '2025-09-16' for cutoff date, '2025-09-16T12:00:00+00:00' for cutoff time, '0' to disable)
		--no-config @bool # Disable automatic loading of the configuration file
		--no-run @bool # Cache bench modules, but don't run benchmarks
		--permit-no-files @bool # Don't return an error code if no files were found
		--preload # A list of files that will be executed before the main module
		--quiet|-q @bool # Suppress diagnostic output
		--require # A list of CommonJS modules that will be executed before the main module
		--seed # Set the random number generator seed
		--unstable @bool # The `--unstable` flag has been deprecated. Use granular `--unstable-*` flags instead
		--no-clear-screen @bool # Do not clear terminal screen when under watch mode
		--watch @bool # Watch for file changes and restart process automatically.
		--cached-only @bool # Require that remote dependencies are already cached
		--import-map # Load import map file from local file or remote URL
		--no-lock @bool # Disable auto discovery of the lock file
		--no-npm @bool # Do not resolve npm modules
		--no-remote @bool # Do not resolve remote modules
		--allow-all|-A @bool # Allow all permissions.
		--no-prompt @bool # Always throw if required permission wasn't passed.
		--allow-read # --allow-read="/etc,/var/log.txt"
		--allow-write # --allow-write="/etc,/var/log.txt"
		--allow-import # --allow-import="example.com,github.com"
		--allow-net # --allow-net="localhost:8080,deno.land"
		--allow-env # --allow-env="PORT,HOME,PATH"
		--allow-sys # --allow-sys="systemMemoryInfo,osRelease"
		--allow-run # --allow-run="whoami,ps"
		--allow-ffi # --allow-ffi="./libfoo.so"
		--deny-read # --deny-read="/etc,/var/log.txt"
		--deny-write # --deny-write="/etc,/var/log.txt"
		--deny-net # --deny-net="localhost:8080,deno.land"
		--deny-env # --deny-env="PORT,HOME,PATH"
		--deny-sys # --deny-sys="systemMemoryInfo,osRelease"
		--deny-run # --deny-run="whoami,ps"
		--deny-ffi # --deny-ffi="./libfoo.so"
		--deny-import # --deny-import="example.com:443,github.com:443"
		--ignore-env # --ignore-env="PORT,HOME,PATH"
		--ignore-read # --ignore-read="/etc,/var/log.txt"
