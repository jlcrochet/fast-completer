# Starship CLI schema for fast-completer
# Generated from starship 1.24.2

starship # Cross-shell prompt
	bug-report # Create a pre-populated GitHub issue with information about your configuration
	config # Edit the starship configuration
	explain # Explains the currently showing modules
		--status|-s # The status code of the previously run command as an unsigned or signed 32bit integer
		--pipestatus # Bash, Fish and Zsh support returning codes for each process in a pipeline
		--terminal-width|-w # The width of the current interactive terminal [default: 80]
		--path|-p # The path that the prompt should render for
		--logical-path|-P # The logical path that the prompt should render for. This path should be a virtual/logical representation of the PATH argument
		--cmd-duration|-d # The execution duration of the last command, in milliseconds
		--keymap|-k # The keymap of fish/zsh/cmd [default: viins]
		--jobs|-j # The number of currently running jobs [default: 0]
		--shlvl # The current value of SHLVL, for shells that mis-handle it in $()
	init # Prints the shell function used to execute starship
		--print-full-init @bool
	module # Prints a specific prompt module
		--list|-l @bool # List out all supported modules
		--status|-s # The status code of the previously run command as an unsigned or signed 32bit integer
		--pipestatus # Bash, Fish and Zsh support returning codes for each process in a pipeline
		--terminal-width|-w # The width of the current interactive terminal [default: 80]
		--path|-p # The path that the prompt should render for
		--logical-path|-P # The logical path that the prompt should render for. This path should be a virtual/logical representation of the PATH argument
		--cmd-duration|-d # The execution duration of the last command, in milliseconds
		--keymap|-k # The keymap of fish/zsh/cmd [default: viins]
		--jobs|-j # The number of currently running jobs [default: 0]
		--shlvl # The current value of SHLVL, for shells that mis-handle it in $()
	preset # Prints a preset config
		--output|-o # Output the preset to a file instead of stdout
		--list|-l @bool # List out all preset names
	print-config # Prints the computed starship configuration
		--default|-d @bool # Print the default instead of the computed config
	prompt # Prints the full starship prompt
		--right @bool # Print the right prompt (instead of the standard left prompt)
		--profile # Print the prompt with the specified profile name (instead of the standard left prompt)
		--continuation @bool # Print the continuation prompt (instead of the standard left prompt)
		--status|-s # The status code of the previously run command as an unsigned or signed 32bit integer
		--pipestatus # Bash, Fish and Zsh support returning codes for each process in a pipeline
		--terminal-width|-w # The width of the current interactive terminal [default: 80]
		--path|-p # The path that the prompt should render for
		--logical-path|-P # The logical path that the prompt should render for. This path should be a virtual/logical representation of the PATH argument
		--cmd-duration|-d # The execution duration of the last command, in milliseconds
		--keymap|-k # The keymap of fish/zsh/cmd [default: viins]
		--jobs|-j # The number of currently running jobs [default: 0]
		--shlvl # The current value of SHLVL, for shells that mis-handle it in $()
	session # Generate random session key
	timings # Prints timings of all active modules
		--status|-s # The status code of the previously run command as an unsigned or signed 32bit integer
		--pipestatus # Bash, Fish and Zsh support returning codes for each process in a pipeline
		--terminal-width|-w # The width of the current interactive terminal [default: 80]
		--path|-p # The path that the prompt should render for
		--logical-path|-P # The logical path that the prompt should render for. This path should be a virtual/logical representation of the PATH argument
		--cmd-duration|-d # The execution duration of the last command, in milliseconds
		--keymap|-k # The keymap of fish/zsh/cmd [default: viins]
		--jobs|-j # The number of currently running jobs [default: 0]
		--shlvl # The current value of SHLVL, for shells that mis-handle it in $()
	toggle # Toggle a given starship module
