# k3d CLI schema for fast-completer
# Generated from k3d 5.8.3

k3d # k3s in Docker
	--help @bool # help for k3d
	--timestamps @bool # Enable Log timestamps
	--trace @bool # Enable super verbose output (trace logging)
	--verbose @bool # Enable verbose output (debug logging)
	--version @bool # Show k3d and default k3s version
	cluster # Manage cluster(s)
		--timestamps @bool # Enable Log timestamps
		--trace @bool # Enable super verbose output (trace logging)
		--verbose @bool # Enable verbose output (debug logging)
		create # Create a new cluster
			--timestamps @bool # Enable Log timestamps
			--trace @bool # Enable super verbose output (trace logging)
			--verbose @bool # Enable verbose output (debug logging)
			--agents # Specify how many agents you want to create
			--agents-memory # Memory limit imposed on the agents nodes [From docker]
			--api-port # Specify the Kubernetes API server port exposed on the LoadBalancer (Format: `[HOST:]HOSTPORT`)
			--config # Path of a config file to use
			--env # Add environment variables to nodes (Format: `KEY[=VALUE][@NODEFILTER[;NODEFILTER...]]`
			--gpus # GPU devices to add to the cluster node containers ('all' to pass all GPUs) [From docker]
			--host-alias # Add `ip:host[,host,...]` mappings
			--host-pid-mode @bool # Enable host pid mode of server(s) and agent(s)
			--image # Specify k3s image that you want to use for the nodes
			--k3s-arg # Additional args passed to k3s command (Format: `ARG@NODEFILTER[;@NODEFILTER]`)
			--k3s-node-label # Add label to k3s node (Format: `KEY[=VALUE][@NODEFILTER[;NODEFILTER...]]`
			--kubeconfig-switch-context @bool # Directly switch the default kubeconfig's current-context to the new cluster's context (requires --kubeconfig-update-default)
			--kubeconfig-update-default @bool # Directly update the default kubeconfig with the new cluster's context
			--lb-config-override # Use dotted YAML path syntax to override nginx loadbalancer settings
			--network # Join an existing network
			--no-image-volume @bool # Disable the creation of a volume for importing images
			--no-lb @bool # Disable the creation of a LoadBalancer in front of the server nodes
			--no-rollback @bool # Disable the automatic rollback actions, if anything goes wrong
			--port # Map ports from the node containers (via the serverlb) to the host (Format: `[HOST:][HOSTPORT:]CONTAINERPORT[/PROTOCOL][@NODEFILTER]`)
			--registry-config # Specify path to an extra registries.yaml file
			--registry-create # Create a k3d-managed registry and connect it to the cluster (Format: `NAME[:HOST][:HOSTPORT]`
			--registry-use # Connect to one or more k3d-managed registries running locally
			--runtime-label # Add label to container runtime (Format: `KEY[=VALUE][@NODEFILTER[;NODEFILTER...]]`
			--runtime-ulimit # Add ulimit to container runtime (Format: `NAME[=SOFT]:[HARD]`
			--servers # Specify how many servers you want to create
			--servers-memory # Memory limit imposed on the server nodes [From docker]
			--subnet # [Experimental: IPAM] Define a subnet for the newly created container network (Example: `172.28.0.0/16`)
			--timeout # Rollback changes if cluster couldn't be created in specified duration.
			--token # Specify a cluster token. By default, we generate one.
			--volume # Mount volumes into the nodes (Format: `[SOURCE:]DEST[@NODEFILTER[;NODEFILTER...]]`
			--wait @bool # Wait for the server(s) to be ready before returning. Use '--timeout DURATION' to not wait forever.
		delete # Delete cluster(s).
			--timestamps @bool # Enable Log timestamps
			--trace @bool # Enable super verbose output (trace logging)
			--verbose @bool # Enable verbose output (debug logging)
			--all @bool # Delete all existing clusters
			--config # Path of a config file to use
		edit # [EXPERIMENTAL] Edit cluster(s).
			--timestamps @bool # Enable Log timestamps
			--trace @bool # Enable super verbose output (trace logging)
			--verbose @bool # Enable verbose output (debug logging)
			--port-add # [EXPERIMENTAL] Map ports from the node containers (via the serverlb) to the host (Format: `[HOST:][HOSTPORT:]CONTAINERPORT[/PROTOCOL][@NODEFILTER]`)
		list # List cluster(s)
			--timestamps @bool # Enable Log timestamps
			--trace @bool # Enable super verbose output (trace logging)
			--verbose @bool # Enable verbose output (debug logging)
			--no-headers @bool # Disable headers
			--output # Output format. One of: json|yaml
			--token @bool # Print k3s cluster token
		start # Start existing k3d cluster(s)
			--timestamps @bool # Enable Log timestamps
			--trace @bool # Enable super verbose output (trace logging)
			--verbose @bool # Enable verbose output (debug logging)
			--all @bool # Start all existing clusters
			--timeout # Maximum waiting time for '--wait' before canceling/returning.
			--wait @bool # Wait for the server(s) (and loadbalancer) to be ready before returning.
		stop # Stop existing k3d cluster(s)
			--timestamps @bool # Enable Log timestamps
			--trace @bool # Enable super verbose output (trace logging)
			--verbose @bool # Enable verbose output (debug logging)
			--all @bool # Stop all existing clusters
