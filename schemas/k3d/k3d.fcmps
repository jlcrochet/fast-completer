		create # Create a new k3s node in docker
			--timestamps @bool # Enable Log timestamps
			--trace @bool # Enable super verbose output (trace logging)
			--verbose @bool # Enable verbose output (debug logging)
			--cluster # Cluster URL or k3d cluster name to connect to.
			--image # Specify k3s image used for the node(s) (default: copied from existing node)
			--k3s-arg # Additional args passed to k3d command
			--k3s-node-label # Specify k3s node labels in format "foo=bar"
			--memory # Memory limit imposed on the node [From docker]
			--network # Add node to (another) runtime network
			--replicas # Number of replicas of this node specification.
			--role # Specify node role [server, agent]
			--runtime-label # Specify container runtime labels in format "foo=bar"
			--runtime-ulimit # Specify container runtime ulimit in format "ulimit=soft:hard"
			--timeout # Maximum waiting time for '--wait' before canceling/returning.
			--token # Override cluster token (required when connecting to an external cluster)
			--wait @bool # Wait for the node(s) to be ready before returning.
