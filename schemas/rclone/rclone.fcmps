	mount # Mount the remote as file system on a mountpoint.
		--dir-cache-time # Time to cache directory entries for (default 5m0s)
		--poll-interval # Time to wait between polling for changes. Must be smaller than dir-cache-time. Only on supported remotes. Set to 0 to disable (default 1m0s)
		--cache-dir # Directory rclone will use for caching.
		--vfs-cache-mode # Cache mode off|minimal|writes|full (default off)
		--vfs-cache-max-age # Max time since last access of objects in the cache (default 1h0m0s)
		--vfs-cache-max-size # Max total size of objects in the cache (default off)
		--vfs-cache-min-free-space # Target minimum free space on the disk containing the cache (default off)
		--vfs-cache-poll-interval # Interval to poll the cache for stale objects (default 1m0s)
		--vfs-write-back # Time to writeback files after last use when using cache (default 5s)
		--vfs-read-chunk-size # Read the source objects in chunks (default 128M)
		--vfs-read-chunk-size-limit # Max chunk doubling size (default off)
		--vfs-read-chunk-streams # The number of parallel streams to read at once
		--no-checksum @bool # Don't compare checksums on up/download.
		--no-modtime @bool # Don't read/write the modification time (can speed things up).
		--no-seek @bool # Don't allow seeking in files.
		--read-only @bool # Only allow read-only access.
		--vfs-read-wait # Time to wait for in-sequence read before seeking (default 20ms)
		--vfs-write-wait # Time to wait for in-sequence write before giving error (default 1s)
		--transfers # Number of file transfers to run in parallel (default 4)
		--links @bool # Translate symlinks to/from regular files with a '.rclonelink' extension.
		--vfs-links @bool # Translate symlinks to/from regular files with a '.rclonelink' extension for the VFS
		--vfs-disk-space-total-size @bool # Manually set the total disk space size (example: 256G, default: -1)
		--allow-non-empty @bool # Allow mounting over a non-empty directory (not supported on Windows)
		--allow-other @bool # Allow access to other users (not supported on Windows)
		--allow-root @bool # Allow access to root user (not supported on Windows)
		--async-read @bool # Use asynchronous reads (not supported on Windows) (default true)
		--attr-timeout # Time for which file/directory attributes are cached (default 1s)
		--daemon @bool # Run mount in background and exit parent process (as background output is suppressed, use --log-file with --log-format=pid,... to monitor) (not supported on Windows)
		--daemon-timeout # Time limit for rclone to respond to kernel (not supported on Windows) (default 0s)
		--daemon-wait # Time to wait for ready mount from daemon (maximum time on Linux, constant sleep time on OSX/BSD) (not supported on Windows) (default 1m0s)
		--debug-fuse @bool # Debug the FUSE internals - needs -v
		--default-permissions @bool # Makes kernel enforce access control based on the file mode (not supported on Windows)
		--devname # Set the device name - default is remote:path
		--dir-cache-time # Time to cache directory entries for (default 5m0s)
		--dir-perms # Directory permissions (default 777)
		--direct-io @bool # Use Direct IO, disables caching of data
		--file-perms # File permissions (default 666)
		--fuse-flag # Flags or arguments to be passed direct to libfuse/WinFsp (repeat if required)
		--gid # Override the gid field set by the filesystem (not supported on Windows) (default 1000)
		--link-perms # Link permissions (default 666)
		--max-read-ahead # The number of bytes that can be prefetched for sequential reads (not supported on Windows) (default 128Ki)
		--mount-case-insensitive # Tell the OS the mount is case insensitive (true) or sensitive (false) regardless of the backend (auto) (default unset)
		--network-mode @bool # Mount as remote network drive, instead of fixed disk drive (supported on Windows only)
		--no-checksum @bool # Don't compare checksums on up/download
		--no-modtime @bool # Don't read/write the modification time (can speed things up)
		--no-seek @bool # Don't allow seeking in files
		--noappledouble @bool # Ignore Apple Double (._) and .DS_Store files (supported on OSX only) (default true)
		--noapplexattr @bool # Ignore all "com.apple.*" extended attributes (supported on OSX only)
		--option|-o # Option for libfuse/WinFsp (repeat if required)
		--poll-interval # Time to wait between polling for changes, must be smaller than dir-cache-time and only on supported remotes (set 0 to disable) (default 1m0s)
		--read-only @bool # Only allow read-only access
		--uid # Override the uid field set by the filesystem (not supported on Windows) (default 1000)
		--umask # Override the permission bits set by the filesystem (not supported on Windows) (default 022)
		--vfs-block-norm-dupes @bool # If duplicate filenames exist in the same directory (after normalization), log an error and hide the duplicates (may have a performance cost)
		--vfs-cache-max-age # Max time since last access of objects in the cache (default 1h0m0s)
		--vfs-cache-max-size # Max total size of objects in the cache (default off)
		--vfs-cache-min-free-space # Target minimum free space on the disk containing the cache (default off)
		--vfs-cache-mode # Cache mode off|minimal|writes|full (default off)
		--vfs-cache-poll-interval # Interval to poll the cache for stale objects (default 1m0s)
		--vfs-case-insensitive @bool # If a file name not found, find a case insensitive match
		--vfs-disk-space-total-size # Specify the total space of disk (default off)
		--vfs-fast-fingerprint @bool # Use fast (less accurate) fingerprints for change detection
		--vfs-links @bool # Translate symlinks to/from regular files with a '.rclonelink' extension for the VFS
		--vfs-metadata-extension # Set the extension to read metadata from
		--vfs-read-ahead # Extra read ahead over --buffer-size when using cache-mode full
		--vfs-read-chunk-size # Read the source objects in chunks (default 128Mi)
		--vfs-read-chunk-size-limit # If greater than --vfs-read-chunk-size, double the chunk size after each chunk read, until the limit is reached ('off' is unlimited) (default off)
		--vfs-read-chunk-streams # The number of parallel streams to read at once
		--vfs-read-wait # Time to wait for in-sequence read before seeking (default 20ms)
		--vfs-refresh @bool # Refreshes the directory cache recursively in the background on start
		--vfs-write-back # Time to writeback files after last use when using cache (default 5s)
		--vfs-write-wait # Time to wait for in-sequence write before giving error (default 1s)
		--volname # Set the volume name (supported on Windows and OSX only)
		--write-back-cache @bool # Makes kernel buffer writes before sending them to rclone (without this, writethrough caching is used) (not supported on Windows)
