		--format|-F # Output format - see lsf help for details (default "p")
		--hash # Use this hash when h is used in the format MD5|SHA-1|DropboxHash (default "md5")
		--match # Report all matching files to this file
		--missing-on-dst # Report all files missing from the destination to this file
		--missing-on-src # Report all files missing from the source to this file
		--separator|-s # Separator for the items in the format (default ";")
		--timeformat|-t # Specify a custom time format - see docs for details (default: 2006-01-02 15:04:05)
		--check-first @bool # Do all the checks before starting transfers
		--checksum|-c @bool # Check for changes with size & checksum (if available, or fallback to size only)
		--compare-dest # Include additional server-side paths during comparison
		--copy-dest # Implies --compare-dest but also copies files from paths into destination
		--cutoff-mode # Mode to stop transfers when reaching the max transfer limit HARD|SOFT|CAUTIOUS (default HARD)
		--ignore-case-sync @bool # Ignore case when synchronizing
		--ignore-checksum @bool # Skip post copy check of checksums
		--ignore-existing @bool # Skip all files that exist on destination
		--ignore-size @bool # Ignore size when skipping use modtime or checksum
		--ignore-times|-I @bool # Don't skip items that match size and time - transfer all unconditionally
		--immutable @bool # Do not modify files, fail if existing files have been modified
		--inplace @bool # Download directly to destination file instead of atomic download to temp/rename
		--links|-l @bool # Translate symlinks to/from regular files with a '.rclonelink' extension
		--max-backlog # Maximum number of objects in sync or check backlog (default 10000)
		--max-duration # Maximum duration rclone will transfer data for (default 0s)
		--max-transfer # Maximum size of data to transfer (default off)
		--metadata|-M @bool # If set, preserve metadata when copying objects
		--modify-window # Max time diff to be considered the same (default 1ns)
		--multi-thread-chunk-size # Chunk size for multi-thread downloads / uploads, if not set by filesystem (default 64Mi)
		--multi-thread-cutoff # Use multi-thread downloads for files above this size (default 256Mi)
		--multi-thread-streams # Number of streams to use for multi-thread downloads (default 4)
		--multi-thread-write-buffer-size # In memory buffer size for writing when in multi-thread mode (default 128Ki)
		--name-transform # Transform paths during the copy process
		--no-check-dest @bool # Don't check the destination, copy regardless
		--no-traverse @bool # Don't traverse destination file system on copy
		--no-update-dir-modtime @bool # Don't update directory modification times
		--no-update-modtime @bool # Don't update destination modtime if files identical
		--order-by # Instructions on how to order the transfers, e.g. 'size,descending'
		--partial-suffix # Add partial-suffix to temporary file name when --inplace is not used (default ".partial")
		--refresh-times @bool # Refresh the modtime of remote files
		--server-side-across-configs @bool # Allow server-side operations (e.g. copy) to work across different configs
		--size-only @bool # Skip based on size only, not modtime or checksum
		--streaming-upload-cutoff # Cutoff for switching to chunked upload if file size is unknown, upload starts after reaching cutoff or when file ends (default 100Ki)
		--update|-u @bool # Skip files that are newer on the destination
		--backup-dir # Make backups into hierarchy based in DIR
		--delete-after @bool # When synchronizing, delete files on destination after transferring (default)
		--delete-before @bool # When synchronizing, delete files on destination before transferring
		--delete-during @bool # When synchronizing, delete files during transfer
		--fix-case @bool # Force rename of case insensitive dest to match source
		--ignore-errors @bool # Delete even if there are I/O errors
		--list-cutoff # To save memory, sort directory listings on disk above this threshold (default 1000000)
		--max-delete # When synchronizing, limit the number of deletes (default -1)
		--max-delete-size # When synchronizing, limit the total size of deletes (default off)
		--suffix # Suffix to add to changed files
		--suffix-keep-extension @bool # Preserve the extension when using --suffix
		--track-renames @bool # When synchronizing, track file renames and do a server-side move if possible
		--track-renames-strategy # Strategies to use when synchronizing using track-renames hash|modtime|leaf (default "hash")
		--dry-run|-n @bool # Do a trial run with no permanent changes
		--interactive|-i @bool # Enable interactive mode
		--verbose|-v # Print lots more stuff (repeat for more)
		--delete-excluded @bool # Delete files on dest excluded from sync
		--exclude # Exclude files matching pattern
		--exclude-from # Read file exclude patterns from file (use - to read from stdin)
		--exclude-if-present # Exclude directories if filename is present
		--files-from # Read list of source-file names from file (use - to read from stdin)
		--files-from-raw # Read list of source-file names from file without any processing of lines (use - to read from stdin)
		--filter|-f # Add a file filtering rule
		--filter-from # Read file filtering patterns from a file (use - to read from stdin)
		--hash-filter # Partition filenames by hash k/n or randomly @/n
		--ignore-case @bool # Ignore case in filters (case insensitive)
		--include # Include files matching pattern
		--include-from # Read file include patterns from file (use - to read from stdin)
		--max-age # Only transfer files younger than this in s or suffix ms|s|m|h|d|w|M|y (default off)
		--max-depth # If set limits the recursion depth to this (default -1)
		--max-size # Only transfer files smaller than this in KiB or suffix B|K|M|G|T|P (default off)
		--metadata-exclude # Exclude metadatas matching pattern
		--metadata-exclude-from # Read metadata exclude patterns from file (use - to read from stdin)
		--metadata-filter # Add a metadata filtering rule
		--metadata-filter-from # Read metadata filtering patterns from a file (use - to read from stdin)
		--metadata-include # Include metadatas matching pattern
		--metadata-include-from # Read metadata include patterns from file (use - to read from stdin)
		--min-age # Only transfer files older than this in s or suffix ms|s|m|h|d|w|M|y (default off)
		--min-size # Only transfer files bigger than this in KiB or suffix B|K|M|G|T|P (default off)
		--default-time # Time to show if modtime is unknown for files and directories (default 2000-01-01T00:00:00Z)
		--fast-list @bool # Use recursive list if available; uses more memory but fewer transactions
	test # Run a test command
		histogram
		info
			--all @bool # Run all tests
			--check-base32768 @bool # Check can store all possible base32768 characters
			--check-control @bool # Check control characters
			--check-length @bool # Check max filename length
			--check-normalization @bool # Check UTF-8 Normalization
			--check-streaming @bool # Check uploads with indeterminate file size
			--keep-test-files @bool # Keep test files after execution
			--upload-wait # Wait after writing a file (default 0s)
			--write-json # Write results to file
		makefile
			--ascii @bool # Fill files with random ASCII printable bytes only
			--chargen @bool # Fill files with a ASCII chargen pattern
			--pattern @bool # Fill files with a periodic pattern
			--seed # Seed for the random number generator (0 for random) (default 1)
			--sparse @bool # Make the files sparse (appear to be filled with ASCII 0x00)
			--zero @bool # Fill files with ASCII 0x00
		makefiles
			--ascii @bool # Fill files with random ASCII printable bytes only
			--chargen @bool # Fill files with a ASCII chargen pattern
			--files # Number of files to create (default 1000)
			--files-per-directory # Average number of files per directory (default 10)
			--flat @bool # If set create all files in the root directory
			--max-depth # Maximum depth of directory hierarchy (default 10)
			--max-file-size # Maximum size of files to create (default 100)
			--max-name-length # Maximum size of file names (default 12)
			--min-file-size # Minimum size of file to create
			--min-name-length # Minimum size of file names (default 4)
			--pattern @bool # Fill files with a periodic pattern
			--seed # Seed for the random number generator (0 for random) (default 1)
			--sparse @bool # Make the files sparse (appear to be filled with ASCII 0x00)
			--zero @bool # Fill files with ASCII 0x00
		memory
		speed
			--ascii @bool # Fill files with random ASCII printable bytes only
			--chargen @bool # Fill files with a ASCII chargen pattern
			--file-cap # Maximum number of files to use in each test (default 100)
			--json @bool # Output only results in JSON format
			--large # Size of large files (default 1Gi)
			--medium # Size of medium files (default 10Mi)
			--pattern @bool # Fill files with a periodic pattern
			--seed # Seed for the random number generator (0 for random) (default 1)
			--small # Size of small files (default 1Ki)
			--sparse @bool # Make the files sparse (appear to be filled with ASCII 0x00)
			--test-time # Length for each test to run (default 15s)
			--zero @bool # Fill files with ASCII 0x00
	touch # Create new file or change file modification time.
		--localtime @bool # Use localtime for timestamp, not UTC
