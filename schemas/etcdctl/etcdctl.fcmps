etcdctl # etcd client
	--cacert @bool # verify certificates of TLS-enabled secure servers using this CA bundle
	--cert # identify secure client using this TLS certificate file
	--command-timeout @bool # timeout for short running command (excluding dial timeout)
	--debug @bool # enable client-side debug logging
	--dial-timeout @bool # dial timeout for client connections
	--discovery-srv # domain name to query for SRV records describing cluster endpoints
	--discovery-srv-name # service name to query when using DNS discovery
	--endpoints # gRPC endpoints
	--help @bool # help for etcdctl
	--hex # print byte strings as hex encoded strings
	--insecure-discovery # accept insecure SRV records describing cluster endpoints
	--insecure-skip-tls-verify @bool # skip server certificate verification (CAUTION: this option should be enabled only for testing purposes)
	--insecure-transport @bool # disable transport security for client connections
	--keepalive-time @bool # keepalive time for client connections
	--keepalive-timeout @bool # keepalive timeout for client connections
	--key # identify secure client using this TLS key file
	--max-recv-bytes # client-side response receive limit in bytes (if 0, it defaults to "math.MaxInt32")
	--max-request-bytes @bool # client-side request send limit in bytes (if 0, it defaults to 2.0 MiB (2 * 1024 * 1024).)
	--password @bool # password for authentication (if this option is used, --user option shouldn't include password)
	--user # username[:password] for authentication (prompt if password is not supplied)
	--write-out @bool # set the output format (fields, json, protobuf, simple, table)
