		--warnings-as-errors @bool # Treat warnings received from the server as errors and exit with a non-zero exit code
		--all @bool # Select all resources in the namespace of the specified resource types.
		--allow-missing-template-keys @bool # If true, ignore any errors in templates when a field or map key is missing in the template. Only applies to golang and jsonpath output formats.
		--cascade @bool # Must be "background", "orphan", or "foreground". Selects the deletion cascading strategy for the dependents (e.g. Pods created by a ReplicationController). Defaults to background.
		--dry-run @bool # Must be "none", "server", or "client". If client strategy, only print the object that would be sent, without sending it. If server strategy, submit server-side request without persisting the resource.
		--field-manager @bool # Name of the manager used to track field ownership.
		--filename @bool # The files that contain the configurations to apply.
		--force @bool # If true, immediately remove resources from API and bypass graceful deletion. Note that immediate deletion of some resources may result in inconsistency or data loss and requires confirmation.
		--force-conflicts @bool # If true, server-side apply will force the changes against conflicts.
		--grace-period @bool # Period of time in seconds given to the resource to terminate gracefully. Ignored if negative. Set to 1 for immediate shutdown. Can only be set to 0 when --force is true (force deletion).
		--kustomize @bool # Process a kustomization directory. This flag can't be used together with -f or -R.
		--openapi-patch @bool # If true, use openapi to calculate diff when the openapi presents and the resource can be found in the openapi spec. Otherwise, fall back to use baked-in types.
		--output @bool # Output format. One of: (json, yaml, kyaml, name, go-template, go-template-file, template, templatefile, jsonpath, jsonpath-as-json, jsonpath-file).
		--overwrite @bool # Automatically resolve conflicts between the modified and live configuration by using values from the modified configuration
		--prune @bool # Automatically delete resource objects, that do not appear in the configs and are created by either apply or create --save-config. Should be used with either -l or --all.
		--prune-allowlist @bool # Overwrite the default allowlist with <group/version/kind> for --prune
		--recursive @bool # Process the directory used in -f, --filename recursively. Useful when you want to manage related manifests organized within the same directory.
		--selector @bool # Selector (label query) to filter on, supports '=', '==', '!=', 'in', 'notin'.(e.g. -l key1=value1,key2=value2,key3 in (value3)). Matching objects must satisfy all of the specified label constraints.
		--server-side @bool # If true, apply runs in the server instead of the client.
		--show-managed-fields @bool # If true, keep the managedFields when printing objects in JSON or YAML format.
