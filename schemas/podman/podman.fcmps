			--group-add # add additional groups to the primary container process. 'keep-groups' allows container processes to use supplementary groups.
			--hooks-dir # set the OCI hooks directory path (may be set multiple times)
			--http-proxy @bool # pass through HTTP Proxy environment variables
			--identity-label @bool # add default identity label
			--ignorefile # path to an alternate .dockerignore file
			--iidfile # `file` to write the image ID to
			--inherit-annotations @bool # inherit the annotations from the base image or base stages.
			--inherit-labels @bool # inherit the labels from the base image or base stages.
			--ipc # 'private', `path` of IPC namespace to join, or 'host'
			--isolation # `type` of process isolation to use. Use BUILDAH_ISOLATION environment variable to override.
			--jobs # how many stages to run in parallel
			--label # set metadata for an image (default [])
			--layer-label # set metadata for an intermediate image (default [])
			--layers @bool # use intermediate layers during build. Use BUILDAH_LAYERS environment variable to override.
			--local @bool # Build image on local machine as well as on farm nodes
			--logfile # log to `file` instead of stdout/stderr
			--memory # memory limit (format: <number>[<unit>], where unit = b, k, m or g)
			--memory-swap # swap limit equal to memory plus swap: '-1' to enable unlimited swap
			--network # 'private', 'none', 'ns:path' of network namespace to join, or 'host'
			--no-cache @bool # do not use existing cached images for the container build. Build from the start with a new set of cached layers.
			--no-hostname @bool # do not create new /etc/hostname file for RUN instructions, use the one from the base image.
			--no-hosts @bool # do not create new /etc/hosts file for RUN instructions, use the one from the base image.
			--omit-history @bool # omit build history information from built image
			--os-feature # set required OS `feature` for the target image in addition to values from the base image
			--os-version # set required OS `version` for the target image instead of the value from the base image
			--pid # private, `path` of PID namespace to join, or 'host'
			--platforms # Build only on farm nodes that match the given platforms
			--pull # Pull image policy ("always"|"missing"|"never"|"newer")
			--quiet @bool # refrain from announcing build instructions and image read/write progress
			--retry # number of times to retry in case of failure when performing push/pull
			--retry-delay # delay between retries in case of push/pull failures
			--rewrite-timestamp @bool # set timestamps in layers to no later than the value for --source-date-epoch
			--rm @bool # remove intermediate containers after a successful build
			--runtime-flag # add global flags for the container runtime
			--sbom # scan working container using `preset` configuration
			--sbom-image-output # add scan results to image as `path`
			--sbom-image-purl-output # add scan results to image as `path`
			--sbom-merge-strategy # merge scan results using `strategy`
			--sbom-output # save scan results to `file`
			--sbom-purl-output # save scan results to `file``
			--sbom-scanner-command # scan working container using `command` in scanner image
			--sbom-scanner-image # scan working container using scanner command from `image`
			--secret # secret file to expose to the build
			--security-opt # security options (default [])
			--shm-size # size of '/dev/shm'. The format is `<number><unit>`.
			--skip-unused-stages @bool # skips stages in multi-stage builds which do not affect the final target
			--source-date-epoch # set new timestamps in image info to `seconds` after the epoch, defaults to current time
			--squash @bool # squash all image layers into a single layer
			--squash-all @bool # Squash all layers into a single layer
			--ssh # SSH agent socket or keys to expose to the build. (format: default|<id>[=<socket>|<key>[,<key>]])
			--tag # tagged `name` to apply to the built image
			--target # set the target build stage to build
			--timestamp # set new timestamps in image info and layer to `seconds` after the epoch, defaults to current times
			--tls-verify @bool # require HTTPS and verify certificates when accessing the registry
			--ulimit # ulimit options
			--unsetannotation # unset annotation when inheriting annotations from base image
			--unsetenv # unset environment variable from final image
			--unsetlabel # unset label when inheriting labels from base image
			--userns # 'container', `path` of user namespace to join, or 'host'
			--userns-gid-map # `containerGID:hostGID:length` GID mapping to use in user namespace
			--userns-gid-map-group # `name` of entries from /etc/subgid to use to set user namespace GID mapping
			--userns-uid-map # `containerUID:hostUID:length` UID mapping to use in user namespace
			--userns-uid-map-user # `name` of entries from /etc/subuid to use to set user namespace UID mapping
			--uts # private, :`path` of UTS namespace to join, or 'host'
			--volume # bind mount a volume into the container
