# Podman CLI schema for fast-completer
# Generated from podman 5.8.0

podman # Container management tool
	--config # Path to directory containing authentication config file
	--connection # Connection to use for remote Podman service (CONTAINER_CONNECTION)
	--help @bool # Help for podman
	--identity # path to SSH identity file, (CONTAINER_SSHKEY)
	--log-level # Log messages above specified level (trace, debug, info, warn, warning, error, fatal, panic)
	--out # Send output (stdout) from podman to a file
	--ssh # define the ssh mode
	--storage-opt # Used to pass an option to the storage driver
	--tls-ca # path to TLS certificate Authority PEM file for remote.
	--tls-cert # path to TLS client certificate PEM file for remote.
	--tls-key # path to TLS client certificate private key PEM file for remote.
	--url # URL to access Podman service (CONTAINER_HOST)
	--version @bool # version for podman
	artifact # Manage OCI artifacts
		add # Add an OCI artifact to the local store
			--annotation # set an `annotation` for the specified files of artifact
			--append @bool # Append files to an existing artifact
			--file-type # Set file type to use for the artifact (layer)
			--replace @bool # Replace an existing artifact
			--type # Use type to describe an artifact
		extract # Extract an OCI artifact to a local path
			--digest # Only extract blob with the given digest
			--title # Only extract blob with the given title
		inspect # Inspect an OCI artifact
			--format # Format volume output using JSON or a Go template
		ls # List OCI artifacts
			--format # Format volume output using JSON or a Go template
			--no-trunc @bool # Do not truncate output
			--noheading @bool # Do not print column headings
		pull # Pull an OCI artifact
			--authfile # Path of the authentication file. Use REGISTRY_AUTH_FILE environment variable to override
			--creds # `Credentials` (USERNAME:PASSWORD) to use for authenticating to a registry
			--quiet @bool # Suppress output information when pulling images
			--retry # number of times to retry in case of failure when performing pull
			--retry-delay # delay between retries in case of pull failures
			--tls-verify @bool # Require HTTPS and verify certificates when contacting registries
		push # Push an OCI artifact
			--authfile # Path of the authentication file. Use REGISTRY_AUTH_FILE environment variable to override
			--creds # `Credentials` (USERNAME:PASSWORD) to use for authenticating to a registry
			--digestfile # Write the digest of the pushed image to the specified file
			--retry # number of times to retry in case of failure when performing push
			--retry-delay # delay between retries in case of push failures
			--tls-verify @bool # Require HTTPS and verify certificates when contacting registries
		rm # Remove one or more OCI artifacts
			--all @bool # Remove all artifacts
			--ignore @bool # Ignore error if artifact does not exist
	attach # Attach to a running container
		--detach-keys # Select the key sequence for detaching a container. Format is a single character `[a-Z]` or a comma separated sequence of `ctrl-<value>`, where `<value>` is one of: `a-z`, `@`, `^`, `[`, `\`, `]`, `^` or `_`
		--no-stdin @bool # Do not attach STDIN. The default is false
		--sig-proxy @bool # Proxy received signals to the process
	build # Build an image using instructions from Containerfiles
		--add-host # add a custom host-to-IP mapping (`host:ip`) (default [])
		--all-platforms @bool # attempt to build for all base image platforms
		--annotation # set metadata for an image (default [])
		--arch # set the ARCH of the image to the provided value instead of the architecture of the host
		--authfile # path of the authentication file.
		--build-arg # `argument=value` to supply to the builder
		--build-arg-file # `argfile.conf` containing lines of argument=value to supply to the builder
		--build-context # `argument=value` to supply additional build context to the builder
		--cache-from # remote repository list to utilise as potential cache source.
		--cache-to # remote repository list to utilise as potential cache destination.
		--cache-ttl # only consider cache images under specified duration.
		--cap-add # add the specified capability when running (default [])
		--cap-drop # drop the specified capability when running (default [])
		--cert-dir # use certificates at the specified path to access the registry
		--cgroup-parent # optional parent cgroup for the container
		--cgroupns # 'private', or 'host'
		--compat-volumes @bool # preserve the contents of VOLUMEs during RUN instructions
		--cpp-flag # set additional flag to pass to C preprocessor (cpp)
		--cpu-period # limit the CPU CFS (Completely Fair Scheduler) period
		--cpu-quota # limit the CPU CFS (Completely Fair Scheduler) quota
		--cpu-shares # CPU shares (relative weight)
		--cpuset-cpus # CPUs in which to allow execution (0-3, 0,1)
		--cpuset-mems # memory nodes (MEMs) in which to allow execution (0-3, 0,1). Only effective on NUMA systems.
		--created-annotation @bool # set an "org.opencontainers.image.created" annotation in the image
		--creds # use `[username[:password]]` for accessing the registry
		--decryption-key # key needed to decrypt the image
		--device # additional devices to provide
		--disable-compression @bool # don't compress layers by default
		--dns # set custom DNS servers or disable it completely by setting it to 'none', which prevents the automatic creation of `/etc/resolv.conf`.
		--dns-option # set custom DNS options
		--dns-search # set custom DNS search domains
		--env # set environment variable for the image
		--file @bool # `pathname or URL` of a Dockerfile
		--force-rm @bool # always remove intermediate containers after a build, even if the build is unsuccessful.
		--format # `format` of the built image's manifest and metadata. Use BUILDAH_FORMAT environment variable to override.
		--from # image name used to replace the value in the first FROM instruction in the Containerfile
		--group-add # add additional groups to the primary container process. 'keep-groups' allows container processes to use supplementary groups.
		--hooks-dir # set the OCI hooks directory path (may be set multiple times)
		--http-proxy @bool # pass through HTTP Proxy environment variables
		--identity-label @bool # add default identity label
		--ignorefile # path to an alternate .dockerignore file
		--iidfile # `file` to write the image ID to
		--inherit-annotations @bool # inherit the annotations from the base image or base stages.
		--inherit-labels @bool # inherit the labels from the base image or base stages.
		--ipc # 'private', `path` of IPC namespace to join, or 'host'
		--isolation # `type` of process isolation to use. Use BUILDAH_ISOLATION environment variable to override.
		--jobs # how many stages to run in parallel
		--label # set metadata for an image (default [])
		--layer-label # set metadata for an intermediate image (default [])
		--layers @bool # use intermediate layers during build. Use BUILDAH_LAYERS environment variable to override.
		--logfile # log to `file` instead of stdout/stderr
		--manifest # add the image to the specified manifest list. Creates manifest list if it does not exist
		--memory # memory limit (format: <number>[<unit>], where unit = b, k, m or g)
		--memory-swap # swap limit equal to memory plus swap: '-1' to enable unlimited swap
		--network # 'private', 'none', 'ns:path' of network namespace to join, or 'host'
		--no-cache @bool # do not use existing cached images for the container build. Build from the start with a new set of cached layers.
		--no-hostname @bool # do not create new /etc/hostname file for RUN instructions, use the one from the base image.
		--no-hosts @bool # do not create new /etc/hosts file for RUN instructions, use the one from the base image.
		--omit-history @bool # omit build history information from built image
		--os # set the OS to the provided value instead of the current operating system of the host
		--os-feature # set required OS `feature` for the target image in addition to values from the base image
		--os-version # set required OS `version` for the target image instead of the value from the base image
		--pid # private, `path` of PID namespace to join, or 'host'
		--platform # set the `OS/ARCH[/VARIANT]` of the image to the provided value instead of the current operating system and architecture of the host (for example "linux/arm")
		--pull # Pull image policy ("always"|"missing"|"never"|"newer")
		--quiet @bool # refrain from announcing build instructions and image read/write progress
		--retry # number of times to retry in case of failure when performing push/pull
		--retry-delay # delay between retries in case of push/pull failures
		--rewrite-timestamp @bool # set timestamps in layers to no later than the value for --source-date-epoch
		--rm @bool # remove intermediate containers after a successful build
		--runtime-flag # add global flags for the container runtime
		--sbom # scan working container using `preset` configuration
		--sbom-image-output # add scan results to image as `path`
		--sbom-image-purl-output # add scan results to image as `path`
		--sbom-merge-strategy # merge scan results using `strategy`
		--sbom-output # save scan results to `file`
		--sbom-purl-output # save scan results to `file``
		--sbom-scanner-command # scan working container using `command` in scanner image
		--sbom-scanner-image # scan working container using scanner command from `image`
		--secret # secret file to expose to the build
		--security-opt # security options (default [])
		--shm-size # size of '/dev/shm'. The format is `<number><unit>`.
		--skip-unused-stages @bool # skips stages in multi-stage builds which do not affect the final target
		--source-date-epoch # set new timestamps in image info to `seconds` after the epoch, defaults to current time
		--squash @bool # squash all image layers into a single layer
		--squash-all @bool # Squash all layers into a single layer
		--ssh # SSH agent socket or keys to expose to the build. (format: default|<id>[=<socket>|<key>[,<key>]])
		--stdin @bool # pass stdin into containers
		--tag # tagged `name` to apply to the built image
		--target # set the target build stage to build
		--timestamp # set new timestamps in image info and layer to `seconds` after the epoch, defaults to current times
		--ulimit # ulimit options
		--unsetannotation # unset annotation when inheriting annotations from base image
		--unsetenv # unset environment variable from final image
		--unsetlabel # unset label when inheriting labels from base image
		--userns # 'container', `path` of user namespace to join, or 'host'
		--userns-gid-map # `containerGID:hostGID:length` GID mapping to use in user namespace
		--userns-gid-map-group # `name` of entries from /etc/subgid to use to set user namespace GID mapping
		--userns-uid-map # `containerUID:hostUID:length` UID mapping to use in user namespace
		--userns-uid-map-user # `name` of entries from /etc/subuid to use to set user namespace UID mapping
		--uts # private, :`path` of UTS namespace to join, or 'host'
		--variant # override the `variant` of the specified image
		--volume # bind mount a volume into the container
	commit # Create new image based on the changed container
		--author # Set the author for the image committed
		--change # Apply the following possible instructions to the created image (default []): CMD | ENTRYPOINT | ENV | EXPOSE | LABEL | ONBUILD | STOPSIGNAL | USER | VOLUME | WORKDIR
		--config # `file` containing a container configuration to merge into the image
		--format # `Format` of the image manifest and metadata
		--iidfile # `file` to write the image ID to
		--include-volumes @bool # Include container volumes as image volumes
		--message # Set commit message for imported image
		--pause @bool # Pause container during commit
		--quiet @bool # Suppress output
		--squash @bool # squash newly built layers into a single new layer
	compose # Run compose workloads via an external provider such as docker-compose or podman-compose
		--all-resources @bool # Include all resources, even those not used by services
		--ansi @bool # Control when to print ANSI control characters ("never"|"always"|"auto")
		--compatibility @bool # Run compose in backward compatibility mode
		--dry-run @bool # Execute command in dry run mode
		--env-file @bool # Specify an alternate environment file
		--file @bool # Compose configuration files
		--parallel @bool # Control max parallelism, -1 for unlimited
		--profile @bool # Specify a profile to enable
		--progress @bool # Set type of progress output (auto, tty, plain, json, quiet)
		--project-directory @bool # Specify an alternate working directory
		--project-name @bool # Project name
		attach # Attach local standard input, output, and error streams to a service's running container
			--dry-run @bool # Execute command in dry run mode
			--detach-keys @bool # Override the key sequence for detaching from a container.
			--index @bool # index of the container if service has multiple replicas.
			--no-stdin @bool # Do not attach STDIN
			--sig-proxy @bool # Proxy all received signals to the process
		bridge # Convert compose files into another model
			--dry-run @bool # Execute command in dry run mode
			convert # Convert compose files to Kubernetes manifests, Helm charts, or another model
				--dry-run @bool # Execute command in dry run mode
				--output @bool # The output directory for the Kubernetes resources
				--templates @bool # Directory containing transformation templates
				--transformation @bool # Transformation to apply to compose model (default: docker/compose-bridge-kubernetes)
			transformations # Manage transformation images
				--dry-run @bool # Execute command in dry run mode
				create # Create a new transformation
					--dry-run @bool # Execute command in dry run mode
					--from @bool # Existing transformation to copy (default: docker/compose-bridge-kubernetes)
				list # List available transformations
					--dry-run @bool # Execute command in dry run mode
					--format @bool # Format the output. Values: [table | json]
					--quiet @bool # Only display transformer names
		build # Build or rebuild services
			--dry-run @bool # Execute command in dry run mode
			--build-arg @bool # Set build-time variables for services
			--builder @bool # Set builder to use
			--check @bool # Check build configuration
			--memory @bool # Set memory limit for the build container. Not supported by BuildKit.
			--no-cache @bool # Do not use cache when building the image
			--print @bool # Print equivalent bake file
			--provenance @bool # Add a provenance attestation
			--pull @bool # Always attempt to pull a newer version of the image
			--push @bool # Push service images
			--quiet @bool # Suppress the build output
			--sbom @bool # Add a SBOM attestation
			--ssh @bool # Set SSH authentications used when building service images. (use 'default' for using your default SSH Agent)
			--with-dependencies @bool # Also build dependencies (transitively)
		commit # Create a new image from a service container's changes
			--dry-run @bool # Execute command in dry run mode
			--author @bool # Author (e.g., "John Hannibal Smith <hannibal@a-team.com>")
			--change @bool # Apply Dockerfile instruction to the created image
			--index @bool # index of the container if service has multiple replicas.
			--message @bool # Commit message
			--pause @bool # Pause container during commit
		config # Parse, resolve and render compose file in canonical format
			--dry-run @bool # Execute command in dry run mode
			--environment @bool # Print environment used for interpolation.
			--format @bool # Format the output. Values: [yaml | json]
			--hash @bool # Print the service config hash, one per line.
			--images @bool # Print the image names, one per line.
			--lock-image-digests @bool # Produces an override file with image digests
			--models @bool # Print the model names, one per line.
			--networks @bool # Print the network names, one per line.
			--no-consistency @bool # Don't check model consistency - warning: may produce invalid Compose output
			--no-env-resolution @bool # Don't resolve service env files
			--no-interpolate @bool # Don't interpolate environment variables
			--no-normalize @bool # Don't normalize compose model
			--no-path-resolution @bool # Don't resolve file paths
			--output @bool # Save to file (default to stdout)
			--profiles @bool # Print the profile names, one per line.
			--quiet @bool # Only validate the configuration, don't print anything
			--resolve-image-digests @bool # Pin image tags to digests
			--services @bool # Print the service names, one per line.
			--variables @bool # Print model variables and default values.
			--volumes @bool # Print the volume names, one per line.
		cp # Copy files/folders between a service container and the local filesystem
			--dry-run @bool # Execute command in dry run mode
			--all @bool # Include containers created by the run command
			--archive @bool # Archive mode (copy all uid/gid information)
			--follow-link @bool # Always follow symbol link in SRC_PATH
			--index @bool # Index of the container if service has multiple replicas
		create # Creates containers for a service
			--dry-run @bool # Execute command in dry run mode
			--build @bool # Build images before starting containers
			--force-recreate @bool # Recreate containers even if their configuration and image haven't changed
			--no-build @bool # Don't build an image, even if it's policy
			--no-recreate @bool # If containers already exist, don't recreate them. Incompatible with --force-recreate.
			--pull @bool # Pull image before running ("always"|"missing"|"never"|"build")
			--quiet-pull @bool # Pull without printing progress information
			--remove-orphans @bool # Remove containers for services not defined in the Compose file
			--scale @bool # Scale SERVICE to NUM instances. Overrides the `scale` setting in the Compose file if present.
			--yes @bool # Assume "yes" as answer to all prompts and run non-interactively
		down # Stop and remove containers, networks
			--dry-run @bool # Execute command in dry run mode
			--remove-orphans @bool # Remove containers for services not defined in the Compose file
			--rmi @bool # Remove images used by services. "local" remove only images that don't have a custom tag ("local"|"all")
			--timeout @bool # Specify a shutdown timeout in seconds
			--volumes @bool # Remove named volumes declared in the "volumes" section of the Compose file and anonymous volumes attached to containers
		events # Receive real time events from containers
			--dry-run @bool # Execute command in dry run mode
			--json @bool # Output events as a stream of json objects
			--since @bool # Show all events created since timestamp
			--until @bool # Stream events until this timestamp
		exec # Execute a command in a running container
			--dry-run @bool # Execute command in dry run mode
			--detach @bool # Detached mode: Run command in the background
			--env @bool # Set environment variables
			--index @bool # Index of the container if service has multiple replicas
			--no-tty @bool # Disable pseudo-TTY allocation. By default 'docker compose exec' allocates a TTY.
			--privileged @bool # Give extended privileges to the process
			--user @bool # Run the command as this user
			--workdir @bool # Path to workdir directory for this command
		export # Export a service container's filesystem as a tar archive
			--dry-run @bool # Execute command in dry run mode
			--index @bool # index of the container if service has multiple replicas.
			--output @bool # Write to a file, instead of STDOUT
		images # List images used by the created containers
			--dry-run @bool # Execute command in dry run mode
			--format @bool # Format the output. Values: [table | json]
			--quiet @bool # Only display IDs
		kill # Force stop service containers
			--dry-run @bool # Execute command in dry run mode
			--remove-orphans @bool # Remove containers for services not defined in the Compose file
			--signal @bool # SIGNAL to send to the container
		logs # View output from containers
			--dry-run @bool # Execute command in dry run mode
			--follow @bool # Follow log output
			--index @bool # index of the container if service has multiple replicas
			--no-color @bool # Produce monochrome output
			--no-log-prefix @bool # Don't print prefix in logs
			--since @bool # Show logs since timestamp (e.g. 2013-01-02T13:23:37Z) or relative (e.g. 42m for 42 minutes)
			--tail @bool # Number of lines to show from the end of the logs for each container
			--timestamps @bool # Show timestamps
			--until @bool # Show logs before a timestamp (e.g. 2013-01-02T13:23:37Z) or relative (e.g. 42m for 42 minutes)
		ls # List running compose projects
			--dry-run @bool # Execute command in dry run mode
			--all @bool # Show all stopped Compose projects
			--filter @bool # Filter output based on conditions provided
			--format @bool # Format the output. Values: [table | json]
			--quiet @bool # Only display project names
		pause # Pause services
			--dry-run @bool # Execute command in dry run mode
		port # Print the public port for a port binding
			--dry-run @bool # Execute command in dry run mode
			--index @bool # Index of the container if service has multiple replicas
			--protocol @bool # tcp or udp
		ps # List containers
			--dry-run @bool # Execute command in dry run mode
			--all @bool # Show all stopped containers (including those created by the run command)
			--filter @bool # Filter services by a property (supported filters: status)
			--format @bool # Format output using a custom template:
			--no-trunc @bool # Don't truncate output
			--orphans @bool # Include orphaned services (not declared by project)
			--quiet @bool # Only display IDs
			--services @bool # Display services
			--status @bool # Filter services by status. Values: [paused | restarting | removing | running | dead | created | exited]
		publish # Publish compose application
			--dry-run @bool # Execute command in dry run mode
			--app @bool # Published compose application (includes referenced images)
			--oci-version @bool # OCI image/artifact specification version (automatically determined by default)
			--resolve-image-digests @bool # Pin image tags to digests
			--with-env @bool # Include environment variables in the published OCI artifact
			--yes @bool # Assume "yes" as answer to all prompts
		pull # Pull service images
			--dry-run @bool # Execute command in dry run mode
			--ignore-buildable @bool # Ignore images that can be built
			--ignore-pull-failures @bool # Pull what it can and ignores images with pull failures
			--include-deps @bool # Also pull services declared as dependencies
			--policy @bool # Apply pull policy ("missing"|"always")
			--quiet @bool # Pull without printing progress information
		push # Push service images
			--dry-run @bool # Execute command in dry run mode
			--ignore-push-failures @bool # Push what it can and ignores images with push failures
			--include-deps @bool # Also push images of services declared as dependencies
			--quiet @bool # Push without printing progress information
		restart # Restart service containers
			--dry-run @bool # Execute command in dry run mode
			--no-deps @bool # Don't restart dependent services
			--timeout @bool # Specify a shutdown timeout in seconds
		rm # Removes stopped service containers
			--dry-run @bool # Execute command in dry run mode
			--force @bool # Don't ask to confirm removal
			--stop @bool # Stop the containers, if required, before removing
			--volumes @bool # Remove any anonymous volumes attached to containers
		run # Run a one-off command on a service
			--dry-run @bool # Execute command in dry run mode
			--build @bool # Build image before starting container
			--cap-add @bool # Add Linux capabilities
			--cap-drop @bool # Drop Linux capabilities
			--detach @bool # Run container in background and print container ID
			--entrypoint @bool # Override the entrypoint of the image
			--env @bool # Set environment variables
			--env-from-file @bool # Set environment variables from file
			--interactive @bool # Keep STDIN open even if not attached
			--label @bool # Add or override a label
			--name @bool # Assign a name to the container
			--no-TTY @bool # Disable pseudo-TTY allocation (default: auto-detected)
			--no-deps @bool # Don't start linked services
			--publish @bool # Publish a container's port(s) to the host
			--pull @bool # Pull image before running ("always"|"missing"|"never")
			--quiet @bool # Don't print anything to STDOUT
			--quiet-build @bool # Suppress progress output from the build process
			--quiet-pull @bool # Pull without printing progress information
			--remove-orphans @bool # Remove containers for services not defined in the Compose file
			--rm @bool # Automatically remove the container when it exits
			--service-ports @bool # Run command with all service's ports enabled and mapped to the host
			--use-aliases @bool # Use the service's network useAliases in the network(s) the container connects to
			--user @bool # Run as specified username or uid
			--volume @bool # Bind mount a volume
			--workdir @bool # Working directory inside the container
		scale # Scale services
			--dry-run @bool # Execute command in dry run mode
			--no-deps @bool # Don't start linked services
		start # Start services
			--dry-run @bool # Execute command in dry run mode
			--wait @bool # Wait for services to be running|healthy. Implies detached mode.
			--wait-timeout @bool # Maximum duration in seconds to wait for the project to be running|healthy
		stats # Display a live stream of container(s) resource usage statistics
			--dry-run @bool # Execute command in dry run mode
			--all @bool # Show all containers (default shows just running)
			--format @bool # Format output using a custom template:
			--no-stream @bool # Disable streaming stats and only pull the first result
			--no-trunc @bool # Do not truncate output
		stop # Stop services
			--dry-run @bool # Execute command in dry run mode
			--timeout @bool # Specify a shutdown timeout in seconds
		top # Display the running processes
			--dry-run @bool # Execute command in dry run mode
		unpause # Unpause services
			--dry-run @bool # Execute command in dry run mode
		up # Create and start containers
			--dry-run @bool # Execute command in dry run mode
			--abort-on-container-exit @bool # Stops all containers if any container was stopped. Incompatible with -d
			--abort-on-container-failure @bool # Stops all containers if any container exited with failure. Incompatible with -d
			--always-recreate-deps @bool # Recreate dependent containers. Incompatible with --no-recreate.
			--attach @bool # Restrict attaching to the specified services. Incompatible with --attach-dependencies.
			--attach-dependencies @bool # Automatically attach to log output of dependent services
			--build @bool # Build images before starting containers
			--detach @bool # Detached mode: Run containers in the background
			--exit-code-from @bool # Return the exit code of the selected service container. Implies --abort-on-container-exit
			--force-recreate @bool # Recreate containers even if their configuration and image haven't changed
			--menu @bool # Enable interactive shortcuts when running attached. Incompatible with --detach. Can also be enable/disable by setting COMPOSE_MENU environment var.
			--no-attach @bool # Do not attach (stream logs) to the specified services
			--no-build @bool # Don't build an image, even if it's policy
			--no-color @bool # Produce monochrome output
			--no-deps @bool # Don't start linked services
			--no-log-prefix @bool # Don't print prefix in logs
			--no-recreate @bool # If containers already exist, don't recreate them. Incompatible with --force-recreate.
			--no-start @bool # Don't start the services after creating them
			--pull @bool # Pull image before running ("always"|"missing"|"never")
			--quiet-build @bool # Suppress the build output
			--quiet-pull @bool # Pull without printing progress information
			--remove-orphans @bool # Remove containers for services not defined in the Compose file
