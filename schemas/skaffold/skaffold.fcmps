# Skaffold CLI schema for fast-completer
# Generated from skaffold unknown

skaffold # Kubernetes development workflow
	--color @bool # Specify the default output color in ANSI escape codes
	--help @bool # help for skaffold
	--interactive @bool # Allow user prompts for more information
	--timestamps # Print timestamps in logs
	--update-check @bool # Check for a more recent version of Skaffold
	--verbosity @bool # Log level: one of [panic fatal error warning info debug trace]
	apply # Apply hydrated manifests to a cluster
		--color @bool # Specify the default output color in ANSI escape codes
		--interactive @bool # Allow user prompts for more information
		--timestamps @bool # Print timestamps in logs
		--update-check @bool # Check for a more recent version of Skaffold
		--verbosity @bool # Log level: one of [panic fatal error warning info debug trace]
		--assume-yes @bool # If true, skaffold will skip yes/no confirmation from the user and default to yes
		--cloud-run-location @bool # The GCP Region to deploy Cloud Run services to
		--cloud-run-project @bool # The GCP Project ID or Project Number to deploy for Cloud Run
		--config @bool # File for global configurations (defaults to $HOME/.skaffold/config)
		--filename @bool # Path or URL to the Skaffold config file
		--force @bool # Recreate Kubernetes resources if necessary for deployment, warning: might cause downtime!
		--iterative-status-check @bool # Run `status-check` iteratively after each deploy step, instead of all-together at the end of all deploys (default).
		--kube-context @bool # Deploy to this Kubernetes context
		--kubeconfig @bool # Path to the kubeconfig file to use for CLI requests.
		--label @bool # Add custom labels to deployed objects. Set multiple times for multiple labels
		--module @bool # Filter Skaffold configs to only the provided named modules
		--namespace @bool # Runs deployments in the specified namespace. When used with 'render' command, renders manifests contain the namespace
		--profile @bool # Activate profiles by name (prefixed with `-` to disable a profile)
		--remote-cache-dir @bool # Specify the location of the remote cache (default $HOME/.skaffold/remote-cache)
		--rpc-http-port @bool # tcp port to expose the Skaffold API over HTTP REST
		--rpc-port @bool # tcp port to expose the Skaffold API over gRPC
		--status-check @bool # Wait for deployed resources to stabilize
		--status-check-selectors @bool # File containing resource selectors for kubernetes resources status check. A sample file looks like the following:
		--sync-remote-cache @bool # Controls how Skaffold manages the remote config cache (see `remote-cache-dir`). One of `always` (default), `missing`, or `never`. `always` syncs remote repositories to latest on access. `missing` only clones remote repositories if they do not exist locally. `never` means the user takes responsibility for updating remote repositories.
		--tail @bool # Stream logs from deployed objects
		--tolerate-failures-until-deadline @bool # Configures `status-check` to tolerate failures until Skaffold's statusCheckDeadline duration or the deployments progressDeadlineSeconds  Otherwise deployment failures skaffold encounters will immediately fail the deployment.  Defaults to 'false'
		--wait-for-connection @bool # Blocks ending execution of skaffold until the /v2/events gRPC/HTTP endpoint is hit
	build # Build the artifacts
		--color @bool # Specify the default output color in ANSI escape codes
		--interactive @bool # Allow user prompts for more information
		--timestamps @bool # Print timestamps in logs
		--update-check @bool # Check for a more recent version of Skaffold
		--verbosity @bool # Log level: one of [panic fatal error warning info debug trace]
		--assume-yes @bool # If true, skaffold will skip yes/no confirmation from the user and default to yes
		--build-concurrency @bool # Number of concurrently running builds. Set to 0 to run all builds in parallel. Doesn't violate build order among dependencies.
		--build-image @bool # Only build artifacts with image names that contain the given substring. Default is to build sources for all artifacts
		--cache-artifacts @bool # Set to false to disable default caching of artifacts
		--cache-file @bool # Specify the location of the cache file (default $HOME/.skaffold/cache)
		--check-cluster-node-platforms @bool # When set to true, images are built for the target platforms matching the active kubernetes cluster node platforms. Enabled by default for `dev`, `debug` and `run`
		--config @bool # File for global configurations (defaults to $HOME/.skaffold/config)
		--default-repo @bool # Default repository value (overrides global config)
		--detect-minikube @bool # Use heuristics to detect a minikube cluster
		--disable-multi-platform-build @bool # When set to true, forces only single platform image builds even when multiple target platforms are specified. Enabled by default for `dev` and `debug` modes, to keep dev-loop fast
		--dry-run @bool # Don't build images, just compute the tag for each artifact.
		--file-output @bool # Filename to write build images to
		--filename @bool # Path or URL to the Skaffold config file
		--insecure-registry @bool # Target registries for built images which are not secure
		--kube-context @bool # Deploy to this Kubernetes context
		--kubeconfig @bool # Path to the kubeconfig file to use for CLI requests.
		--module @bool # Filter Skaffold configs to only the provided named modules
		--mute-logs @bool # mute logs for specified stages in pipeline (build, deploy, status-check, none, all)
		--namespace @bool # Runs deployments in the specified namespace. When used with 'render' command, renders manifests contain the namespace
		--output @bool # Used in conjunction with --quiet flag. Format output with go-template. For full struct documentation, see https://godoc.org/github.com/GoogleContainerTools/skaffold/v2/cmd/skaffold/app/flags#BuildOutput
		--platform @bool # The platform to target for the build artifacts
		--profile @bool # Activate profiles by name (prefixed with `-` to disable a profile)
		--profile-auto-activation @bool # Set to false to disable profile auto activation
		--propagate-profiles @bool # Setting '--propagate-profiles=false' disables propagating profiles set by the '--profile' flag across config dependencies. This mean that only profiles defined directly in the target 'skaffold.yaml' file are activated.
		--push @bool # Push the built images to the specified image repository.
		--quiet @bool # Suppress the build output and print image built on success. See --output to format output.
		--remote-cache-dir @bool # Specify the location of the remote cache (default $HOME/.skaffold/remote-cache)
		--rpc-http-port @bool # tcp port to expose the Skaffold API over HTTP REST
		--rpc-port @bool # tcp port to expose the Skaffold API over gRPC
		--skip-tests @bool # Whether to skip the tests after building
		--sync-remote-cache @bool # Controls how Skaffold manages the remote config cache (see `remote-cache-dir`). One of `always` (default), `missing`, or `never`. `always` syncs remote repositories to latest on access. `missing` only clones remote repositories if they do not exist locally. `never` means the user takes responsibility for updating remote repositories.
		--tag @bool # The optional custom tag to use for images which overrides the current Tagger configuration
		--toot @bool # Emit a terminal beep after the deploy is complete
		--wait-for-connection @bool # Blocks ending execution of skaffold until the /v2/events gRPC/HTTP endpoint is hit
