		--remote-cache-dir @bool # Specify the location of the remote cache (default $HOME/.skaffold/remote-cache)
		--resource-selector-rules-file @bool # Path to JSON file specifying the deny list of yaml objects for skaffold to NOT transform with 'image' and 'label' field replacements.  NOTE: this list is additive to skaffold's default denylist and denylist has priority over allowlist
