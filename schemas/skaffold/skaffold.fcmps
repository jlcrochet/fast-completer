		--build-artifacts @bool # File containing pre-built images to use instead of rebuilding artifacts. A sample file looks like the following:
		--cache-artifacts @bool # Set to false to disable default caching of artifacts
		--default-repo @bool # Default repository value (overrides global config)
		--digest-source @bool # Set to 'remote' to skip builds and resolve the digest of images by tag from the remote registry. Set to 'local' to build images locally and use digests from built images. Set to 'tag' to use tags directly from the build. Set to 'none' to use tags directly from the Kubernetes manifests. If unspecified, defaults to 'remote' for remote clusters, and 'tag' for local clusters like kind or minikube.
		--enable-platform-node-affinity @bool # If true, when deploying to a mixed node cluster, skaffold will add platform (os/arch) node affinity definition to rendered manifests based on the image platforms
		--filename @bool # Path or URL to the Skaffold config file
		--hydration-dir @bool # The directory to where the (kpt) hydration takes place. Default to a hidden directory .kpt-pipeline.
		--images @bool # A list of pre-built images to deploy, either tagged images or NAME=TAG pairs
		--label @bool # Add custom labels to deployed objects. Set multiple times for multiple labels
		--loud @bool # Show the build logs and output
		--module @bool # Filter Skaffold configs to only the provided named modules
		--namespace @bool # Runs deployments in the specified namespace. When used with 'render' command, renders manifests contain the namespace
		--offline @bool # Do not connect to Kubernetes API server for manifest creation and validation. This is helpful when no Kubernetes cluster is available (e.g. GitOps model). No metadata.namespace attribute is injected in this case - the manifest content does not get changed.
		--output @bool # File to write rendered manifests to
