# Docker CLI schema for fast-completer
# Generated from docker 29.2.1

docker # Docker CLI
	--config # Location of client config files
	--context # Name of the context to use to connect to the daemon (overrides DOCKER_HOST env var and default context set with "docker context use")
	--debug @bool # Enable debug mode
	--host # Daemon socket to connect to
	--log-level # Set the logging level ("debug", "info", "warn", "error", "fatal")
	--tls @bool # Use TLS; implied by --tlsverify
	--tlscacert # Trust certs signed only by this CA
	--tlscert # Path to TLS certificate file
	--tlskey # Path to TLS key file
	--tlsverify @bool # Use TLS and verify the remote
	--version @bool # Print version information and quit
	attach # Attach local standard input, output, and error streams to a running container
		--detach-keys # Override the key sequence for detaching a container
		--no-stdin @bool # Do not attach STDIN
		--sig-proxy @bool # Proxy all received signals to the process
	bake # Build from a file
	build # Build an image from a Dockerfile
		--add-host # Add a custom host-to-IP mapping ("host:ip")
		--build-arg # Set build-time variables
		--cache-from # Images to consider as cache sources
		--cgroup-parent # Set the parent cgroup for the "RUN" instructions during build
		--compress @bool # Compress the build context using gzip
		--cpu-period # Limit the CPU CFS (Completely Fair Scheduler) period
		--cpu-quota # Limit the CPU CFS (Completely Fair Scheduler) quota
		--cpu-shares # CPU shares (relative weight)
		--cpuset-cpus # CPUs in which to allow execution (0-3, 0,1)
		--cpuset-mems # MEMs in which to allow execution (0-3, 0,1)
		--file # Name of the Dockerfile (Default is "PATH/Dockerfile")
		--force-rm @bool # Always remove intermediate containers
		--iidfile # Write the image ID to the file
		--isolation # Container isolation technology
		--label # Set metadata for an image
		--memory # Memory limit
		--memory-swap # Swap limit equal to memory plus swap: -1 to enable unlimited swap
		--network # Set the networking mode for the RUN instructions during build
		--no-cache @bool # Do not use cache when building the image
		--platform # Set platform if server is multi-platform capable
		--pull @bool # Always attempt to pull a newer version of the image
		--quiet @bool # Suppress the build output and print image ID on success
		--rm @bool # Remove intermediate containers after a successful build
		--security-opt # Security options
		--shm-size # Size of "/dev/shm"
		--squash @bool # Squash newly built layers into a single new layer
		--tag # Name and optionally a tag in the "name:tag" format
		--target # Set the target build stage to build.
		--ulimit # Ulimit options
	builder # Manage builds
		build # Build an image from a Dockerfile
			--add-host # Add a custom host-to-IP mapping ("host:ip")
			--build-arg # Set build-time variables
			--cache-from # Images to consider as cache sources
			--cgroup-parent # Set the parent cgroup for the "RUN" instructions during build
			--compress @bool # Compress the build context using gzip
			--cpu-period # Limit the CPU CFS (Completely Fair Scheduler) period
			--cpu-quota # Limit the CPU CFS (Completely Fair Scheduler) quota
			--cpu-shares # CPU shares (relative weight)
			--cpuset-cpus # CPUs in which to allow execution (0-3, 0,1)
			--cpuset-mems # MEMs in which to allow execution (0-3, 0,1)
			--file # Name of the Dockerfile (Default is "PATH/Dockerfile")
			--force-rm @bool # Always remove intermediate containers
			--iidfile # Write the image ID to the file
			--isolation # Container isolation technology
			--label # Set metadata for an image
			--memory # Memory limit
			--memory-swap # Swap limit equal to memory plus swap: -1 to enable unlimited swap
			--network # Set the networking mode for the RUN instructions during build
			--no-cache @bool # Do not use cache when building the image
			--platform # Set platform if server is multi-platform capable
			--pull @bool # Always attempt to pull a newer version of the image
			--quiet @bool # Suppress the build output and print image ID on success
			--rm @bool # Remove intermediate containers after a successful build
			--security-opt # Security options
			--shm-size # Size of "/dev/shm"
			--squash @bool # Squash newly built layers into a single new layer
			--tag # Name and optionally a tag in the "name:tag" format
			--target # Set the target build stage to build.
			--ulimit # Ulimit options
		prune # Remove build cache
			--all @bool # Remove all unused build cache, not just dangling ones
			--filter # Provide filter values (e.g. "until=24h")
			--force @bool # Do not prompt for confirmation
			--keep-storage # Amount of disk space to keep for cache
	checkpoint # Manage checkpoints
		create # Create a checkpoint from a running container
			--checkpoint-dir # Use a custom checkpoint storage directory
			--leave-running @bool # Leave the container running after checkpoint
		ls # List checkpoints for a container
			--checkpoint-dir # Use a custom checkpoint storage directory
		rm # Remove a checkpoint
			--checkpoint-dir # Use a custom checkpoint storage directory
	commit # Create a new image from a container's changes
		--author # Author (e.g., "John Hannibal Smith <hannibal@a-team.com>")
		--change # Apply Dockerfile instruction to the created image
		--message # Commit message
		--no-pause @bool # Disable pausing container during commit
	compose # Docker Compose
		--all-resources @bool # Include all resources, even those not used by services
		--ansi # Control when to print ANSI control characters ("never"|"always"|"auto")
		--compatibility @bool # Run compose in backward compatibility mode
		--dry-run @bool # Execute command in dry run mode
		--env-file # Specify an alternate environment file
		--file # Compose configuration files
		--parallel # Control max parallelism, -1 for unlimited
		--profile # Specify a profile to enable
		--progress # Set type of progress output (auto, tty, plain, json, quiet)
		--project-directory # Specify an alternate working directory
		--project-name # Project name
		attach # Attach local standard input, output, and error streams to a service's running container
			--dry-run @bool # Execute command in dry run mode
			--detach-keys # Override the key sequence for detaching from a container.
			--index # index of the container if service has multiple replicas.
			--no-stdin @bool # Do not attach STDIN
			--sig-proxy @bool # Proxy all received signals to the process
		bridge # Convert compose files into another model
			--dry-run @bool # Execute command in dry run mode
			convert # Convert compose files to Kubernetes manifests, Helm charts, or another model
				--dry-run @bool # Execute command in dry run mode
				--output # The output directory for the Kubernetes resources
				--templates # Directory containing transformation templates
				--transformation # Transformation to apply to compose model (default: docker/compose-bridge-kubernetes)
			transformations # Manage transformation images
				--dry-run @bool # Execute command in dry run mode
				create # Create a new transformation
					--dry-run @bool # Execute command in dry run mode
					--from # Existing transformation to copy (default: docker/compose-bridge-kubernetes)
				list # List available transformations
					--dry-run @bool # Execute command in dry run mode
					--format # Format the output. Values: [table | json]
					--quiet @bool # Only display transformer names
		build # Build or rebuild services
			--dry-run @bool # Execute command in dry run mode
			--build-arg # Set build-time variables for services
			--builder # Set builder to use
			--check @bool # Check build configuration
			--memory # Set memory limit for the build container. Not supported by BuildKit.
			--no-cache @bool # Do not use cache when building the image
			--print @bool # Print equivalent bake file
			--provenance # Add a provenance attestation
			--pull @bool # Always attempt to pull a newer version of the image
			--push @bool # Push service images
			--quiet @bool # Suppress the build output
			--sbom # Add a SBOM attestation
			--ssh # Set SSH authentications used when building service images. (use 'default' for using your default SSH Agent)
			--with-dependencies @bool # Also build dependencies (transitively)
		commit # Create a new image from a service container's changes
			--dry-run @bool # Execute command in dry run mode
			--author # Author (e.g., "John Hannibal Smith <hannibal@a-team.com>")
			--change # Apply Dockerfile instruction to the created image
			--index # index of the container if service has multiple replicas.
			--message # Commit message
			--pause @bool # Pause container during commit
		config # Parse, resolve and render compose file in canonical format
			--dry-run @bool # Execute command in dry run mode
			--environment @bool # Print environment used for interpolation.
			--format # Format the output. Values: [yaml | json]
			--hash # Print the service config hash, one per line.
			--images @bool # Print the image names, one per line.
			--lock-image-digests @bool # Produces an override file with image digests
			--models @bool # Print the model names, one per line.
			--networks @bool # Print the network names, one per line.
			--no-consistency @bool # Don't check model consistency - warning: may produce invalid Compose output
			--no-env-resolution @bool # Don't resolve service env files
			--no-interpolate @bool # Don't interpolate environment variables
			--no-normalize @bool # Don't normalize compose model
			--no-path-resolution @bool # Don't resolve file paths
			--output # Save to file (default to stdout)
			--profiles @bool # Print the profile names, one per line.
			--quiet @bool # Only validate the configuration, don't print anything
			--resolve-image-digests @bool # Pin image tags to digests
			--services @bool # Print the service names, one per line.
			--variables @bool # Print model variables and default values.
			--volumes @bool # Print the volume names, one per line.
		cp # Copy files/folders between a service container and the local filesystem
			--dry-run @bool # Execute command in dry run mode
			--all @bool # Include containers created by the run command
			--archive @bool # Archive mode (copy all uid/gid information)
			--follow-link @bool # Always follow symbol link in SRC_PATH
			--index # Index of the container if service has multiple replicas
		create # Creates containers for a service
			--dry-run @bool # Execute command in dry run mode
			--build @bool # Build images before starting containers
			--force-recreate @bool # Recreate containers even if their configuration and image haven't changed
			--no-build @bool # Don't build an image, even if it's policy
			--no-recreate @bool # If containers already exist, don't recreate them. Incompatible with --force-recreate.
			--pull # Pull image before running ("always"|"missing"|"never"|"build")
			--quiet-pull @bool # Pull without printing progress information
			--remove-orphans @bool # Remove containers for services not defined in the Compose file
			--scale # Scale SERVICE to NUM instances. Overrides the `scale` setting in the Compose file if present.
			--yes @bool # Assume "yes" as answer to all prompts and run non-interactively
		down # Stop and remove containers, networks
			--dry-run @bool # Execute command in dry run mode
			--remove-orphans @bool # Remove containers for services not defined in the Compose file
			--rmi # Remove images used by services. "local" remove only images that don't have a custom tag ("local"|"all")
			--timeout # Specify a shutdown timeout in seconds
			--volumes @bool # Remove named volumes declared in the "volumes" section of the Compose file and anonymous volumes attached to containers
		events # Receive real time events from containers
			--dry-run @bool # Execute command in dry run mode
			--json @bool # Output events as a stream of json objects
			--since # Show all events created since timestamp
			--until # Stream events until this timestamp
		exec # Execute a command in a running container
			--dry-run @bool # Execute command in dry run mode
			--detach @bool # Detached mode: Run command in the background
			--env # Set environment variables
			--index # Index of the container if service has multiple replicas
			--no-tty @bool # Disable pseudo-TTY allocation. By default 'docker compose exec' allocates a TTY.
			--privileged @bool # Give extended privileges to the process
			--user # Run the command as this user
			--workdir # Path to workdir directory for this command
		export # Export a service container's filesystem as a tar archive
			--dry-run @bool # Execute command in dry run mode
			--index # index of the container if service has multiple replicas.
			--output # Write to a file, instead of STDOUT
		images # List images used by the created containers
			--dry-run @bool # Execute command in dry run mode
			--format # Format the output. Values: [table | json]
			--quiet @bool # Only display IDs
		kill # Force stop service containers
			--dry-run @bool # Execute command in dry run mode
			--remove-orphans @bool # Remove containers for services not defined in the Compose file
			--signal # SIGNAL to send to the container
		logs # View output from containers
			--dry-run @bool # Execute command in dry run mode
			--follow @bool # Follow log output
			--index # index of the container if service has multiple replicas
			--no-color @bool # Produce monochrome output
			--no-log-prefix @bool # Don't print prefix in logs
			--since # Show logs since timestamp (e.g. 2013-01-02T13:23:37Z) or relative (e.g. 42m for 42 minutes)
			--tail # Number of lines to show from the end of the logs for each container
			--timestamps @bool # Show timestamps
			--until # Show logs before a timestamp (e.g. 2013-01-02T13:23:37Z) or relative (e.g. 42m for 42 minutes)
		ls # List running compose projects
			--dry-run @bool # Execute command in dry run mode
			--all @bool # Show all stopped Compose projects
			--filter # Filter output based on conditions provided
			--format # Format the output. Values: [table | json]
			--quiet @bool # Only display project names
		pause # Pause services
			--dry-run @bool # Execute command in dry run mode
		port # Print the public port for a port binding
			--dry-run @bool # Execute command in dry run mode
			--index # Index of the container if service has multiple replicas
			--protocol # tcp or udp
		ps # List containers
			--dry-run @bool # Execute command in dry run mode
			--all @bool # Show all stopped containers (including those created by the run command)
			--filter # Filter services by a property (supported filters: status)
			--format # Format output using a custom template:
			--no-trunc @bool # Don't truncate output
			--orphans @bool # Include orphaned services (not declared by project)
			--quiet @bool # Only display IDs
			--services @bool # Display services
			--status # Filter services by status. Values: [paused | restarting | removing | running | dead | created | exited]
		publish # Publish compose application
			--dry-run @bool # Execute command in dry run mode
			--app @bool # Published compose application (includes referenced images)
			--oci-version # OCI image/artifact specification version (automatically determined by default)
			--resolve-image-digests @bool # Pin image tags to digests
			--with-env @bool # Include environment variables in the published OCI artifact
			--yes @bool # Assume "yes" as answer to all prompts
		pull # Pull service images
			--dry-run @bool # Execute command in dry run mode
			--ignore-buildable @bool # Ignore images that can be built
			--ignore-pull-failures @bool # Pull what it can and ignores images with pull failures
			--include-deps @bool # Also pull services declared as dependencies
			--policy # Apply pull policy ("missing"|"always")
			--quiet @bool # Pull without printing progress information
		push # Push service images
			--dry-run @bool # Execute command in dry run mode
			--ignore-push-failures @bool # Push what it can and ignores images with push failures
			--include-deps @bool # Also push images of services declared as dependencies
			--quiet @bool # Push without printing progress information
		restart # Restart service containers
			--dry-run @bool # Execute command in dry run mode
			--no-deps @bool # Don't restart dependent services
			--timeout # Specify a shutdown timeout in seconds
		rm # Removes stopped service containers
			--dry-run @bool # Execute command in dry run mode
			--force @bool # Don't ask to confirm removal
			--stop @bool # Stop the containers, if required, before removing
			--volumes @bool # Remove any anonymous volumes attached to containers
		run # Run a one-off command on a service
			--dry-run @bool # Execute command in dry run mode
			--build @bool # Build image before starting container
			--cap-add # Add Linux capabilities
			--cap-drop # Drop Linux capabilities
			--detach @bool # Run container in background and print container ID
			--entrypoint # Override the entrypoint of the image
			--env # Set environment variables
			--env-from-file # Set environment variables from file
			--interactive @bool # Keep STDIN open even if not attached
			--label # Add or override a label
			--name # Assign a name to the container
			--no-TTY @bool # Disable pseudo-TTY allocation (default: auto-detected)
			--no-deps @bool # Don't start linked services
			--publish # Publish a container's port(s) to the host
			--pull # Pull image before running ("always"|"missing"|"never")
			--quiet @bool # Don't print anything to STDOUT
			--quiet-build @bool # Suppress progress output from the build process
			--quiet-pull @bool # Pull without printing progress information
			--remove-orphans @bool # Remove containers for services not defined in the Compose file
			--rm @bool # Automatically remove the container when it exits
			--service-ports @bool # Run command with all service's ports enabled and mapped to the host
			--use-aliases @bool # Use the service's network useAliases in the network(s) the container connects to
			--user # Run as specified username or uid
			--volume # Bind mount a volume
			--workdir # Working directory inside the container
		scale # Scale services
			--dry-run @bool # Execute command in dry run mode
			--no-deps @bool # Don't start linked services
		start # Start services
			--dry-run @bool # Execute command in dry run mode
			--wait @bool # Wait for services to be running|healthy. Implies detached mode.
			--wait-timeout # Maximum duration in seconds to wait for the project to be running|healthy
		stats # Display a live stream of container(s) resource usage statistics
			--dry-run @bool # Execute command in dry run mode
			--all @bool # Show all containers (default shows just running)
			--format # Format output using a custom template:
			--no-stream @bool # Disable streaming stats and only pull the first result
			--no-trunc @bool # Do not truncate output
		stop # Stop services
			--dry-run @bool # Execute command in dry run mode
			--timeout # Specify a shutdown timeout in seconds
		top # Display the running processes
			--dry-run @bool # Execute command in dry run mode
		unpause # Unpause services
			--dry-run @bool # Execute command in dry run mode
		up # Create and start containers
			--dry-run @bool # Execute command in dry run mode
			--abort-on-container-exit @bool # Stops all containers if any container was stopped. Incompatible with -d
			--abort-on-container-failure @bool # Stops all containers if any container exited with failure. Incompatible with -d
			--always-recreate-deps @bool # Recreate dependent containers. Incompatible with --no-recreate.
			--attach # Restrict attaching to the specified services. Incompatible with --attach-dependencies.
			--attach-dependencies @bool # Automatically attach to log output of dependent services
			--build @bool # Build images before starting containers
			--detach @bool # Detached mode: Run containers in the background
			--exit-code-from # Return the exit code of the selected service container. Implies --abort-on-container-exit
			--force-recreate @bool # Recreate containers even if their configuration and image haven't changed
			--menu @bool # Enable interactive shortcuts when running attached. Incompatible with --detach. Can also be enable/disable by setting COMPOSE_MENU environment var.
			--no-attach # Do not attach (stream logs) to the specified services
			--no-build @bool # Don't build an image, even if it's policy
			--no-color @bool # Produce monochrome output
			--no-deps @bool # Don't start linked services
			--no-log-prefix @bool # Don't print prefix in logs
			--no-recreate @bool # If containers already exist, don't recreate them. Incompatible with --force-recreate.
			--no-start @bool # Don't start the services after creating them
			--pull # Pull image before running ("always"|"missing"|"never")
			--quiet-build @bool # Suppress the build output
			--quiet-pull @bool # Pull without printing progress information
			--remove-orphans @bool # Remove containers for services not defined in the Compose file
			--renew-anon-volumes @bool # Recreate anonymous volumes instead of retrieving data from the previous containers
			--scale # Scale SERVICE to NUM instances. Overrides the `scale` setting in the Compose file if present.
			--timeout # Use this timeout in seconds for container shutdown when attached or when containers are already running
			--timestamps @bool # Show timestamps
			--wait @bool # Wait for services to be running|healthy. Implies detached mode.
			--wait-timeout # Maximum duration in seconds to wait for the project to be running|healthy
			--watch @bool # Watch source code and rebuild/refresh containers when files are updated.
			--yes @bool # Assume "yes" as answer to all prompts and run non-interactively
		version # Show the Docker Compose version information
			--dry-run @bool # Execute command in dry run mode
			--format # Format the output. Values: [pretty | json]. (Default: pretty)
			--short @bool # Shows only Compose's version number
		volumes # List volumes
			--dry-run @bool # Execute command in dry run mode
			--format # Format output using a custom template:
			--quiet @bool # Only display volume names
		wait # Block until containers of all (or specified) services stop.
			--dry-run @bool # Execute command in dry run mode
			--down-project @bool # Drops project when the first container stops
		watch # Watch build context for service and rebuild/refresh containers when files are updated
			--dry-run @bool # Execute command in dry run mode
			--no-up @bool # Do not build & start services before watching
			--prune @bool # Prune dangling images on rebuild
			--quiet @bool # hide build output
	config # Manage Swarm configs
		create # Create a config from a file or STDIN
			--label # Config labels
			--template-driver # Template driver
		inspect # Display detailed information on one or more configs
			--format # Format output using a custom template:
			--pretty @bool # Print the information in a human friendly format
		ls # List configs
			--filter # Filter output based on conditions provided
			--format # Format output using a custom template:
			--quiet @bool # Only display IDs
		rm # Remove one or more configs
	container # Manage containers
		attach # Attach local standard input, output, and error streams to a running container
			--detach-keys # Override the key sequence for detaching a container
			--no-stdin @bool # Do not attach STDIN
			--sig-proxy @bool # Proxy all received signals to the process
		commit # Create a new image from a container's changes
			--author # Author (e.g., "John Hannibal Smith <hannibal@a-team.com>")
			--change # Apply Dockerfile instruction to the created image
			--message # Commit message
			--no-pause @bool # Disable pausing container during commit
		cp # Copy files/folders between a container and the local filesystem
			--archive @bool # Archive mode (copy all uid/gid information)
			--follow-link @bool # Always follow symbol link in SRC_PATH
			--quiet @bool # Suppress progress output during copy. Progress output is automatically suppressed if no terminal is attached
		create # Create a new container
			--add-host # Add a custom host-to-IP mapping (host:ip)
			--annotation # Add an annotation to the container (passed through to the OCI runtime)
			--attach # Attach to STDIN, STDOUT or STDERR
			--blkio-weight # Block IO (relative weight), between 10 and 1000, or 0 to disable (default 0)
			--blkio-weight-device # Block IO weight (relative device weight)
			--cap-add # Add Linux capabilities
			--cap-drop # Drop Linux capabilities
			--cgroup-parent # Optional parent cgroup for the container
			--cgroupns # Cgroup namespace to use (host|private)
			--cidfile # Write the container ID to the file
			--cpu-count # CPU count (Windows only)
			--cpu-percent # CPU percent (Windows only)
			--cpu-period # Limit CPU CFS (Completely Fair Scheduler) period
			--cpu-quota # Limit CPU CFS (Completely Fair Scheduler) quota
			--cpu-rt-period # Limit CPU real-time period in microseconds
			--cpu-rt-runtime # Limit CPU real-time runtime in microseconds
			--cpu-shares # CPU shares (relative weight)
			--cpus # Number of CPUs
			--cpuset-cpus # CPUs in which to allow execution (0-3, 0,1)
			--cpuset-mems # MEMs in which to allow execution (0-3, 0,1)
			--device # Add a host device to the container
			--device-cgroup-rule # Add a rule to the cgroup allowed devices list
			--device-read-bps # Limit read rate (bytes per second) from a device
			--device-read-iops # Limit read rate (IO per second) from a device
			--device-write-bps # Limit write rate (bytes per second) to a device
			--device-write-iops # Limit write rate (IO per second) to a device
			--dns # Set custom DNS servers
			--dns-option # Set DNS options
			--dns-search # Set custom DNS search domains
			--domainname # Container NIS domain name
			--entrypoint # Overwrite the default ENTRYPOINT of the image
			--env # Set environment variables
			--env-file # Read in a file of environment variables
			--expose # Expose a port or a range of ports
			--gpus # GPU devices to add to the container ('all' to pass all GPUs)
			--group-add # Add additional groups to join
			--health-cmd # Command to run to check health
			--health-interval # Time between running the check (ms|s|m|h) (default 0s)
			--health-retries # Consecutive failures needed to report unhealthy
			--health-start-interval # Time between running the check during the start period (ms|s|m|h) (default 0s)
			--health-start-period # Start period for the container to initialize before starting health-retries countdown (ms|s|m|h) (default 0s)
			--health-timeout # Maximum time to allow one check to run (ms|s|m|h) (default 0s)
			--hostname # Container host name
			--init @bool # Run an init inside the container that forwards signals and reaps processes
			--interactive @bool # Keep STDIN open even if not attached
			--io-maxbandwidth # Maximum IO bandwidth limit for the system drive (Windows only)
			--io-maxiops # Maximum IOps limit for the system drive (Windows only)
			--ip # IPv4 address (e.g., 172.30.100.104)
			--ip6 # IPv6 address (e.g., 2001:db8::33)
			--ipc # IPC mode to use
			--isolation # Container isolation technology
			--label # Set meta data on a container
			--label-file # Read in a line delimited file of labels
			--link # Add link to another container
			--link-local-ip # Container IPv4/IPv6 link-local addresses
			--log-driver # Logging driver for the container
			--log-opt # Log driver options
