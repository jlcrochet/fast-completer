	pkgman-to-bundle # Migrates packagemanifests to bundles
		--plugins # plugin keys to be used for this subcommand execution
		--verbose @bool # Enable verbose logging
		--build-cmd # Build command to be run for building images. By default 'docker build' is run.
		--image-tag-base # Base container image name for bundle image tags, ex. my.reg/foo/bar-operator-bundle will become my.reg/foo/bar-operator-bundle:${package-dir-name} for each child directory name in the packagemanifests directory
		--output-dir # Directory to write bundle to.
	run # Run an Operator in a variety of environments
		--plugins # plugin keys to be used for this subcommand execution
		--verbose @bool # Enable verbose logging
		bundle # Deploy an Operator in the bundle format with OLM
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
			--ca-secret-name # Name of a generic secret containing a PEM root certificate file required to pull bundle images. This secret *must* be in the namespace that this command is configured to run in, and the file *must* be encoded under the key "cert.pem"
			--decompression-image # image used in an init container in the registry pod to decompress the compressed catalog contents. cat and gzip binaries are expected to exist in the PATH
			--image-pull-policy # image pull policy for the registry pod
			--index-image # index image in which to inject bundle
			--install-mode # install mode
			--kubeconfig # Path to the kubeconfig file to use for CLI requests.
			--namespace # If present, namespace scope for this CLI request
			--pull-secret-name # Name of image pull secret ("type: kubernetes.io/dockerconfigjson") required to pull bundle images. This secret *must* be both in the namespace and an imagePullSecret of the service account that this command is configured to run in
			--security-context-config # specifies the security context to use for the catalog pod. allowed: 'restricted', 'legacy'.
			--service-account # Service account name to bind registry objects to. If unset, the default service account is used. This value does not override the operator's service account
			--skip-tls @bool # skip authentication of image registry TLS certificate when pulling a bundle image in-cluster
			--skip-tls-verify @bool # skip TLS certificate verification for container image registries while pulling bundles
			--timeout # Duration to wait for the command to complete before failing
			--use-http @bool # use plain HTTP for container image registries while pulling bundles
		bundle-upgrade # Upgrade an Operator previously installed in the bundle format with OLM
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
			--ca-secret-name # Name of a generic secret containing a PEM root certificate file required to pull bundle images. This secret *must* be in the namespace that this command is configured to run in, and the file *must* be encoded under the key "cert.pem"
			--image-pull-policy # image pull policy for the registry pod
			--kubeconfig # Path to the kubeconfig file to use for CLI requests.
			--namespace # If present, namespace scope for this CLI request
			--pull-secret-name # Name of image pull secret ("type: kubernetes.io/dockerconfigjson") required to pull bundle images. This secret *must* be both in the namespace and an imagePullSecret of the service account that this command is configured to run in
			--security-context-config # specifies the security context to use for the catalog pod. allowed: 'restricted', 'legacy'.
			--service-account # Service account name to bind registry objects to. If unset, the default service account is used. This value does not override the operator's service account
			--skip-tls @bool # skip authentication of image registry TLS certificate when pulling a bundle image in-cluster
			--skip-tls-verify @bool # skip TLS certificate verification for container image registries while pulling bundles
			--timeout # Duration to wait for the command to complete before failing
			--use-http @bool # use plain HTTP for container image registries while pulling bundles
	scorecard # Runs scorecard
		--plugins # plugin keys to be used for this subcommand execution
		--verbose @bool # Enable verbose logging
		--config # path to scorecard config file
		--kubeconfig # kubeconfig path
		--list @bool # Option to enable listing which tests are run
		--namespace # namespace to run the test images in
		--output # Output format for results. Valid values: text, json, xunit
		--pod-security # option to run scorecard with legacy pod security context
		--selector # label selector to determine which tests are run
		--service-account # Service account to use for tests
		--skip-cleanup @bool # Disable resource cleanup after tests are run
		--storage-image # Storage image to be used by the Scorecard pod
		--test-output # Test output directory.
		--untar-image # Untar image to be used by the Scorecard pod
		--wait-time # seconds to wait for tests to complete. Example: 35s
	version # Print the operator-sdk version
		--plugins # plugin keys to be used for this subcommand execution
		--verbose @bool # Enable verbose logging
