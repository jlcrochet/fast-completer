# Operator-sdk CLI schema for fast-completer
# Generated from operator-sdk .

operator-sdk # Kubernetes operator SDK
	--help @bool # help for operator-sdk
	--plugins # plugin keys to be used for this subcommand execution
	--project-version # project version
	--verbose @bool # Enable verbose logging
	alpha # Alpha-stage subcommands
		--plugins # plugin keys to be used for this subcommand execution
		--verbose @bool # Enable verbose logging
		config-3alpha-to-3 # Convert your PROJECT config file from version 3-alpha to 3
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
		generate # Re-scaffold an existing Kuberbuilder project
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
			--input-dir @bool # Specifies the full path to a Kubebuilder project file. If not provided, the current working directory is used.
			--output-dir @bool # Specifies the full path where the scaffolded files will be output. Defaults to a directory within the current working directory.
	bundle # Manage operator bundle metadata
		--plugins # plugin keys to be used for this subcommand execution
		--verbose @bool # Enable verbose logging
		validate # Validate an operator bundle
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
			--alpha-select-external # Selector to select external validators to run. It should be set to a Unix path list ("/path/to/e1.sh:/path/to/e2")
			--image-builder # Tool to pull and unpack bundle images. Only used when validating a bundle image. One of: [docker, podman, none]
			--list-optional @bool # List all optional validators available. When set, no validators will be run
			--optional-values # Inform a []string map of key=values which can be used by the validator. e.g. to check the operator bundle against an Kubernetes version that it is intended to be distributed use `--optional-values=k8s-version=1.22`
			--output # Result format for results. One of: [text, json-alpha1]. Note: output format types containing "alphaX" are subject to change and not covered by guarantees of stable APIs.
			--select-optional # Label selector to select optional validators to run. Run this command with '--list-optional' to list available optional validators
	cleanup # Clean up an Operator deployed with the 'run' subcommand
		--plugins # plugin keys to be used for this subcommand execution
		--verbose @bool # Enable verbose logging
		--delete-all @bool # If set to true, all other delete options will be enabled
		--delete-crds @bool # If set to true, owned CRDs and CRs will be deleted
		--delete-operator-groups @bool # If set to true, operator groups will be deleted
		--kubeconfig # Path to the kubeconfig file to use for CLI requests.
		--namespace # If present, namespace scope for this CLI request
		--timeout # Duration to wait for the command to complete before failing
	completion # Load completions for the specified shell
		--plugins # plugin keys to be used for this subcommand execution
		--verbose @bool # Enable verbose logging
		bash # Load bash completions
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
		fish # Load fish completions
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
		powershell # Load powershell completions
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
		zsh # Load zsh completions
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
	create # Scaffold a Kubernetes API or webhook
		--plugins # plugin keys to be used for this subcommand execution
		--verbose @bool # Enable verbose logging
		api # Scaffold a Kubernetes API
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
			--controller @bool # if set, generate the controller without prompting the user
			--external-api-domain # Specify the domain name for the external API. This domain is used to generate accurate RBAC markers and permissions for the external resources (e.g., cert-manager.io).
			--external-api-path # Specify the Go package import path for the external API. This is used to scaffold controllers for resources defined outside this project (e.g., github.com/cert-manager/cert-manager/pkg/apis/certmanager/v1).
			--force @bool # attempt to create resource even if it already exists
			--group # resource Group
			--kind # resource Kind
			--make @bool # if true, run `make generate` after generating files
			--namespaced @bool # resource is namespaced
			--plural # resource irregular plural form
			--resource @bool # if set, generate the resource without prompting the user
		webhook # Scaffold a webhook for an API resource
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
			--conversion @bool # if set, scaffold the conversion webhook
			--defaulting @bool # if set, scaffold the defaulting webhook
			--external-api-domain # Specify the domain name for the external API. This domain is used to generate accurate RBAC markers and permissions for the external resources (e.g., cert-manager.io).
			--external-api-path # Specify the Go package import path for the external API. This is used to scaffold controllers for resources defined outside this project (e.g., github.com/cert-manager/cert-manager/pkg/apis/certmanager/v1).
			--force @bool # attempt to create resource even if it already exists
			--group # resource Group
			--kind # resource Kind
			--legacy @bool # [DEPRECATED] Attempts to create resource under the API directory (legacy path). This option will be removed in future versions.
			--make @bool # if true, run `make generate` after generating files
			--plural # resource irregular plural form
			--programmatic-validation @bool # if set, scaffold the validating webhook
			--spoke # Comma-separated list of spoke versions to be added to the conversion webhook (e.g., --spoke v1,v2)
	edit # Update the project configuration
		--plugins # plugin keys to be used for this subcommand execution
		--verbose @bool # Enable verbose logging
		--multigroup @bool # enable or disable multigroup layout
	generate # Invokes a specific generator
		--plugins # plugin keys to be used for this subcommand execution
		--verbose @bool # Enable verbose logging
		bundle # Generates bundle data for the operator
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
			--channels # A comma-separated list of channels the bundle belongs to
			--crds-dir # Directory to read cluster-ready CustomResoureDefinition manifests from. This option can only be used if --deploy-dir is set
			--default-channel # The default channel for the bundle
			--deploy-dir # Directory to read cluster-ready operator manifests from. If --crds-dir is not set, CRDs are ready from this directory. This option is mutually exclusive with --input-dir and piping to stdin
			--extra-service-accounts # Names of service accounts, outside of the operator's Deployment account, that have bindings to {Cluster}Roles that should be added to the CSV
			--input-dir # Directory to read cluster-ready operator manifests from. This option is mutually exclusive with --deploy-dir/--crds-dir and piping to stdin. This option should not be passed an existing bundle directory, as this bundle will not contain the correct set of manifests required to generate a CSV. Use --kustomize-dir to pass a base CSV
			--kustomize-dir # Directory containing kustomize bases in a "bases" dir and a kustomization.yaml for operator-framework manifests
			--manifests @bool # Generate bundle manifests
			--metadata @bool # Generate bundle metadata and Dockerfile
			--output-dir # Directory to write the bundle to
			--overwrite @bool # Overwrite the bundle's metadata and Dockerfile if they exist
			--package # Bundle's package name
			--quiet @bool # Run in quiet mode
			--stdout @bool # Write bundle manifest to stdout
			--use-image-digests @bool # Use SHA Digest for images
		kustomize # Contains subcommands that generate operator-framework kustomize data for the operator
			--plugins # plugin keys to be used for this subcommand execution
			--verbose @bool # Enable verbose logging
			manifests # Generates kustomize bases and a kustomization.yaml for operator-framework manifests
				--plugins # plugin keys to be used for this subcommand execution
				--verbose @bool # Enable verbose logging
				--apis-dir # Root directory for API type defintions
				--input-dir # Directory containing existing kustomize files
				--interactive @bool # When set to false, if no kustomize base exists, an interactive command prompt will be presented to accept non-inferrable metadata
				--output-dir # Directory to write kustomize files
				--package # Package name
				--quiet @bool # Run in quiet mode
