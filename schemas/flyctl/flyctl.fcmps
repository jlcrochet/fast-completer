	launch # Create and configure a new app from source code or a Docker image
		--access-token # Fly API Access Token
		--debug @bool # Print additional logs and traces
		--verbose @bool # Verbose output
		--attach @bool # Attach this new application to the current application
		--auto-stop # Automatically suspend the app after a period of inactivity. Valid values are 'off', 'stop', and 'suspend'
		--build-arg # Set of build time variables in the form of NAME=VALUE pairs. Can be specified multiple times.
		--build-only @bool # Build but do not deploy
		--build-secret # Set of build secrets of NAME=VALUE pairs. Can be specified multiple times. See https://docs.docker.com/engine/reference/commandline/buildx_build/#secret
		--build-target # Set the target build stage to build if the Dockerfile has more than one stage
		--buildkit @bool # Deploy using buildkit-based remote builder
		--buildpacks-docker-host # Address to docker daemon that will be exposed to the build container.
		--buildpacks-volume # Mount host volume into the build container, in the form '<host path>:<target path>[:<options>]'.
		--command # The command to override the Docker CND.
		--compression # Compression algorithm to use for the image. Options are "zstd" or "gzip". Defaults to "gzip".
		--compression-level # Compression level to use for the image. Defaults to 7.
		--config # Path to application configuration file
		--copy-config @bool # Use the configuration file if present without prompting
		--db # Provision a Postgres database. Options: mpg (managed postgres), upg/legacy (unmanaged postgres), or true (default type)
		--deploy-retries # Number of times to retry a deployment if it fails
		--depot # Deploy using depot to build the image
		--depot-scope # The scope of the Depot builder's cache to use (org or app)
		--detach @bool # Return immediately instead of monitoring deployment progress
		--dns-checks @bool # Perform DNS checks during deployment
		--dockerfile # Path to a Dockerfile. Defaults to the Dockerfile in the working directory.
		--dockerignore-from-gitignore @bool # If a .dockerignore does not exist, create one from .gitignore files
		--env # Set of environment variables in the form of NAME=VALUE pairs. Can be specified multiple times.
		--exclude-machines # Deploy to all machines except machines with these IDs. Multiple IDs can be specified with comma separated values or by providing the flag multiple times.
		--exclude-regions # Deploy to all machines except machines in these regions. Multiple regions can be specified with comma separated values or by providing the flag multiple times.
		--file-literal # Set of literals in the form of /path/inside/machine=VALUE pairs where VALUE is the content. Can be specified multiple times.
		--file-local # Set of files in the form of /path/inside/machine=<local/path> pairs. Can be specified multiple times.
		--file-secret # Set of secrets in the form of /path/inside/machine=SECRET pairs where SECRET is the name of the secret. Can be specified multiple times.
		--flycast @bool # Allocate a private IPv6 addresses
		--from # A github repo URL to use as a template for the new app
		--generate-name @bool # Always generate a name for the app, without prompting
		--ha @bool # Create spare machines that increases app availability
		--host-dedication-id # The dedication id of the reserved hosts for your organization (if any)
		--https-failover @bool # Determines whether to failover to plain internet(https) communication with remote builders if wireguard fails
		--ignorefile # Path to a Docker ignore file. Defaults to the .dockerignore file in the working directory.
		--image # The Docker image to deploy
		--image-label # Image label to use when tagging and pushing to the fly registry. Defaults to "deployment-{timestamp}".
		--internal-port # Set internal_port for all services in the generated fly.toml
		--into # Destination directory for github repo specified with --from
		--json @bool # Generate configuration in JSON format
		--label # Add custom metadata to an image via docker labels
		--lease-timeout # Time duration to lease individual machines while running deployment. All machines are leased at the beginning and released at the end.The lease is refreshed periodically for this same time, which is why it is short.flyctl releases leases in most cases.
		--local-only @bool # Perform builds locally using the local docker daemon. The default is --remote-only.
		--max-concurrent # Maximum number of machines to operate on concurrently.
		--max-unavailable # Max number of unavailable machines during rolling updates. A number between 0 and 1 means percent of total machines
		--name # Name of the new app
		--nixpacks @bool # Deploy using nixpacks to build the image
		--no-cache @bool # Do not use the build cache when building the image
		--no-db @bool # Skip automatically provisioning a database
		--no-deploy @bool # Do not immediately deploy the new app after fly launch creates and configures it
		--no-github-workflow @bool # Skip automatically provisioning a GitHub fly deploy workflow
		--no-object-storage @bool # Skip automatically provisioning an object storage bucket
		--no-public-ips @bool # Do not allocate any new public IP addresses
		--no-redis @bool # Skip automatically provisioning a Redis instance
		--now @bool # Deploy now without confirmation
		--only-machines # Deploy to machines only with these IDs. Multiple IDs can be specified with comma separated values or by providing the flag multiple times.
		--org # The target Fly.io organization
		--path # Path to the app source root, where fly.toml file will be saved
		--primary-region # Override primary region in fly.toml configuration.
		--process-groups # Deploy to machines only in these process groups
		--push @bool # Push image to registry after build is complete
		--recreate-builder @bool # Recreate the builder app, if it exists
		--region # The target region (see 'flyctl platform regions')
		--regions # Deploy to machines only in these regions. Multiple regions can be specified with comma separated values or by providing the flag multiple times.
		--release-command-timeout # Time duration to wait for a release command finish running, or 'none' to disable.
		--remote-only @bool # Perform builds on a remote builder instance instead of using the local docker daemon. This is the default. Use --local-only to build locally.
		--secret # Set of secrets in the form of NAME=VALUE pairs. Can be specified multiple times.
		--signal # Signal to stop the machine with for bluegreen strategy (default: SIGINT)
		--smoke-checks @bool # Perform smoke checks during deployment
		--strategy # The strategy for replacing running instances. Options are canary, rolling, bluegreen, or immediate. The default strategy is rolling.
		--vm-cpu-kind # The kind of CPU to use ('shared' or 'performance')
		--vm-cpus # Number of CPUs
		--vm-gpu-kind # If set, the GPU model to attach (a100-pcie-40gb, a100-sxm4-80gb, l40s, a10, none)
		--vm-gpus # Number of GPUs. Must also choose the GPU model with --vm-gpu-kind flag
		--vm-memory # Memory (in megabytes) to attribute to the VM
		--vm-size # The VM size to set machines to. See "fly platform vm-sizes" for valid values
		--volume # Volume to mount, in the form of <volume_name>:/path/inside/machine[:<options>]
		--volume-initial-size # The initial size in GB for volumes created on first deploy
		--wait-timeout # Time duration to wait for individual machines to transition states and become healthy.
		--wg @bool # Determines whether communication with remote builders are conducted over wireguard or plain internet(https)
		--yaml @bool # Generate configuration in YAML format
		--yes @bool # Accept all confirmations
