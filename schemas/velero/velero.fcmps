			--access-mode @bool # Access mode for the backup storage location. Valid values are ReadWrite,ReadOnly
			--backup-sync-period # How often to ensure all Velero backups in object storage exist as Backup API objects in the cluster. Optional. Set this to `0s` to disable sync. Default: 1 minute.
			--bucket # Name of the object storage bucket where backups should be stored.
			--cacert # File containing a certificate bundle to use when verifying TLS connections to the object store. Optional.
			--config # Configuration key-value pairs.
			--credential # The credential to be used by this location as a key-value pair, where the key is the Kubernetes Secret name, and the value is the data key name within the Secret. Optional, one value only.
			--default @bool # Sets this new location to be the new default backup storage location. Optional.
			--label-columns # Accepts a comma separated list of labels that are going to be presented as columns. Names are case-sensitive. You can also use multiple flag options like -L label1 -L label2...
