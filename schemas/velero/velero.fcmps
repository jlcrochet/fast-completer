	install # Install Velero
		--add_dir_header @bool # If true, adds the file directory to the header of the log messages
		--alsologtostderr @bool # log to standard error as well as files (no effect when -logtostderr=true)
		--colorized # Show colored output in TTY. Overrides 'colorized' value from $HOME/.config/velero/config.json if present. Enabled by default
		--kubeconfig # Path to the kubeconfig file to use to talk to the Kubernetes apiserver. If unset, try the environment variable KUBECONFIG, as well as in-cluster configuration
		--kubecontext # The context to use to talk to the Kubernetes apiserver. If unset defaults to whatever your current-context is (kubectl config current-context)
		--log_backtrace_at # when logging hits line file:N, emit a stack trace
		--log_dir # If non-empty, write log files in this directory (no effect when -logtostderr=true)
		--log_file # If non-empty, use this log file (no effect when -logtostderr=true)
		--log_file_max_size # Defines the maximum size a log file can grow to (no effect when -logtostderr=true). Unit is megabytes. If the value is 0, the maximum file size is unlimited.
		--logtostderr @bool # log to standard error instead of files
		--namespace # The namespace in which Velero should operate
		--one_output @bool # If true, only write logs to their native severity level (vs also writing to each lower severity level; no effect when -logtostderr=true)
		--skip_headers @bool # If true, avoid header prefixes in the log messages
		--skip_log_headers @bool # If true, avoid headers when opening log files (no effect when -logtostderr=true)
		--stderrthreshold # logs at or above this threshold go to stderr when writing to files and stderr (no effect when -logtostderr=true or -alsologtostderr=true)
		--v # number for the log level verbosity
		--vmodule # comma-separated list of pattern=N settings for file-filtered logging
		--backup-location-config # Configuration to use for the backup storage location. Format is key1=value1,key2=value2
		--backup-repository-configmap # The name of configMap containing backup repository configurations.
		--bucket # Name of the object storage bucket where backups should be stored
		--cacert # File containing a certificate bundle to use when verifying TLS connections to the object store. Optional.
		--crds-only @bool # Only generate CustomResourceDefinition resources. Useful for updating CRDs for an existing Velero install.
		--default-repo-maintain-frequency # How often 'maintain' is run for backup repositories by default. Optional.
		--default-snapshot-move-data @bool # Bool flag to configure Velero server to move data by default for all snapshots supporting data movement. Optional.
		--default-volumes-to-fs-backup @bool # Bool flag to configure Velero server to use pod volume file system backup by default for all volumes on all backups. Optional.
		--disable-informer-cache @bool # Disable informer cache for Get calls on restore. With this enabled, it will speed up restore in cases where there are backup resources which already exist in the cluster, but for very large clusters this will increase velero memory usage. Default is false (don't disable). Optional.
		--dry-run @bool # Generate resources, but don't send them to the cluster. Use with -o. Optional.
		--features # Comma separated list of Velero feature flags to be set on the Velero deployment and the node-agent daemonset, if node-agent is enabled
		--garbage-collection-frequency # How often the garbage collection runs for expired backups.(default 1h)
		--image # Image to use for the Velero and node agent pods. Optional.
		--item-block-worker-count # Number of worker threads to process ItemBlocks. Default is one. Optional.
		--keep-latest-maintenance-jobs # Number of latest maintenance jobs to keep each repository. Optional.
		--kubelet-root-dir # Kubelet root directory for the node agent. Optional.
		--label-columns # Accepts a comma separated list of labels that are going to be presented as columns. Names are case-sensitive. You can also use multiple flag options like -L label1 -L label2...
		--maintenance-job-cpu-limit # CPU limit for maintenance jobs. Default is no limit.
		--maintenance-job-cpu-request # CPU request for maintenance jobs. Default is no limit.
		--maintenance-job-mem-limit # Memory limit for maintenance jobs. Default is no limit.
		--maintenance-job-mem-request # Memory request for maintenance jobs. Default is no limit.
		--no-default-backup-location @bool # Flag indicating if a default backup location should be created. Must be used as confirmation if --bucket or --provider are not provided. Optional.
		--no-secret @bool # Flag indicating if a secret should be created. Must be used as confirmation if --secret-file is not provided. Optional.
		--node-agent-configmap # The name of ConfigMap containing node-agent configurations.
		--node-agent-disable-host-path @bool # Don't mount the pod volume host path to node-agent. Optional. Pod volume host path mount is required by fs-backup but could be disabled for other backup methods.
		--node-agent-pod-cpu-limit # CPU limit for node-agent pod. A value of "0" is treated as unbounded. Optional.
		--node-agent-pod-cpu-request # CPU request for node-agent pod. A value of "0" is treated as unbounded. Optional.
		--node-agent-pod-mem-limit # Memory limit for node-agent pod. A value of "0" is treated as unbounded. Optional.
		--node-agent-pod-mem-request # Memory request for node-agent pod. A value of "0" is treated as unbounded. Optional.
		--node-agent-priority-class-name # Priority class name for the node agent daemonset. Optional.
		--output # Output display format. For create commands, display the object but do not send it to the server. Valid formats are 'table', 'json', and 'yaml'. 'table' is not valid for the install command.
		--plugins # Plugin container images to install into the Velero Deployment
		--pod-annotations # Annotations to add to the Velero and node agent pods. Optional. Format is key1=value1,key2=value2
		--pod-labels # Labels to add to the Velero and node agent pods. Optional. Format is key1=value1,key2=value2
		--pod-volume-operation-timeout # How long to wait for pod volume operations to complete before timing out(default 4h). Optional.
		--prefix # Prefix under which all Velero data should be stored within the bucket. Optional.
		--privileged-node-agent @bool # Use privileged mode for the node agent. Optional. Required to backup block devices.
		--provider # Provider name for backup and volume storage
		--repo-maintenance-job-configmap # The name of ConfigMap containing repository maintenance Job configurations.
		--restore-only @bool # Run the server in restore-only mode. Optional.
		--sa-annotations # Annotations to add to the Velero ServiceAccount. Add iam.gke.io/gcp-service-account=[GSA_NAME]@[PROJECT_NAME].iam.gserviceaccount.com for workload identity. Optional. Format is key1=value1,key2=value2
		--schedule-skip-immediately @bool # Skip the first scheduled backup immediately after creating a schedule. Default is false (don't skip).
		--secret-file # File containing credentials for backup and volume provider. If not specified, --no-secret must be used for confirmation. Optional.
		--server-priority-class-name # Priority class name for the Velero server deployment. Optional.
		--service-account-name # ServiceAccountName to be set to the Velero and node agent pods, it should be created before the installation, and the user also needs to create the rolebinding for it.  Optional, if this attribute is set, the default service account 'velero' will not be created, and the flag --sa-annotations will be disregarded.
		--show-labels @bool # Show labels in the last column
		--snapshot-location-config # Configuration to use for the volume snapshot location. Format is key1=value1,key2=value2
		--uploader-type # The type of uploader to transfer the data of pod volumes, supported value: 'kopia'
		--use-node-agent @bool # Create Velero node-agent daemonset. Optional. Velero node-agent hosts and associates Velero modules that need to run in one or more Linux nodes.
		--use-node-agent-windows @bool # Create Velero node-agent-windows daemonset. Optional. Velero node-agent-windows hosts and associates Velero modules that need to run in one or more Windows nodes.
		--use-volume-snapshots @bool # Whether or not to create snapshot location automatically. Set to false if you do not plan to create volume snapshots via a storage provider.
		--velero-pod-cpu-limit # CPU limit for Velero pod. A value of "0" is treated as unbounded. Optional.
		--velero-pod-cpu-request # CPU request for Velero pod. A value of "0" is treated as unbounded. Optional.
		--velero-pod-mem-limit # Memory limit for Velero pod. A value of "0" is treated as unbounded. Optional.
		--velero-pod-mem-request # Memory request for Velero pod. A value of "0" is treated as unbounded. Optional.
		--wait @bool # Wait for Velero deployment to be ready. Optional.
