# Heroku CLI schema for fast-completer
# Generated from heroku 8.7.1

heroku # Heroku CLI
	access # list who has access to an app 
		--app|-a # app to run command against
		--json @bool # output in json format
		--remote|-r # git remote of app to use
		add # add new users to your app 
			--app|-a # app to run command against
			--permissions|-p # list of permissions comma separated
			--privileges
			--remote|-r # git remote of app to use
		remove # remove users from a team app 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		update # update existing collaborators on an team app 
			--app|-a # app to run command against
			--permissions|-p # comma-delimited list of permissions to update (deploy,manage,operate)
			--privileges
			--remote|-r # git remote of app to use
	addons # lists your add-ons and attachments The default filter applied depends on whether you are in a Heroku app directory.
		--all|-A @bool # show add-ons and attachments for all accessible apps
		--app|-a # app to run command against
		--json @bool # return add-ons in json format
		--remote|-r # git remote of app to use
		attach # attach an existing add-on resource to an app 
			--app|-a # app to run command against
			--as # name for add-on attachment
			--confirm # overwrite existing add-on attachment with same name
			--credential # credential name for scoped access to Heroku Postgres
			--remote|-r # git remote of app to use
		create # create a new add-on resource 
			--app|-a # app to run command against
			--as # name for the initial add-on attachment
			--confirm # overwrite existing config vars or existing add-on attachments
			--name # name for the add-on resource
			--remote|-r # git remote of app to use
			--wait @bool # watch add-on creation status and exit when complete
		destroy # permanently destroy an add-on resource 
			--app|-a # app to run command against
			--confirm|-c
			--force|-f @bool # allow destruction even if connected to other apps
			--remote|-r # git remote of app to use
			--wait @bool # watch add-on destruction status and exit when complete
		detach # detach an existing add-on resource from an app 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		docs # open an add-on's Dev Center documentation in your browser 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
			--show-url @bool # show URL, do not open browser
		downgrade # change add-on plan See available plans with `heroku addons:plans SERVICE`.  Note that `heroku addons:upgrade` and `heroku addons:downgrade` are the same. Either one can be used to change an add-on plan up or down.  https://devcenter.heroku.com/articles/managing-add-ons
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		info # show detailed add-on resource and attachment information 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		open # open an add-on's dashboard in your browser 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
			--show-url @bool # show URL, do not open browser
		plans # list all available plans for an add-on services 
			--json @bool # output in json format
		rename # rename an add-on 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		services # list all available add-on services 
			--json @bool # output in json format
		upgrade # change add-on plan See available plans with `heroku addons:plans SERVICE`.  Note that `heroku addons:upgrade` and `heroku addons:downgrade` are the same. Either one can be used to change an add-on plan up or down.  https://devcenter.heroku.com/articles/managing-add-ons
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		wait # show provisioning status of the add-ons on the app 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
			--wait-interval # how frequently to poll in seconds
	apps # list your apps 
		--all|-A @bool # include apps in all teams
		--internal-routing|-i @bool # filter to Internal Web Apps
		--json @bool # output in json format
		--org|-o # team to use
		--personal|-p @bool # list apps in personal account when a default team is set
		--space|-s # filter by space
		--team|-t # team to use
		create # creates a new app 
			--addons # comma-delimited list of addons to install
			--app|-a
			--buildpack|-b # buildpack url to use for this app
			--features
			--internal-routing @bool # private space-only. create as an Internal Web App that is only routable in the local network.
			--json @bool # output in json format
			--kernel
			--locked @bool
			--manifest|-m @bool # use heroku.yml settings for this app
			--no-remote|-n @bool # do not create a git remote
			--org|-o # team to use
			--region # specify region for the app to run in
			--remote|-r # the git remote to create, default "heroku"
			--space # the private space to create the app in
			--stack|-s # the stack to create the app on
			--team|-t # team to use
		destroy # permanently destroy an app This will also destroy all add-ons on the app.
			--app|-a # app to run command against
			--confirm|-c
			--remote|-r # git remote of app to use
		errors # view app errors 
			--app|-a # app to run command against
			--dyno @bool # show only dyno errors
			--hours # number of hours to look back (default 24)
			--json @bool # output in json format
			--remote|-r # git remote of app to use
			--router @bool # show only router errors
		favorites # list favorited apps 
			--json @bool # output in json format
			add # favorites an app 
				--app|-a # app to run command against
				--remote|-r # git remote of app to use
			remove # unfavorites an app 
				--app|-a # app to run command against
				--remote|-r # git remote of app to use
		info # show detailed app information $ heroku apps:info === example Git URL:   https://git.heroku.com/example.git Repo Size: 5M ...  $ heroku apps:info --shell git_url=https://git.heroku.com/example.git repo_size=5000000 ...
			--app|-a # app to run command against
			--extended|-x @bool
			--json|-j @bool
			--remote|-r # git remote of app to use
			--shell|-s @bool # output more shell friendly key/value pairs
		join # add yourself to a team app 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		leave # remove yourself from a team app 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		lock # prevent team members from joining an app 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		open # open the app in a web browser 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		rename # rename an app This will locally update the git remote if it is set to the old app.
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		stacks # show the list of available stacks 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
			set # set the stack of an app 
				--app|-a # app to run command against
				--remote|-r # git remote of app to use
		transfer # transfer applications to another user or team 
			--app|-a # app to run command against
			--bulk @bool # transfer applications in bulk
			--locked|-l @bool # lock the app upon transfer
			--remote|-r # git remote of app to use
		unlock # unlock an app so any team member can join 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
	auth
		2fa # check 2fa status
			disable # disables 2fa on account
		login # login with your Heroku credentials
			--browser # browser to open SSO with (example: "firefox", "safari")
			--expires-in|-e # duration of token in seconds (default 30 days)
			--interactive|-i @bool # login with username/password
			--sso|-s @bool # login for enterprise users under SSO
		logout # clears local login credentials and invalidates API session
		token # outputs current CLI authentication token. By default, the CLI auth token is only valid for 1 year.
		whoami # display the current logged in user
	authorizations # list OAuth authorizations
		--json|-j @bool # output in json format
		create # create a new OAuth authorization
			--description|-d # set a custom authorization
			--expires-in|-e # set expiration in seconds (default no expiration)
			--json|-j @bool # output in json format
			--scope|-s # set custom OAuth scopes
			--short|-S @bool # only output token
		info # show an existing OAuth authorization
			--json|-j @bool # output in json format
		revoke # revoke OAuth authorization
		rotate # updates an OAuth authorization token
		update # updates an OAuth authorization
			--client-id # identifier of OAuth client to set
			--client-secret # secret of OAuth client to set
			--description|-d # set a custom authorization description
	autocomplete # display autocomplete installation instructions
		--refresh-cache|-r @bool # refresh cache only (ignores displaying instructions)
	buildpacks # display the buildpacks for an app
		--app|-a # app to run command against
		--remote|-r # git remote of app to use
		add # add new app buildpack, inserting into list of buildpacks if necessary
			--app|-a # app to run command against
			--index|-i # the 1-based index of the URL in the list of URLs
			--remote|-r # git remote of app to use
		clear # clear all buildpacks set on the app
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		info # fetch info about a buildpack
		remove # remove a buildpack set on the app
			--app|-a # app to run command against
			--index|-i # the 1-based index of the URL to remove from the list of URLs
			--remote|-r # git remote of app to use
		search # search for buildpacks
			--description # buildpack description to filter on
			--name # buildpack names to filter on using a comma separated list 
			--namespace # buildpack namespaces to filter on using a comma separated list
		set
			--app|-a # app to run command against
			--index|-i # the 1-based index of the URL in the list of URLs
			--remote|-r # git remote of app to use
		versions # list versions of a buildpack
	certs # list SSL certificates for an app 
		--app|-a # app to run command against
		--remote|-r # git remote of app to use
		add # add an SSL certificate to an app Note: certificates with PEM encoding are also valid
			--app|-a # app to run command against
			--bypass @bool # bypass the trust chain completion step
			--remote|-r # git remote of app to use
		auto # show ACM status for an app 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
			--wait @bool # watch ACM status and display the status when complete
			disable # disable ACM for an app 
				--app|-a # app to run command against
				--confirm
				--remote|-r # git remote of app to use
			enable # enable ACM status for an app 
				--app|-a # app to run command against
				--remote|-r # git remote of app to use
				--wait @bool # watch ACM status and exit when complete
			refresh # refresh ACM for an app 
				--app|-a # app to run command against
				--remote|-r # git remote of app to use
		chain # print an ordered & complete chain for a certificate 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		generate # generate a key and a CSR or self-signed certificate Generate a key and certificate signing request (or self-signed certificate) for an app.
			--app|-a # app to run command against
			--area # sub-country area (state, province, etc.) of owner
			--city # city of owner
			--country # country of owner, as a two-letter ISO country code
			--keysize # RSA key size in bits (default: 2048)
			--now @bool # do not prompt for any owner information
			--owner # name of organization certificate belongs to
			--remote|-r # git remote of app to use
			--selfsigned @bool # generate a self-signed certificate instead of a CSR
			--subject # specify entire certificate subject
		info # show certificate information for an SSL certificate 
			--app|-a # app to run command against
			--endpoint # endpoint to check info on
			--name # name to check info on
			--remote|-r # git remote of app to use
			--show-domains @bool # show associated domains
		key # print the correct key for the given certificate You must pass one single certificate, and one or more keys. The first key that signs the certificate will be printed back.
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		remove # remove an SSL certificate from an app 
			--app|-a # app to run command against
			--confirm
			--endpoint # endpoint to remove
			--name # name to remove
			--remote|-r # git remote of app to use
		update # update an SSL certificate on an app Note: certificates with PEM encoding are also valid
			--app|-a # app to run command against
			--bypass @bool # bypass the trust chain completion step
			--confirm
			--endpoint # endpoint to update
			--name # name to update
			--remote|-r # git remote of app to use
	ci # display the most recent CI runs for the given pipeline
		--app|-a # app name
		--json @bool # output in json format
		--pipeline|-p # name of pipeline
		--watch @bool # keep running and watch for new and update tests
		config # display CI config vars Example:      $ heroku ci:config --app murmuring-headland-14719 --json
			--app|-a # app to run command against
			--json @bool # output config vars in json format
			--pipeline|-p # pipeline
			--remote|-r # git remote of app to use
			--shell|-s @bool # output config vars in shell format
			get # get a CI config var Examples:      $ heroku ci:config:get RAILS_ENV     test 
				--app|-a # app to run command against
				--pipeline|-p # pipeline
				--remote|-r # git remote of app to use
				--shell|-s @bool # output config var in shell format
			set # set CI config vars Examples:      $ heroku ci:config:set RAILS_ENV=test     Setting test config vars...
				--app|-a # app to run command against
				--pipeline|-p # pipeline
				--remote|-r # git remote of app to use
			unset # unset CI config vars Examples:      $ heroku ci:config:uset RAILS_ENV     Unsetting RAILS_ENV...
				--app|-a # app to run command against
				--pipeline|-p # pipeline
				--remote|-r # git remote of app to use
		debug # opens an interactive test debugging session with the contents of the current directory Example:      $ heroku ci:debug     Preparing source...
			--app|-a # app to run command against
			--no-cache @bool # start test run with an empty cache
			--no-setup @bool # start test dyno without running test-setup
			--pipeline|-p # pipeline
			--remote|-r # git remote of app to use
		info # show the status of a specific test run
			--app|-a # app name
			--node # the node number to show its setup and output
			--pipeline|-p # name of pipeline
		last # looks for the most recent run and returns the output of that run
			--app|-a # app name
			--node # the node number to show its setup and output
			--pipeline|-p # name of pipeline
		migrate-manifest # app-ci.json is deprecated.
		open # open the Dashboard version of Heroku CI opens a browser to view the Dashboard version of Heroku CI      Example:      $ heroku ci:open --app murmuring-headland-14719
			--app|-a # app to run command against
			--pipeline|-p # pipeline
			--remote|-r # git remote of app to use
		rerun # rerun tests against current directory
			--app|-a # app name
			--pipeline|-p # name of pipeline
		run # run tests against current directory
			--app|-a # app name
			--pipeline|-p # name of pipeline
	clients # list your OAuth clients
		--json|-j @bool # output in json format
		create # create a new OAuth client
			--json|-j @bool # output in json format
			--shell|-s @bool # output in shell format
		destroy # delete client by ID
		info # show details of an oauth client
			--json|-j @bool # output in json format
			--shell|-s @bool # output in shell format
		rotate # rotate OAuth client secret
			--json|-j @bool # output in json format
			--shell|-s @bool # output in shell format
		update # update OAuth client
			--name|-n # change the client name
			--url # change the client redirect URL
	commands # list all the commands
		--columns # only show provided columns (comma-separated)
		--csv @bool # output is csv format [alias: --output=csv]
		--extended|-x @bool # show extra columns
		--filter # filter property by partial string matching, ex: name=foo
		--hidden @bool # show hidden commands
		--json @bool # Format output as json.
		--no-header @bool # hide table header from output
		--no-truncate @bool # do not truncate output to fit screen
		--output (csv|json|yaml) # output in a more machine friendly format
		--sort # property to sort by (prepend '-' for descending)
		--tree @bool # show tree of commands
	config # display the config vars for an app
		--app|-a # app to run command against
		--json|-j @bool # output config vars in json format
		--remote|-r # git remote of app to use
		--shell|-s @bool # output config vars in shell format
		edit # interactively edit config vars This command opens the app config in a text editor set by $VISUAL or $EDITOR. Any variables added/removed/changed will be updated on the app after saving and closing the file.
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		get # display a single config value for an app
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
			--shell|-s @bool # output config vars in shell format
		set # set one or more config vars 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		unset # unset one or more config vars
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
	container # Use containers to build and deploy Heroku apps 
		login # log in to Heroku Container Registry Usage:         heroku container:login
			--verbose|-v @bool
		logout # log out from Heroku Container Registry 
			--verbose|-v @bool
		pull # pulls an image from an app's process type      Usage:     heroku container:pull web        # Pulls the web image from the app     heroku container:pull web worker # Pulls both the web and worker images from the app     heroku container:pull web:latest # Pulls the latest tag from the web image
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
			--verbose|-v @bool
		push # builds, then pushes Docker images to deploy your Heroku app 
			--app|-a # app to run command against
			--arg # set build-time variables
			--context-path # path to use as build context (defaults to Dockerfile dir)
			--recursive|-R @bool # pushes Dockerfile.<process> found in current and subdirectories
			--remote|-r # git remote of app to use
			--verbose|-v @bool
		release # Releases previously pushed Docker images to your Heroku app      Usage:     heroku container:release web                       # Releases the previously pushed web process type     heroku container:release web worker                # Releases the previously pushed web and worker process types
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
			--verbose|-v @bool
		rm # remove the process type from your app      Usage:     heroku container:rm web        # Destroys the web container     heroku container:rm web worker # Destroys the web and worker containers
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		run # builds, then runs the docker image locally      Usage:     heroku container:run web bash # Runs bash on the local web docker container     heroku container:run worker   # Runs the container CMD on the local worker container
			--app|-a # app to run command against
			--port|-p # port the app will run on
			--remote|-r # git remote of app to use
			--verbose|-v @bool
	domains # list domains for an app
		--app|-a # app to run command against
		--columns # only show provided columns (comma-separated)
		--csv @bool # output is csv format [alias: --output=csv]
		--extended|-x @bool # show extra columns
		--filter # filter property by partial string matching, ex: name=foo
		--json|-j @bool # output in json format
		--no-header @bool # hide table header from output
		--output (csv|json|yaml) # output in a more machine friendly format
		--remote|-r # git remote of app to use
		--sort # property to sort by (prepend '-' for descending)
		add # add a domain to an app
			--app|-a # app to run command against
			--cert|-c # the name of the SSL cert you want to use for this domain
			--json|-j @bool # output in json format
			--remote|-r # git remote of app to use
			--wait @bool
		clear # remove all domains from an app
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		info # show detailed information for a domain on an app
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		remove # remove a domain from an app
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		update # update a domain to use a different SSL certificate on an app
			--app|-a # app to run command against
			--cert # the name or id of the certificate you want to use for this domain
			--remote|-r # git remote of app to use
		wait # wait for domain to be active for an app
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
	drains # display the log drains of an app 
		--app|-a # app to run command against
		--extended|-x @bool
		--json @bool # output in json format
		--remote|-r # git remote of app to use
		add # adds a log drain to an app 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		remove # removes a log drain from an app 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
	dyno
		kill # stop app dyno  stop app dyno or dyno type
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		resize # manage dyno sizes  Called with no arguments shows the current dyno size.  Called with one argument sets the size. Where SIZE is one of eco|basic|standard-1x|standard-2x|performance  Called with 1..n TYPE=SIZE arguments sets the quantity per type. 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		restart # restart app dynos if DYNO is not specified, restarts all dynos on app
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		scale # scale dyno quantity up or down Appending a size (eg.
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		stop # stop app dyno  stop app dyno or dyno type
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
	features # list available app features 
		--app|-a # app to run command against
		--json @bool # output in json format
		--remote|-r # git remote of app to use
		disable # disables an app feature 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		enable # enables an app feature 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		info # display information about a feature 
			--app|-a # app to run command against
			--json @bool # output in json format
			--remote|-r # git remote of app to use
	git
		clone # clones a heroku app to your local machine at DIRECTORY (defaults to app name)
			--app|-a # the Heroku app to use
			--remote|-r # the git remote to create, default "heroku"
		remote # adds a git remote to an app repo extra arguments will be passed to git remote add 
			--app|-a # the Heroku app to use
			--remote|-r # the git remote to create
	help # Display help for <%= config.bin %>.
		--nested-commands|-n @bool # Include all nested commands in the output.
	join # add yourself to a team app 
		--app|-a # app to run command against
		--remote|-r # git remote of app to use
	keys # display your SSH keys 
		--json @bool # output in json format
		--long|-l @bool # display full SSH keys
		add # add an SSH key for a user if no KEY is specified, will try to find ~/.ssh/id_rsa.pub
			--quiet @bool
			--yes|-y @bool # automatically answer yes for all prompts
		clear # remove all SSH keys for current user 
		remove # remove an SSH key from the user 
	labs # list experimental features 
		--app|-a # app to run command against
		--json @bool # display as json
		--remote|-r # git remote of app to use
		disable # disables an experimental feature
			--app|-a # app to run command against
			--confirm
			--remote|-r # git remote of app to use
		enable # enables an experimental feature 
			--app|-a # app to run command against
			--remote|-r # git remote of app to use
		info # show feature info 
			--app|-a # app to run command against
			--json @bool # display as json
			--remote|-r # git remote of app to use
	leave # remove yourself from a team app 
		--app|-a # app to run command against
		--remote|-r # git remote of app to use
	local # run heroku app locally Start the application specified by a Procfile (defaults to ./Procfile)
		--concurrency|-c # number of processes to start
		--env|-e # location of env file (defaults to .env)
		--port|-p # port to listen on
		--procfile|-f # use a different Procfile
		--restart|-r @bool # restart process if it dies
		run # run a one-off command
			--env|-e
			--port|-p
		version # display node-foreman version
	lock # prevent team members from joining an app 
		--app|-a # app to run command against
		--remote|-r # git remote of app to use
	logs # display recent log output disable colors with --no-color, HEROKU_LOGS_COLOR=0, or HEROKU_COLOR=0
		--app|-a # app to run command against
		--dyno|-d # only show output from this dyno type (such as "web" or "worker")
		--force-colors @bool # force use of colors (even on non-tty output)
