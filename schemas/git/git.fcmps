		--textconv @bool # run textconv on object's content
		--filters @bool # run filters on object's content
	check-attr # Display gitattributes information
	check-ignore # Debug gitignore / exclude files
		--no-index @bool # ignore index when checking
		--index @bool # opposite of --no-index
	check-mailmap # Show canonical names and email addresses of contacts
	check-ref-format # Ensures that a reference name is well formed
	checkout # Switch branches or restore working tree files
		--ours|-2 @bool # checkout our version for unmerged files
		--theirs|-3 @bool # checkout their version for unmerged files
		--unified|-U # generate diffs with <n> lines context
		--inter-hunk-context # show context between diff hunks up to the specified number of lines
	checkout-index # Copy files from the index to the working tree
		--no-create|-n @bool # don't checkout new files
		--create @bool # opposite of --no-create
		--stage # copy out the files from named stage
	cherry # Find commits yet to be applied to upstream
	cherry-pick # Apply the changes introduced by some existing commits
		--quit @bool # end revert or cherry-pick sequence
		--continue @bool # resume revert or cherry-pick sequence
		--abort @bool # cancel revert or cherry-pick sequence
		--skip @bool # skip current commit and continue
		--no-commit|-n @bool # don't automatically commit
		--commit @bool # opposite of --no-commit
		--empty # how to handle commits that become empty
	citool # Graphical alternative to git-commit
	clean # Remove untracked files from the working tree
		--exclude|-e # add <pattern> to ignore rules
	cli # Git command-line interface and conventions
	clone # Clone a repository into a new directory
		--no-checkout|-n @bool # don't create a checkout
		--checkout @bool # opposite of --no-checkout
		--no-hardlinks @bool # don't use local hardlinks, always copy
		--hardlinks @bool # opposite of --no-hardlinks
		--ipv4|-4 @bool # use IPv4 addresses only
		--ipv6|-6 @bool # use IPv6 addresses only
	column # Display data in columns
		--raw-mode # layout to use
