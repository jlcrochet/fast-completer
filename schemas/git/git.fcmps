# git CLI schema for fast-completer
# Generated from git 2.53.0

git # Distributed version control
	add # Add file contents to the index
		--unified|-U # generate diffs with <n> lines context
		--inter-hunk-context # show context between diff hunks up to the specified number of lines
	am # Apply a series of patches from a mailbox
		--no-verify|-n @bool # bypass pre-applypatch and applypatch-msg hooks
		--verify @bool # opposite of --no-verify
		--quoted-cr # pass it through git-mailinfo
		--continue @bool # continue applying patches after resolving a conflict
		--resolved|-r @bool # synonyms for --continue
		--skip @bool # skip the current patch
		--abort @bool # restore the original branch and abort the patching operation
		--quit @bool # abort the patching operation but keep HEAD where it is
		--show-current-patch # show the patch being applied
		--retry @bool # try to apply current patch again
		--allow-empty @bool # record the empty patch as an empty commit
		--empty # how to handle empty patches
	annotate # Annotate file lines with commit information
		--diff-algorithm # choose a diff algorithm
	apply # Apply a patch to files and/or to the index
		--exclude # don't apply changes matching the given path
		--include # apply changes matching the given path
		--no-add @bool # ignore additions made by the patch
		--add @bool # opposite of --no-add
		--ours @bool # for conflicts, use our version
		--theirs @bool # for conflicts, use their version
		--union @bool # for conflicts, use a union version
	archimport # Import a GNU Arch repository into Git
	archive # Create an archive of files from a named tree
		--mtime # set modification time of archive entries
	attributes # Defining attributes per path
	backfill # Download missing objects in a partial clone
		--min-batch-size # Minimum number of objects to request at a time
	bisect # Use binary search to find the commit that introduced a bug
	blame # Show what revision and author last modified each line of a file
		--diff-algorithm # choose a diff algorithm
	branch # List, create, or delete branches
		--remotes|-r @bool # act on remote-tracking branches
		--contains # print only branches that contain the commit
		--no-contains # print only branches that don't contain the commit
		--all|-a @bool # list both remote-tracking and local branches
		--merged # print only branches that are merged
		--no-merged # print only branches that are not merged
	bugreport # Collect information for user to file a bug report
	bundle # Move objects and refs by archive
	cat-file # Provide contents or details of repository objects
