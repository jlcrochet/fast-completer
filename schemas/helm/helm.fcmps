		--hide-secret @bool # hide Kubernetes Secrets when also using the --dry-run flag
		--history-max # limit the maximum number of revisions saved per release. Use 0 for no limit
		--insecure-skip-tls-verify @bool # skip tls certificate checks for the chart download
		--install @bool # if a release by this name doesn't already exist, run an install
		--key-file # identify HTTPS client using this SSL key file
		--keyring # location of public keys used for verification
		--labels # Labels that would be added to release metadata. Should be separated by comma. Original release labels will be merged with upgrade labels. You can unset label using null.
		--no-hooks @bool # disable pre/post upgrade hooks
		--output # prints the output in the specified format. Allowed values: table, json, yaml
		--pass-credentials @bool # pass credentials to all domains
		--password # chart repository password where to locate the requested chart
		--plain-http @bool # use insecure HTTP connections for the chart download
		--post-renderer # the name of a postrenderer type plugin to be used for post rendering. If it exists, the plugin will be used
		--post-renderer-args # an argument to the post-renderer (can specify multiple)
		--render-subchart-notes @bool # if set, render subchart notes along with the parent
		--repo # chart repository url where to locate the requested chart
		--reset-then-reuse-values @bool # when upgrading, reset the values to the ones built into the chart, apply the last release's values and merge in any overrides from the command line via --set and -f. If '--reset-values' or '--reuse-values' is specified, this is ignored
		--reset-values @bool # when upgrading, reset the values to the ones built into the chart
		--reuse-values @bool # when upgrading, reuse the last release's values and merge in any overrides from the command line via --set and -f. If '--reset-values' is specified, this is ignored
		--rollback-on-failure @bool # if set, Helm will rollback the upgrade to previous success release upon failure. The --wait flag will be defaulted to "watcher" if --rollback-on-failure is set
		--server-side # must be "true", "false" or "auto". Object updates run in the server instead of the client ("auto" defaults the value from the previous chart release's method)
		--set # set values on the command line (can specify multiple or separate values with commas: key1=val1,key2=val2)
		--set-file # set values from respective files specified via the command line (can specify multiple or separate values with commas: key1=path1,key2=path2)
		--set-json # set JSON values on the command line (can specify multiple or separate values with commas: key1=jsonval1,key2=jsonval2 or using json format: {"key1": jsonval1, "key2": "jsonval2"})
		--set-literal # set a literal STRING value on the command line
		--set-string # set STRING values on the command line (can specify multiple or separate values with commas: key1=val1,key2=val2)
		--skip-crds @bool # if set, no CRDs will be installed when an upgrade is performed with install flag enabled. By default, CRDs are installed if not already present, when an upgrade is performed with install flag enabled
		--skip-schema-validation @bool # if set, disables JSON schema validation
		--take-ownership @bool # if set, upgrade will ignore the check for helm annotations and take ownership of the existing resources
		--timeout # time to wait for any individual Kubernetes operation (like Jobs for hooks)
		--username # chart repository username where to locate the requested chart
		--values # specify values in a YAML file or a URL (can specify multiple)
		--verify @bool # verify the package before using it
		--wait # if specified, wait until resources are ready (up to --timeout). Values: 'watcher', 'hookOnly', and 'legacy'.
		--wait-for-jobs @bool # if set and --wait enabled, will wait until all Jobs have been completed before marking the release as successful. It will wait for as long as --timeout
	verify # verify that a chart at the given path has been signed and is valid
		--burst-limit # client-side default throttling limit
		--color # use colored output (never, auto, always)
		--colour # use colored output (never, auto, always)
		--content-cache # path to the directory containing cached content (e.g. charts)
		--debug @bool # enable verbose output
		--kube-apiserver # the address and the port for the Kubernetes API server
		--kube-as-group # group to impersonate for the operation, this flag can be repeated to specify multiple groups.
		--kube-as-user # username to impersonate for the operation
		--kube-ca-file # the certificate authority file for the Kubernetes API server connection
		--kube-context # name of the kubeconfig context to use
		--kube-insecure-skip-tls-verify @bool # if true, the Kubernetes API server's certificate will not be checked for validity. This will make your HTTPS connections insecure
		--kube-tls-server-name # server name to use for Kubernetes API server certificate validation. If it is not provided, the hostname used to contact the server is used
		--kube-token # bearer token used for authentication
		--kubeconfig # path to the kubeconfig file
		--namespace # namespace scope for this request
		--qps # queries per second used when communicating with the Kubernetes API, not including bursting
		--registry-config # path to the registry config file
		--repository-cache # path to the directory containing cached repository indexes
		--repository-config # path to the file containing repository names and URLs
		--keyring # keyring containing public keys
