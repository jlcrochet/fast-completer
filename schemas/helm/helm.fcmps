		--ca-file # verify certificates of HTTPS-enabled servers using this CA bundle
		--cert-file # identify HTTPS client using this SSL certificate file
		--create-namespace @bool # create the release namespace if not present
		--dependency-update @bool # update dependencies if they are missing before installing the chart
		--description # add a custom description
		--devel @bool # use development versions, too. Equivalent to version '>0.0.0-0'. If --version is set, this is ignored
		--disable-openapi-validation @bool # if set, the installation process will not validate rendered templates against the Kubernetes OpenAPI Schema
		--dry-run # simulates the operation either client-side or server-side. Must be either: "client", or "server". '--dry-run=client simulates the operation client-side only and avoids cluster connections. '--dry-run=server' simulates/validates the operation on the server, requiring cluster connectivity.
		--enable-dns @bool # enable DNS lookups when rendering templates
		--force-conflicts @bool # if set server-side apply will force changes against conflicts
		--force-replace @bool # force resource updates by replacement
		--generate-name @bool # generate the name (and omit the NAME parameter)
		--hide-notes @bool # if set, do not show notes in install output. Does not affect presence in chart metadata
		--include-crds @bool # include CRDs in the templated output
		--insecure-skip-tls-verify @bool # skip tls certificate checks for the chart download
		--is-upgrade @bool # set .Release.IsUpgrade instead of .Release.IsInstall
		--key-file # identify HTTPS client using this SSL key file
		--keyring # location of public keys used for verification
		--kube-version # Kubernetes version used for Capabilities.KubeVersion
		--labels # Labels that would be added to release metadata. Should be divided by comma.
		--name-template # specify template used to name the release
		--no-hooks @bool # prevent hooks from running during install
		--output-dir # writes the executed templates to files in output-dir instead of stdout
		--pass-credentials @bool # pass credentials to all domains
		--password # chart repository password where to locate the requested chart
		--plain-http @bool # use insecure HTTP connections for the chart download
		--post-renderer # the name of a postrenderer type plugin to be used for post rendering. If it exists, the plugin will be used
		--post-renderer-args # an argument to the post-renderer (can specify multiple)
		--release-name @bool # use release name in the output-dir path.
		--render-subchart-notes @bool # if set, render subchart notes along with the parent
		--replace @bool # reuse the given name, only if that name is a deleted release which remains in the history. This is unsafe in production
		--repo # chart repository url where to locate the requested chart
		--rollback-on-failure @bool # if set, Helm will rollback (uninstall) the installation upon failure. The --wait flag will be default to "watcher" if --rollback-on-failure is set
		--server-side @bool # object updates run in the server instead of the client
		--set # set values on the command line (can specify multiple or separate values with commas: key1=val1,key2=val2)
		--set-file # set values from respective files specified via the command line (can specify multiple or separate values with commas: key1=path1,key2=path2)
		--set-json # set JSON values on the command line (can specify multiple or separate values with commas: key1=jsonval1,key2=jsonval2 or using json format: {"key1": jsonval1, "key2": "jsonval2"})
		--set-literal # set a literal STRING value on the command line
		--set-string # set STRING values on the command line (can specify multiple or separate values with commas: key1=val1,key2=val2)
		--show-only # only show manifests rendered from the given templates
		--skip-crds @bool # if set, no CRDs will be installed. By default, CRDs are installed if not already present
		--skip-schema-validation @bool # if set, disables JSON schema validation
		--skip-tests @bool # skip tests from templated output
		--take-ownership @bool # if set, install will ignore the check for helm annotations and take ownership of the existing resources
		--timeout # time to wait for any individual Kubernetes operation (like Jobs for hooks)
		--username # chart repository username where to locate the requested chart
		--values # specify values in a YAML file or a URL (can specify multiple)
		--verify @bool # verify the package before using it
		--wait # if specified, wait until resources are ready (up to --timeout). Values: 'watcher', 'hookOnly', and 'legacy'.
		--wait-for-jobs @bool # if set and --wait enabled, will wait until all Jobs have been completed before marking the release as successful. It will wait for as long as --timeout
