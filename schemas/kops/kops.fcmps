# Kops CLI schema for fast-completer
# Generated from kops unknown

kops # Kubernetes operations
	--config # yaml config file (default is $HOME/.kops.yaml)
	--help @bool # help for kops
	--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
	--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
	--v # number for the log level verbosity
	completion # Generate the autocompletion script for the specified shell
		--config # yaml config file (default is $HOME/.kops.yaml)
		--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
		--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
		--v # number for the log level verbosity
		bash # Generate the autocompletion script for bash
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			--no-descriptions @bool # disable completion descriptions
		fish # Generate the autocompletion script for fish
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			--no-descriptions @bool # disable completion descriptions
		powershell # Generate the autocompletion script for powershell
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			--no-descriptions @bool # disable completion descriptions
		zsh # Generate the autocompletion script for zsh
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			--no-descriptions @bool # disable completion descriptions
	create # Create a resource by command line, filename or stdin.
		--filename # Filename to use to create the resource
		cluster # Create a Kubernetes cluster.
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			--admin-access # Restrict API access to this CIDR.  If not set, access will not be restricted by IP.
			--api-loadbalancer-type # Type of load balancer for the Kubernetes API: public or internal
			--api-public-name # Domain name of the public Kubernetes API
			--api-ssl-certificate # ARN of the SSL Certificate to use for the Kubernetes API load balancer (AWS only)
			--associate-public-ip @bool # Specify --associate-public-ip=[true|false] to enable/disable association of public IP for control-plane ASG and nodes. Default is 'true'.
			--authorization # Authorization mode: AlwaysAllow or RBAC
			--bastion @bool # Enable a bastion instance group. Only applies to private topology.
			--bastion-image # Machine image for bastions. Takes precedence over --image
			--channel # Channel for default versions and configuration to use
			--cloud # Cloud provider to use - aws, digitalocean, gce, hetzner, openstack
			--cloud-labels # A list of key/value pairs used to tag all instance groups (for example "Owner=John Doe,Team=Some Team").
			--control-plane-count # Number of control-plane nodes. Defaults to one control-plane node per control-plane-zone
			--control-plane-image # Machine image for control-plane nodes. Takes precedence over --image
			--control-plane-security-groups # Additional pre-created security groups to add to control-plane nodes.
			--control-plane-size # Machine type(s) for control-plane nodes
			--control-plane-tenancy # Tenancy of the control-plane group (AWS only): default or dedicated
			--control-plane-volume-size # Instance volume size (in GB) for control-plane nodes
			--control-plane-zones # Zones in which to run control-plane nodes. (must be an odd number)
			--disable-subnet-tags @bool # Disable automatic subnet tagging
			--discovery-store # A public location where we publish OIDC-compatible discovery information under a cluster-specific directory. Enables IRSA in AWS.
			--dns # DNS type to use: public, private, none
			--dns-zone # DNS hosted zone (defaults to longest matching zone)
			--dry-run @bool # If true, only print the object that would be sent, without sending it. This flag can be used to create a cluster YAML or JSON manifest.
			--encrypt-etcd-storage @bool # Generate key in AWS KMS and use it for encrypt etcd volumes
			--etcd-clusters # Names of the etcd clusters: main, events
			--etcd-storage-type # The default storage type for etcd members
			--gce-service-account # Service account with which the GCE VM runs. Warning: if not set, VMs will run as default compute service account.
			--image # Machine image for all instances
			--instance-manager # Instance manager to use (cloudgroups or karpenter. Default: cloudgroups)
			--ipv6 @bool # Use IPv6 for the pod network (AWS only)
			--kubernetes-feature-gates # List of Kubernetes feature gates to enable/disable
			--kubernetes-version # Version of Kubernetes to run (defaults to version in channel)
			--network-cidr # Network CIDR(s) to use
			--network-id # Shared Network or VPC to use
			--networking # Networking mode.  kubenet, external, flannel-vxlan (or flannel), flannel-udp, calico, kube-router, amazonvpc, cilium, cilium-etcd, kindnet, cni.
			--node-count # Total number of worker nodes. Defaults to one node per zone
			--node-image # Machine image for worker nodes. Takes precedence over --image
			--node-security-groups # Additional pre-created security groups to add to worker nodes.
			--node-size # Machine type(s) for worker nodes
			--node-tenancy # Tenancy of the node group (AWS only): default or dedicated
			--node-volume-size # Instance volume size (in GB) for worker nodes
			--os-dns-servers # comma separated list of DNS Servers which is used in network
			--os-ext-net # External network to use with the openstack router
			--os-ext-subnet # External floating subnet to use with the openstack router
			--os-kubelet-ignore-az @bool # Attach volumes across availability zones
			--os-lb-floating-subnet # External subnet to use with the Kubernetes API
			--os-network # ID of the existing OpenStack network to use
			--os-octavia @bool # Use octavia load balancer API
			--os-octavia-provider # Octavia provider to use
			--out # Path to write any local output
			--output # Output format. One of json or yaml. Used with the --dry-run flag.
			--project # Project to use (must be set on GCE)
			--set # Directly set values in the spec
			--ssh-access # Restrict SSH access to this CIDR.  If not set, uses the value of the admin-access flag.
			--ssh-public-key # SSH public key to use
			--subnets # Shared subnets to use
			--target # Valid targets: "direct", "terraform". Set this flag to "terraform" if you want kOps to generate terraform
			--topology # Network topology for the cluster: 'public' or 'private'. Defaults to 'public' for IPv4 clusters and 'private' for IPv6 clusters.
			--unset # Directly unset values in the spec
			--utility-subnets # Shared utility subnets to use
			--yes @bool # Specify --yes to immediately create the cluster
			--zones # Zones in which to run the cluster
		instancegroup # Create an instancegroup.
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			--dry-run @bool # Only print the object that would be created, without created it. This flag can be used to create an instance group YAML or JSON manifest.
			--edit @bool # Open an editor to edit default values
			--output # Output format. One of json or yaml
			--role # Type of instance group to create (control-plane,node,bastion)
			--subnet # Subnet in which to create instance group. One of Availability Zone like eu-west-1a or a comma-separated list of multiple Availability Zones.
		keypair # Add a CA certificate and private key to a keyset.
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			--cert # Path to CA certificate
			--key # Path to CA private key
			--primary @bool # Make the keypair the one used to issue certificates
		secret # Create a secret.
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			ciliumpassword # Create a Cilium IPsec configuration.
				--filename # Path to the Cilium IPsec configuration file
			dockerconfig # Create a Docker config.
				--filename # Path to Docker config JSON file
			encryptionconfig # Create an encryption config.
				--filename # Path to encryption config YAML file
		sshpublickey # Create an SSH public key.
			--ssh-public-key # Path to SSH public key
	delete # Delete clusters, instancegroups, instances, and secrets.
		--filename # Filename to use to delete the resource
		cluster # Delete a cluster.
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			--count # Number of consecutive failures to make progress deleting the cluster resources
			--external @bool # Delete an external cluster
			--interval # Time in duration to wait between deletion attempts
			--region # External cluster's cloud region
			--unregister @bool # Don't delete cloud resources, just unregister the cluster
			--wait # Amount of time to wait for the cluster resources to de deleted
			--yes @bool # Specify --yes to delete the cluster
		instance # Delete an instance.
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			--api-server # Override the API server used when communicating with the cluster kube-apiserver
			--cloudonly @bool # Perform deletion update without confirming progress with Kubernetes
			--fail-on-drain-error @bool # Fail if draining a node fails
			--fail-on-validate-error @bool # Fail if the cluster fails to validate
			--post-drain-delay # Time to wait after draining each node
			--surge @bool # Surge by detaching the node from the ASG before deletion
			--use-kubeconfig @bool # Use the server endpoint from the local kubeconfig instead of inferring from cluster name
			--validate-count # Number of times that a cluster needs to be validated after single node update
			--validation-timeout # Maximum time to wait for a cluster to validate
			--yes @bool # Specify --yes to immediately delete the instance
		instancegroup # Delete instance group.
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			--yes @bool # Specify --yes to immediately delete the instance group
		secret # Delete one or more secrets.
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
		sshpublickey # Delete an SSH public key.
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
	distrust # Distrust keypairs.
		--config # yaml config file (default is $HOME/.kops.yaml)
		--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
		--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
		--v # number for the log level verbosity
		keypair # Distrust a keypair.
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
	edit # Edit clusters and other resources.
