			--admin # Also export a cluster admin user credential with the specified lifetime and add it to the cluster context
			--allow-kops-downgrade @bool # Allow an older version of kOps to update the cluster than last used
			--api-server # Override the API server used when communicating with the cluster kube-apiserver
			--create-kube-config @bool # Will control automatically creating the kube config file on your local filesystem
			--ignore-kubelet-version-skew @bool # Setting this to true will force updating the kubernetes version on all instance groups, regardles of which control plane version is running
			--instance-group # Instance groups to update (defaults to all if not specified)
			--instance-group-roles # Instance group roles to update (control-plane,apiserver,node,bastion)
			--internal @bool # Use the cluster's internal DNS name. Implies --create-kube-config
			--lifecycle-overrides # comma separated list of phase overrides, example: SecurityGroups=Ignore,InternetGateway=ExistsAndWarnIfChanges
			--out # Path to write any local output
			--phase # Subset of tasks to run: cluster, network, security
			--prune @bool # Delete old revisions of cloud resources that were needed during an upgrade
			--ssh-public-key # SSH public key to use (deprecated: use kops create secret instead)
			--target # Target - "direct", "terraform"
			--use-kubeconfig @bool # Use the server endpoint from the local kubeconfig instead of inferring from cluster name
			--user # Existing user in kubeconfig file to use.  Implies --create-kube-config
			--yes @bool # Create cloud resources, without --yes update is in dry run mode
	upgrade # Upgrade a kubernetes cluster.
		--config # yaml config file (default is $HOME/.kops.yaml)
		--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
		--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
		--v # number for the log level verbosity
		cluster # Upgrade a kubernetes cluster.
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			--channel # Channel to use for upgrade
			--kubernetes-version # Kubernetes version to use for upgrade
			--yes @bool # Apply update
	validate # Validate a kOps cluster.
		--config # yaml config file (default is $HOME/.kops.yaml)
		--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
		--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
		--v # number for the log level verbosity
		cluster # Validate a kOps cluster.
			--config # yaml config file (default is $HOME/.kops.yaml)
			--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
			--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
			--v # number for the log level verbosity
			--api-server # Override the API server used when communicating with the cluster kube-apiserver
			--count # Number of consecutive successful validations required
			--interval # Time in duration to wait between validation attempts
			--kubeconfig # Path to the kubeconfig file
			--output # Output format. One of json|yaml|table.
			--use-kubeconfig @bool # Use the server endpoint from the local kubeconfig instead of inferring from cluster name
			--wait # Amount of time to wait for the cluster to become ready
	version # Print the kOps version information.
		--config # yaml config file (default is $HOME/.kops.yaml)
		--name # Name of cluster. Overrides KOPS_CLUSTER_NAME environment variable
		--state # Location of state storage (kops 'config' file). Overrides KOPS_STATE_STORE environment variable
		--v # number for the log level verbosity
		--server @bool # show the kOps version that made the last change to the state store.
		--short @bool # only print the main kOps version. Useful for scripting.
