# Curl CLI schema for fast-completer
# Generated from curl 8.18.0

curl # Transfer data with URLs
	--abstract-unix-socket # Connect via abstract Unix domain socket
	--alt-svc # Enable alt-svc with this cache file
	--anyauth @bool # Pick any authentication method
	--append|-a @bool # Append to target file when uploading
	--aws-sigv4 # AWS V4 signature auth
	--basic @bool # HTTP Basic Authentication
	--ca-native @bool # Load CA certs from the OS
	--cacert # CA certificate to verify peer against
	--capath # CA directory to verify peer against
	--cert|-E # Client certificate file and password
	--cert-status @bool # Verify server cert status OCSP-staple
	--cert-type # Certificate type (DER/PEM/ENG/PROV/P12)
	--ciphers # TLS 1.2 (1.1, 1.0) ciphers to use
	--compressed @bool # Request compressed response
	--compressed-ssh @bool # Enable SSH compression
	--config|-K # Read config from a file
	--connect-timeout # Maximum time allowed to connect
	--connect-to # Connect to host2 instead of host1
	--continue-at|-C # Resumed transfer offset
	--cookie|-b # Send cookies from string/load from file
	--cookie-jar|-c # Save cookies to <filename> after operation
	--create-dirs @bool # Create necessary local directory hierarchy
	--create-file-mode # File mode for created files
	--crlf @bool # Convert LF to CRLF in upload
	--crlfile # Certificate Revocation list
	--curves # (EC) TLS key exchange algorithms to request
	--data|-d # HTTP POST data
	--data-ascii # HTTP POST ASCII data
	--data-binary # HTTP POST binary data
	--data-raw # HTTP POST data, '@' allowed
	--data-urlencode # HTTP POST data URL encoded
	--delegation # GSS-API delegation permission
	--digest @bool # HTTP Digest Authentication
	--disable|-q @bool # Disable .curlrc
	--disable-eprt @bool # Inhibit using EPRT or LPRT
	--disable-epsv @bool # Inhibit using EPSV
	--disallow-username-in-url @bool # Disallow username in URL
	--dns-interface # Interface to use for DNS requests
	--dns-ipv4-addr # IPv4 address to use for DNS requests
	--dns-ipv6-addr # IPv6 address to use for DNS requests
	--dns-servers # DNS server addrs to use
	--doh-cert-status @bool # Verify DoH server cert status OCSP-staple
	--doh-insecure @bool # Allow insecure DoH server connections
	--doh-url # Resolve hostnames over DoH
	--dump-ca-embed @bool # Write the embedded CA bundle to standard output
	--dump-header|-D # Write the received headers to <filename>
	--ech # Configure ECH
	--egd-file # EGD socket path for random data
	--engine # Crypto engine to use
	--etag-compare # Load ETag from file
	--etag-save # Parse incoming ETag and save to a file
	--expect100-timeout # How long to wait for 100-continue
	--fail|-f @bool # Fail fast with no output on HTTP errors
	--fail-early @bool # Fail on first transfer error
	--fail-with-body @bool # Fail on HTTP errors but save the body
	--false-start @bool # Enable TLS False Start
	--follow @bool # Follow redirects per spec
	--form|-F # Specify multipart MIME data
	--form-escape @bool # Escape form fields using backslash
	--form-string # Specify multipart MIME data
	--ftp-account # Account data string
	--ftp-alternative-to-user # String to replace USER [name]
	--ftp-create-dirs @bool # Create the remote dirs if not present
	--ftp-method # Control CWD usage
	--ftp-pasv @bool # Send PASV/EPSV instead of PORT
	--ftp-port|-P # Send PORT instead of PASV
	--ftp-pret @bool # Send PRET before PASV
	--ftp-skip-pasv-ip @bool # Skip the IP address for PASV
	--ftp-ssl-ccc @bool # Send CCC after authenticating
	--ftp-ssl-ccc-mode # Set CCC mode
	--ftp-ssl-control @bool # Require TLS for login, clear for transfer
	--get|-G @bool # Put the post data in the URL and use GET
	--globoff|-g @bool # Disable URL globbing with {} and []
	--happy-eyeballs-timeout-ms # Time for IPv6 before IPv4
	--haproxy-clientip # Set address in HAProxy PROXY
	--haproxy-protocol @bool # Send HAProxy PROXY protocol v1 header
	--head|-I @bool # Show document info only
	--header|-H # Pass custom header(s) to server
	--hostpubmd5 # Acceptable MD5 hash of host public key
	--hostpubsha256 # Acceptable SHA256 hash of host public key
	--hsts # Enable HSTS with this cache file
	--http0.9 @bool # Allow HTTP/0.9 responses
	--http1.0|-0 @bool # Use HTTP/1.0
	--http1.1 @bool # Use HTTP/1.1
	--http2 @bool # Use HTTP/2
	--http2-prior-knowledge @bool # Use HTTP/2 without HTTP/1.1 Upgrade
	--http3 @bool # Use HTTP/3
	--http3-only @bool # Use HTTP/3 only
	--ignore-content-length @bool # Ignore the size of the remote resource
	--insecure|-k @bool # Allow insecure server connections
	--interface # Use network interface
	--ip-tos # Set IP Type of Service or Traffic Class
	--ipfs-gateway # Gateway for IPFS
	--ipv4|-4 @bool # Resolve names to IPv4 addresses
	--ipv6|-6 @bool # Resolve names to IPv6 addresses
	--json # HTTP POST JSON
	--junk-session-cookies|-j @bool # Ignore session cookies read from file
	--keepalive-cnt # Maximum number of keepalive probes
	--keepalive-time # Interval time for keepalive probes
	--key # Private key filename
	--key-type # Private key file type (DER/PEM/ENG)
	--knownhosts # Specify knownhosts path
	--krb # Enable Kerberos with security <level>
	--libcurl # Generate libcurl code for this command line
	--limit-rate # Limit transfer speed to RATE
	--list-only|-l @bool # List only mode
	--local-port # Use a local port number within RANGE
	--location|-L @bool # Follow redirects
	--location-trusted @bool # As --location, but send secrets to other hosts
	--login-options # Server login options
	--mail-auth # Originator address of the original email
	--mail-from # Mail from this address
	--mail-rcpt # Mail to this address
	--mail-rcpt-allowfails @bool # Allow RCPT TO command to fail
	--manual|-M @bool # Display the full manual
	--max-filesize # Maximum file size to download
	--max-redirs # Maximum number of redirects allowed
	--max-time|-m # Maximum time allowed for transfer
	--metalink @bool # Process given URLs as metalink XML file
	--mptcp @bool # Enable Multipath TCP
	--negotiate @bool # Use HTTP Negotiate (SPNEGO) authentication
	--netrc|-n @bool # Must read .netrc for username and password
	--netrc-file # Specify FILE for netrc
	--netrc-optional @bool # Use either .netrc or URL
	--no-alpn @bool # Disable the ALPN TLS extension
	--no-buffer|-N @bool # Disable buffering of the output stream
	--no-clobber @bool # Do not overwrite files that already exist
	--no-keepalive @bool # Disable TCP keepalive on the connection
	--no-npn @bool # Disable the NPN TLS extension
	--no-progress-meter @bool # Do not show the progress meter
	--no-sessionid @bool # Disable SSL session-ID reusing
	--noproxy # List of hosts which do not use proxy
	--ntlm @bool # HTTP NTLM authentication
	--ntlm-wb @bool # HTTP NTLM authentication with winbind
	--oauth2-bearer # OAuth 2 Bearer Token
	--out-null @bool # Discard response data into the void
	--output|-o # Write to file instead of stdout
	--output-dir # Directory to save files in
	--parallel|-Z @bool # Perform transfers in parallel
	--parallel-immediate @bool # Do not wait for multiplexing
	--parallel-max # Maximum concurrency for parallel transfers
	--parallel-max-host # Maximum connections to a single host
	--pass # Passphrase for the private key
	--path-as-is @bool # Do not squash .. sequences in URL path
	--pinnedpubkey # Public key to verify peer against
	--post301 @bool # Do not switch to GET after a 301 redirect
	--post302 @bool # Do not switch to GET after a 302 redirect
	--post303 @bool # Do not switch to GET after a 303 redirect
	--preproxy # Use this proxy first
	--proto # Enable/disable PROTOCOLS
	--proto-default # Use PROTOCOL for any URL missing a scheme
	--proto-redir # Enable/disable PROTOCOLS on redirect
	--proxy|-x # Use this proxy
	--proxy-anyauth @bool # Pick any proxy authentication method
	--proxy-basic @bool # Use Basic authentication on the proxy
	--proxy-ca-native @bool # Load CA certs from the OS to verify proxy
	--proxy-cacert # CA certificates to verify proxy against
	--proxy-capath # CA directory to verify proxy against
	--proxy-cert # Set client certificate for proxy
	--proxy-cert-type # Client certificate type for HTTPS proxy
	--proxy-ciphers # TLS 1.2 (1.1, 1.0) ciphers to use for proxy
	--proxy-crlfile # Set a CRL list for proxy
	--proxy-digest @bool # Digest auth with the proxy
	--proxy-header # Pass custom header(s) to proxy
	--proxy-http2 @bool # Use HTTP/2 with HTTPS proxy
	--proxy-insecure @bool # Skip HTTPS proxy cert verification
	--proxy-key # Private key for HTTPS proxy
	--proxy-key-type # Private key file type for proxy
	--proxy-negotiate @bool # HTTP Negotiate (SPNEGO) auth with the proxy
	--proxy-ntlm @bool # NTLM authentication with the proxy
	--proxy-pass # Passphrase for private key for HTTPS proxy
	--proxy-pinnedpubkey # FILE/HASHES public key to verify proxy with
	--proxy-service-name # SPNEGO proxy service name
	--proxy-ssl-allow-beast @bool # Allow this security flaw for HTTPS proxy
	--proxy-ssl-auto-client-cert @bool # Auto client certificate for proxy
	--proxy-tls13-ciphers # TLS 1.3 proxy cipher suites
	--proxy-tlsauthtype # TLS authentication type for HTTPS proxy
	--proxy-tlspassword # TLS password for HTTPS proxy
	--proxy-tlsuser # TLS username for HTTPS proxy
	--proxy-tlsv1 @bool # TLSv1 for HTTPS proxy
	--proxy-user|-U # Proxy user and password
	--proxy1.0 # Use HTTP/1.0 proxy on given port
	--proxytunnel|-p @bool # HTTP proxy tunnel (using CONNECT)
	--pubkey # SSH Public key filename
	--quote|-Q # Send command(s) to server before transfer
	--random-file # File for reading random data from
	--range|-r # Retrieve only the bytes within RANGE
	--raw @bool # Do HTTP raw; no transfer decoding
	--referer|-e # Referrer URL
	--remote-header-name|-J @bool # Use the header-provided filename
	--remote-name|-O @bool # Write output to file named as remote file
	--remote-name-all @bool # Use the remote filename for all URLs
	--remote-time|-R @bool # Set remote file's time on local output
	--remove-on-error @bool # Remove output file on errors
	--request|-X # Specify request method to use
	--request-target # Specify the target for this request
	--resolve # Resolve host+port to address
	--retry # Retry request if transient problems occur
	--retry-all-errors @bool # Retry all errors (with --retry)
	--retry-connrefused @bool # Retry on connection refused (with --retry)
	--retry-delay # Wait time between retries
	--retry-max-time # Retry only within this period
	--sasl-authzid # Identity for SASL PLAIN authentication
	--sasl-ir @bool # Initial response in SASL authentication
	--service-name # SPNEGO service name
	--show-error|-S @bool # Show error even when -s is used
	--show-headers|-i @bool # Show response headers in output
	--sigalgs # TLS signature algorithms to use
	--silent|-s @bool # Silent mode
	--skip-existing @bool # Skip download if local file already exists
	--socks4 # SOCKS4 proxy on given host + port
	--socks4a # SOCKS4a proxy on given host + port
	--socks5 # SOCKS5 proxy on given host + port
	--socks5-basic @bool # Username/password auth for SOCKS5 proxies
	--socks5-gssapi @bool # Enable GSS-API auth for SOCKS5 proxies
	--socks5-gssapi-nec @bool # Compatibility with NEC SOCKS5 server
	--socks5-gssapi-service # SOCKS5 proxy service name for GSS-API
	--socks5-hostname # SOCKS5 proxy, pass hostname to proxy
	--speed-limit|-Y # Stop transfers slower than this
	--speed-time|-y # Trigger 'speed-limit' abort after this time
	--ssl @bool # Try enabling TLS
	--ssl-allow-beast @bool # Allow security flaw to improve interop
	--ssl-auto-client-cert @bool # Use auto client certificate (Schannel)
	--ssl-no-revoke @bool # Disable cert revocation checks (Schannel)
	--ssl-reqd @bool # Require SSL/TLS
	--ssl-revoke-best-effort @bool # Ignore missing cert CRL dist points
	--ssl-sessions # Load/save SSL session tickets from/to this file
	--sslv2|-2 @bool # SSLv2
	--sslv3|-3 @bool # SSLv3
	--stderr # Where to redirect stderr
	--styled-output @bool # Enable styled output for HTTP headers
	--suppress-connect-headers @bool # Suppress proxy CONNECT response headers
	--tcp-fastopen @bool # Use TCP Fast Open
	--tcp-nodelay @bool # Set TCP_NODELAY
	--telnet-option|-t # Set telnet option
	--tftp-blksize # Set TFTP BLKSIZE option
	--tftp-no-options @bool # Do not send any TFTP options
	--time-cond|-z # Transfer based on a time condition
	--tls-earlydata @bool # Allow use of TLSv1.3 early data (0RTT)
	--tls-max # Maximum allowed TLS version
	--tls13-ciphers # TLS 1.3 cipher suites to use
	--tlsauthtype # TLS authentication type
	--tlspassword # TLS password
	--tlsuser # TLS username
	--tlsv1|-1 @bool # TLSv1.0 or greater
	--tlsv1.0 @bool # TLSv1.0 or greater
	--tlsv1.1 @bool # TLSv1.1 or greater
	--tlsv1.2 @bool # TLSv1.2 or greater
	--tlsv1.3 @bool # TLSv1.3 or greater
	--tr-encoding @bool # Request compressed transfer encoding
	--trace # Write a debug trace to FILE
	--trace-ascii # Like --trace, but without hex output
	--trace-config # Details to log in trace/verbose output
	--trace-ids @bool # Transfer + connection ids in verbose output
	--trace-time @bool # Add time stamps to trace/verbose output
	--unix-socket # Connect through this Unix domain socket
	--upload-file|-T # Transfer local FILE to destination
	--upload-flags # IMAP upload behavior
	--url # URL(s) to work with
	--url-query # Add a URL query part
	--use-ascii|-B @bool # Use ASCII/text transfer
	--user|-u # Server user and password
	--user-agent|-A # Send User-Agent <name> to server
	--variable # Set variable
	--verbose|-v @bool # Make the operation more talkative
	--vlan-priority # Set VLAN priority
	--write-out|-w # Output FORMAT after completion
	--xattr @bool # Store metadata in extended file attributes
