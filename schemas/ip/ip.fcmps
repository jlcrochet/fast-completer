		show # Show TUN/TAP devices
		list # List TUN/TAP devices
	l2tp # L2TPv3 tunnel management
		add # Add L2TP tunnel or session
		del # Delete L2TP tunnel or session
		show # Show L2TP tunnel or session info
	xfrm # IPsec framework management
		state # Manage xfrm states
		policy # Manage xfrm policies
		monitor # Monitor xfrm events
	vrf # Virtual routing and forwarding management
