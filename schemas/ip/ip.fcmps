ip # Show and manipulate routing, network devices, interfaces
	-V @bool # Print version
	-s @bool # Output more statistics
	-d @bool # Output more details
	-r @bool # Resolve names
	-h @bool # Human-readable output
	-iec @bool # Print human-readable rates in IEC units
	-j @bool # Output results in JSON
	-p @bool # Pretty print JSON output
	-4 @bool # Shortcut for -family inet
	-6 @bool # Shortcut for -family inet6
	-M @bool # Shortcut for -family mpls
	-B @bool # Shortcut for -family bridge
	-0 @bool # Shortcut for -family link
	-f (inet|inet6|mpls|bridge|link) # Protocol family to use
	-l # Maximum number of address flush attempts
	-o @bool # Output each record on one line
	-t @bool # Display timestamp
	-ts @bool # Display short timestamp
	-b # Read commands from file or stdin
	-rc # Set netlink socket receive buffer size
	-n # Switch to specified network namespace
	-N @bool # Print protocol numbers instead of names
	-a @bool # Execute over all objects
	-c @bool # Use color output
	-br @bool # Print brief output
	-echo @bool # Request kernel to send echo of requests
	-force @bool # Don't terminate on errors in batch mode
	link # Network device configuration
		show # Display device attributes
		set # Change device attributes
		add # Add virtual link
		delete # Delete virtual link
		change # Change device attributes
		xstats # Display extended statistics
		afstats # Display address family statistics
		property # Manage device properties
	address # Protocol address management
		show # Display protocol addresses
		add # Add new protocol address
		change # Change existing protocol address
		replace # Add or update protocol address
		del # Delete protocol address
		flush # Flush protocol addresses
		save # Save protocol addresses
		restore # Restore protocol addresses
		showdump # Show saved address dump
	route # Routing table management
		list # List routes
		flush # Flush routes
		save # Save routing table
		restore # Restore routing table
		showdump # Show saved route dump
		get # Get a single route
		add # Add new route
		del # Delete route
		change # Change existing route
		append # Append route
		replace # Add or update route
	neighbour # Neighbour and ARP table management
		show # Display neighbour entries
		flush # Flush neighbour entries
		add # Add neighbour entry
		del # Delete neighbour entry
		change # Change neighbour entry
		replace # Add or update neighbour entry
		get # Get a single neighbour entry
	rule # Routing policy rule management
		list # List rules
		add # Add new rule
		del # Delete rule
		flush # Flush rules
		save # Save rules
		restore # Restore rules
	netns # Network namespace management
		list # List network namespaces
		add # Add network namespace
		attach # Attach process to network namespace
		set # Assign an id to a network namespace
		delete # Delete network namespace
		identify # Report network namespace for a process
		pids # Report processes in a network namespace
		exec # Execute command in network namespace
		monitor # Monitor network namespace events
		list-id # List network namespace IDs
	tunnel # Tunnel configuration
		add # Add new tunnel
		change # Change existing tunnel
		del # Delete tunnel
		show # Show tunnel info
		prl # Manage potential router list
		6rd # Manage 6rd prefix
