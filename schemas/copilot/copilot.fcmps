		--app # Name of the application.
		--env # Name of the environment.
		--env-var-override # Optional. Override environment variables passed to containers.
		--name # Name of the service or job.
		--port-override # Optional. Override ports exposed by service. Format: <host port>:<service port>.
		--proxy @bool # Optional. Proxy outbound requests to your environment's VPC.
		--proxy-network # proxy-network
		--use-task-role @bool # Optional. Run containers with TaskRole credentials instead of session credentials.
		--watch @bool # Optional. Watch changes to local files and restart containers when updated. Directories and files in the main .dockerignore file are ignored.
