	task # Commands for tasks.
		delete # Deletes a one-off task from an application or default cluster.
			--app # Name of the application.
			--default @bool # Optional. Delete a task which was launched in the default cluster and subnets.
			--env # Name of the environment.
			--name # Name of the service.
			--yes @bool # Skips confirmation prompt.
		exec # Execute a command in a running container part of a task.
			--app # Name of the application.
			--command # Optional. The command that is passed to a running container.
			--default @bool # Optional. Execute commands in running tasks in default cluster and default subnets.
			--env # Name of the environment.
			--name # Name of the service, job, or task group.
			--task-id # Optional. ID of the task you want to exec in.
			--yes @bool # Optional. Whether to update the Session Manager Plugin.
		run # Run a one-off task on Amazon ECS.
			--acknowledge-secrets-access @bool # Optional. Skip the confirmation question and grant access to the secrets specified by --secrets flag.
			--app # Optional. Name of the application.
			--build-args # Key-value pairs converted to --build-args.
			--build-context # Path to the Docker build context.
			--cluster # Optional. The short name or full ARN of the cluster to run the task in.
			--command # Optional. The command that is passed to "docker run" to override the default command.
			--count # Optional. The number of tasks to set up.
			--cpu # Optional. The number of CPU units to reserve for each task.
			--default @bool # Optional. Run tasks in default cluster and default subnets.
			--dockerfile # Path to the Dockerfile.
			--entrypoint # Optional. The entrypoint that is passed to "docker run" to override the default entrypoint.
			--env # Optional. Name of the environment.
			--env-file # Optional. A path to an environment variable (.env) file.
			--env-vars # Optional. Environment variables specified by key=value separated by commas.
			--execution-role # Optional. The ARN of the role that grants the container agent permission to make AWS API calls.
			--follow @bool # Optional. Specifies if the logs should be streamed.
			--generate-cmd # Optional. Generate a command with a pre-filled value for each flag.
			--image # The location of an existing Docker image.
			--memory # Optional. The amount of memory to reserve in MiB for each task.
			--platform-arch # Optional. Architecture of the task. Must be specified along with 'platform-os'.
			--platform-os # Optional. Operating system of the task. Must be specified along with 'platform-arch'.
			--resource-tags # Optional. Labels with a key and value separated by commas.
			--secrets # Optional. Secrets to inject into the container. Specified by key=value separated by commas.
			--security-groups # Optional. Additional security group IDs for the task to use. Can be specified multiple times.
			--subnets # Optional. The subnet IDs for the task to use. Can be specified multiple times.
			--tag # Optional. The container image tag in addition to "latest".
			--task-group-name # Optional. The group name of the task.
			--task-role # Optional. The ARN of the role for the task to use.
	version # Print the version number.
