copilot # AWS Copilot CLI
	--help @bool # help for copilot
	--version @bool # version for copilot
	app # Commands for applications.
		delete # Delete all resources associated with the application.
			--name # Name of the application.
			--yes @bool # Skips confirmation prompt.
		init # Creates a new empty application.
			--domain # Optional. Your existing custom domain name.
			--permissions-boundary # Optional. The name or ARN of an existing IAM policy with which to set a
			--resource-tags # Optional. Labels with a key and value separated by commas.
		ls # Lists all the applications in your account.
		show # Shows info about an application.
			--json @bool # Optional. Output in JSON format.
			--name # Name of the application.
		upgrade # Upgrades the template of an application to the latest version.
			--name # Name of the application.
	completion # Output shell completion code.
	deploy # Deploy one or more Copilot jobs or services.
		--all @bool # Optional. Deploy all workloads with manifests in the current Copilot workspace.
		--allow-downgrade @bool # Optional. Allow using an older version of Copilot to update Copilot components
		--app # Name of the application.
		--aws-access-key-id # Optional. An AWS access key for the environment account.
		--aws-secret-access-key # Optional. An AWS secret access key for the environment account.
		--aws-session-token # Optional. An AWS session token for temporary credentials.
		--deploy-env @bool # Deploy the target environment before deploying the workload.
		--detach @bool # Optional. Skip displaying CloudFormation deployment progress.
		--env # Name of the environment.
		--force @bool # Optional. Force a new service deployment using the existing image.
		--init-env @bool # Confirm initializing the target environment if it does not exist.
		--init-wkld @bool # Optional. When specified with --all, initialize all local workloads before deployment.
		--name # Names of the service or jobs to deploy, with an optional priority tag (e.g. fe/1, be/2, my-job/1).
		--no-rollback @bool # Optional. Disable automatic stack
		--profile # Name of the profile for the environment account.
		--region # Optional. An AWS region where the environment will be created.
		--resource-tags # Optional. Labels with a key and value separated by commas.
		--tag # Optional. The tag for the container images Copilot builds from Dockerfiles.
	docs # Open the copilot docs.
	env # Commands for environments.
		delete # Deletes an environment from your application.
			--app # Name of the application.
			--name # Name of the environment.
			--yes @bool # Skips confirmation prompt.
		deploy # Deploys an environment to an application.
			--allow-downgrade @bool # Optional. Allow using an older version of Copilot to update Copilot components
			--app # Name of the application.
			--detach @bool # Optional. Skip displaying CloudFormation deployment progress.
			--diff @bool # Compares the generated CloudFormation template to the deployed stack.
			--diff-yes @bool # Skip interactive approval of diff before deploying.
			--force @bool # Optional. Force update the environment stack template.
			--name # Name of the environment.
			--no-rollback @bool # Optional. Disable automatic stack
		init # Creates a new environment in your application.
			--allow-downgrade @bool # Optional. Allow using an older version of Copilot to update Copilot components
			--app # Name of the application.
			--aws-access-key-id # Optional. An AWS access key for the environment account.
			--aws-secret-access-key # Optional. An AWS secret access key for the environment account.
			--aws-session-token # Optional. An AWS session token for temporary credentials.
			--container-insights @bool # Optional. Enable CloudWatch Container Insights.
			--default-config @bool # Optional. Skip prompting and use default environment configuration.
			--import-cert-arns # Optional. Apply existing ACM certificates to the internet-facing load balancer.
			--import-private-subnets # Optional. Use existing private subnet IDs.
			--import-public-subnets # Optional. Use existing public subnet IDs.
			--import-vpc-id # Optional. Use an existing VPC ID.
			--internal-alb-allow-vpc-ingress @bool # Optional. Allow internal ALB ingress from port 80 and/or port 443.
			--internal-alb-subnets # Optional. Specify subnet IDs for an internal load balancer.
			--name # Name of the environment.
			--override-az-names # Optional. Availability Zone names.
			--override-private-cidrs # Optional. CIDR to use for private subnets.
			--override-public-cidrs # Optional. CIDR to use for public subnets.
			--override-vpc-cidr # Optional. Global CIDR to use for VPC.
			--prod @bool # If the environment contains production services.
			--profile # Name of the profile for the environment account.
			--region # Optional. An AWS region where the environment will be created.
		ls # Lists all the environments in an application.
			--app # Name of the application.
			--json @bool # Optional. Output in JSON format.
		override # Override the AWS CloudFormation template of environments.
			--app # Name of the application.
			--cdk-language # Optional. The Cloud Development Kit language.
			--name # Optional. Name of the environment to use when retrieving resources in a template.
			--skip-resources @bool # Optional. Skip asking for which resources to override and generate empty IaC extension files.
			--tool # Infrastructure as Code tool to override a template.
		package # Print the AWS CloudFormation template of an environment.
			--allow-downgrade @bool # Optional. Allow using an older version of Copilot to update Copilot components
			--app # Name of the application.
			--diff @bool # Compares the generated CloudFormation template to the deployed stack.
			--force @bool # Optional. Force update the environment stack template.
			--name # Name of the environment.
			--output-dir # Optional. Writes the stack template and template configuration to a directory.
			--upload-assets @bool # Optional. Whether to upload assets (container images, Lambda functions, etc.).
		show # Shows info about a deployed environment.
			--app # Name of the application.
			--json @bool # Optional. Output in JSON format.
			--manifest @bool # Optional. Output the manifest file used for the deployment.
			--name # Name of the environment.
			--resources @bool # Optional. Show the resources in your environment.
